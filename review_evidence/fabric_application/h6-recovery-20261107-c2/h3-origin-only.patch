+    def _application_account_origin(self, turn, lease, document, now):
+        """Refuse new strict dispatch after rebind without changing original recovery."""
+        raw = lease["account_admission_json"]
+        if raw is None:
+            return None
+        try:
+            import quota_circuit
+            import quota_remote
+            if hashlib.sha256(raw.encode()).hexdigest() != lease["account_admission_digest"]:
+                raise ValueError("retained account evidence changed")
+            prior = json.loads(raw)
+            provider = self.provider_name(turn["pool"])
+            if (prior.get("schema") != "mastermind.account_admission.v1"
+                    or any(prior.get(key) != turn[key] for key in ("account", "model"))
+                    or prior.get("pool") != provider):
+                raise ValueError("retained account identity changed")
+            # Pin the admitted owner document, including shared-scope membership
+            # and policy. A new observation cannot silently revise that contract.
+            if hashlib.sha256(_application_json(document).encode()).hexdigest() != prior["config_digest"]:
+                raise ValueError("account configuration changed")
+            spec = document["providers"][provider]
+            members = [a for a in spec["accounts"] if a["name"] == turn["account"]]
+            if len(members) != 1 or spec.get("enabled", True) is not True:
+                raise ValueError("account unavailable")
+            account = members[0]
+            if (account.get("enabled", True) is not True
+                    or account["capacity_generation"] != prior["capacity_generation"]):
+                raise ValueError("capacity generation changed")
+            token = _APPLICATION_ACCOUNTS.set(document)
+            try:
+                scope = quota_circuit.scope_for(self, provider, turn["account"])
+            finally:
+                _APPLICATION_ACCOUNTS.reset(token)
+            if scope != prior["quota_scope"]:
+                raise ValueError("account scope changed")
+            retained = prior["windows"]
+            required = [row["kind"] for row in retained]
+            if not required or len(required) != len(set(required)):
+                raise ValueError("retained windows invalid")
+            cache, _ = quota_remote.read_account_admission_cache()
+            current = quota_remote.account_admission_observation(
+                cache, provider=provider, account=turn["account"],
+                generation=account["capacity_generation"], quota_scope=scope,
+                required_windows=required, now_ts=now)
+            previous = prior["observation"]
+            if (previous["schema"] != "mastermind.account_capacity_observation.v2"
+                    or current["origin"]["binding"] != previous["origin"]["binding"]
+                    or current["observed_at"] < previous["observed_at"]
+                    or (current["origin"]["observation_id"] == previous["origin"]["observation_id"]
+                        and current != previous)
+                    or (current["observed_at"] == previous["observed_at"]
+                        and current["windows"] != previous["windows"])
+                    or set(previous["windows"]) != set(required)
+                    or any(any(current["windows"][kind][key] != previous["windows"][kind][key]
+                               for key in ("epoch", "unit", "limit", "starts_at_epoch", "reset_at_epoch"))
+                           for kind in required)):
+                raise ValueError("admitted account origin changed")
+            # A newer coherent observation of the same binding does not erase
+            # this lease's reservation or give it a new upstream window.
+            return prior
+        except (OSError, KeyError, TypeError, ValueError, OverflowError):
+            raise ApplicationAdmissionError("account_origin_unqualified") from None
+
