+def account_admission_observation(cache, *, provider, account, generation,
+                                  quota_scope, required_windows, now_ts):
+    """Validate the qualified H2 envelope; legacy percentages cannot invent it.
+
+    H2's existing producer owns capacity_generation and exact coverage of settled
+    leases. Each window has its own native unit, epoch and remaining balance.
+    Null reset clocks may support headroom; they never establish expiry urgency.
+    """
+    import math
+    import re
+
+    def ident(value):
+        if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}", value):
+            raise ValueError("capacity_identity_invalid")
+        return value
+
+    def number(value, *, positive=False, integral=False):
+        if type(value) not in (int, float) or not math.isfinite(value) or value < 0 or (positive and value == 0):
+            raise ValueError("capacity_number_invalid")
+        if integral and (type(value) is not int or value > 2**63-1):
+            raise ValueError("capacity_meter_must_use_exact_integer_units")
+        return value
+
+    def stamp(value):
+        if not isinstance(value, str):
+            raise ValueError("capacity_time_invalid")
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+        if parsed.tzinfo is None:
+            raise ValueError("capacity_time_invalid")
+        return parsed.timestamp()
+
+    number(now_ts, positive=True)
+    ident(generation)
+    # MiniMax is canonically a provider row; never admit an accounts copy.
+    entry = cache[provider] if provider == "minimax" else cache[provider]["accounts"][account]
+    if (type(entry) is not dict or entry.get("terminal_refusal")
+            or entry.get("refresh_error") or _has_pending(entry)):
+        raise ValueError("capacity_refresh_unreconciled")
+    envelope = entry["admission"]
+    fields = {"schema", "provider", "account", "capacity_generation", "quota_scope",
+              "source", "observed_at", "windows", "origin"}
+    if (type(envelope) is not dict or set(envelope) != fields
+            or envelope["schema"] != "mastermind.account_capacity_observation.v2"
+            or envelope["provider"] != provider or envelope["account"] != account
+            or envelope["capacity_generation"] != generation
+            or envelope["quota_scope"] != quota_scope
+            or envelope["source"] != "PROVIDER_AUTHORITATIVE"):
+        raise ValueError("capacity_binding_unqualified")
+    # Current origin comes from the incumbent configuration owner, not the
+    # row being admitted. Unsupported owners (including the unjoined Go owner)
+    # remain unqualified; a cache field cannot create that capability.
+    binding = _config_binding(provider)
+    origin = envelope["origin"]
+    if (type(binding) is not dict or set(binding) != {"config_generation", "endpoint"}
+            or not isinstance(binding["config_generation"], str)
+            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}", binding["config_generation"])
+            or not isinstance(binding["endpoint"], str)
+            or _public_endpoint(binding["endpoint"]) != binding["endpoint"]
+            or type(origin) is not dict or set(origin) != {"binding", "observation_id"}
+            or origin["binding"] != binding or entry.get("binding") != binding
+            or not isinstance(origin["observation_id"], str)
+            or not re.fullmatch(r"[0-9a-f]{32}", origin["observation_id"])
+            or origin["observation_id"] != entry.get("observation_id")):
+        raise ValueError("capacity_origin_unqualified")
+    observed = stamp(envelope["observed_at"])
+    # v2 observed_at is the incumbent original refresh-start clock, expressed
+    # as an aware ISO timestamp and compared as normalized epoch seconds. A
+    # distinct provider snapshot time must not be substituted into this field.
+    if number(entry.get("refreshed_at"), positive=True) != observed:
+        raise ValueError("capacity_origin_clock_changed")
+    if not 0 <= now_ts - observed < FRESH_S:
+        raise ValueError("capacity_observation_stale")
+    rows = envelope["windows"]
+    if type(rows) is not list or not 1 <= len(rows) <= 8:
+        raise ValueError("capacity_windows_invalid")
+    windows = {}
+    for row in rows:
+        expected = {"kind", "epoch", "unit", "limit", "remaining", "starts_at", "reset_at", "accounted_lease_ids"}
+        if type(row) is not dict or set(row) != expected:
+            raise ValueError("capacity_window_invalid")
+        kind = ident(row["kind"])
+        if kind in windows:
+            raise ValueError("capacity_window_duplicate")
+        ident(row["epoch"])
+        ident(row["unit"])
+        limit = number(row["limit"], positive=True, integral=True)
+        remaining = number(row["remaining"], integral=True)
+        start = stamp(row["starts_at"])
+        reset = None if row["reset_at"] is None else stamp(row["reset_at"])
+        if remaining > limit or start > observed or (reset is not None and reset <= now_ts):
+            raise ValueError("capacity_window_invalid")
+        covered = row["accounted_lease_ids"]
+        if (type(covered) is not list or len(covered) > 256
+                or any(not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{12}", value) for value in covered)
+                or len(set(covered)) != len(covered)):
+            raise ValueError("capacity_coverage_invalid")
+        windows[kind] = dict(row, starts_at_epoch=start, reset_at_epoch=reset)
+    if set(windows) != set(required_windows):
+        raise ValueError("capacity_windows_incomplete")
+    return {"schema": envelope["schema"], "provider": provider, "account": account,
+            "capacity_generation": generation, "quota_scope": quota_scope,
+            "source": envelope["source"], "observed_at": observed, "windows": windows,
+            "origin": {"binding": dict(binding), "observation_id": origin["observation_id"]}}
+
