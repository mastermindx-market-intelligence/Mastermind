+def read_account_admission_cache():
+    """One bounded, read-only H2 observation from the incumbent cache owner.
+
+    This function never refreshes, resolves credentials or accepts a caller path.
+    The caller holds the existing physical admission scope. Reuse its source
+    owner read-only; never retain an import-time resolved cache target.
+    A digest binds the retained bytes; it is not a grant or provider attestation.
+    """
+    import hashlib
+    import math
+    import stat
+
+    def object_pairs(pairs):
+        out = {}
+        for key, value in pairs:
+            if key in out:
+                raise ValueError("duplicate_capacity_key")
+            out[key] = value
+        return out
+
+    def invalid_constant(value):
+        raise ValueError("invalid_capacity_number")
+
+    import support_bundle
+    cache_path = support_bundle._source_state_owner(Path(HERE)) / "quota_cache.json"
+    fd = os.open(cache_path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
+    with os.fdopen(fd, "rb") as source:
+        before = os.fstat(source.fileno())
+        if not stat.S_ISREG(before.st_mode) or before.st_size > 4 * 1024 * 1024:
+            raise ValueError("capacity_source_unavailable")
+        raw = source.read(4 * 1024 * 1024 + 1)
+        after = os.fstat(source.fileno())
+    if (len(raw) > 4 * 1024 * 1024 or
+            (before.st_ino, before.st_size, before.st_mtime_ns) !=
+            (after.st_ino, after.st_size, after.st_mtime_ns)):
+        raise ValueError("capacity_source_changed")
+    document = json.loads(raw.decode("utf-8"), object_pairs_hook=object_pairs,
+                          parse_constant=invalid_constant)
+    if type(document) is not dict:
+        raise ValueError("capacity_source_invalid")
+    return document, hashlib.sha256(raw).hexdigest()
+
