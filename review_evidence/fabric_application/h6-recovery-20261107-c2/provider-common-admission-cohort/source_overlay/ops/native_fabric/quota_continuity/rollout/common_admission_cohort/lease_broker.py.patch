+    def _expiry_source_policy(self):
+        # Reuse the qualified existing pool-policy reader and its R31 thresholds.
+        # This read does not call any provider or change pool suitability.
+        import pick
+        snapshot = pick.read_application_policy()
+        document = snapshot.document
+        raw = document.get("routing", {}).get("burn_down", {})
+        if (type(raw) is not dict or ("promote" in raw and type(raw["promote"]) is not bool)
+                or any(k in raw and (type(raw[k]) not in (int, float) or not math.isfinite(raw[k]))
+                       for k in ("hours_before_reset", "min_remaining_pct"))):
+            raise ValueError("account_expiry_policy_invalid")
+        config = pick._burn_down_cfg(document)
+        if (type(config["promote"]) is not bool
+                or not math.isfinite(config["hours_before_reset"]) or config["hours_before_reset"] <= 0
+                or not math.isfinite(config["min_remaining_pct"]) or not 0 <= config["min_remaining_pct"] <= 100):
+            raise ValueError("account_expiry_policy_invalid")
+        return config, snapshot.bytes_sha256
