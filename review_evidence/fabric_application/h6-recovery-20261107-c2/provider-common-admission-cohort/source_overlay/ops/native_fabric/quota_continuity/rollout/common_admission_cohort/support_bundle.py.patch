+    here = Path(code_here)
+    if here.parent.parent.name == "native-code-releases":
+        from native_runtime_bindings import require_current_selection
+        require_current_selection(here)
+    # Remote eligibility retains the actual committed support source and lane
+    # owner. Its digest is never interpreted as a native CURRENT generation.
+    return stable
+
+
+@contextmanager
+def admission_scope(stable_ext, *, deadline_ns=None):
+    """Hold the incumbent physical owner without creating installation state.
+
+    Callers which also publish take publication before this scope; Broker and
+    SQLite ownership are inside it. The yielded check must run before the
+    caller commits its effect. This helper owns no claim, selection or grant.
+    It is deliberately not reentrant: an already-held caller passes its scope
+    through existing owner operations instead of opening a second flock.
+    """
+    handles, lock_fd, identity = _policy_open_scope(
+        stable_ext, deadline_ns=deadline_ns)
+    try:
+        def require_current():
+            _policy_handles_current(handles, lock_fd, identity)
+            if deadline_ns is not None and time.monotonic_ns() >= deadline_ns:
+                raise TimeoutError("ADMISSION_DEADLINE_EXPIRED")
+        yield require_current
+    finally:
+        _policy_close_scope(handles, lock_fd)
 
 
