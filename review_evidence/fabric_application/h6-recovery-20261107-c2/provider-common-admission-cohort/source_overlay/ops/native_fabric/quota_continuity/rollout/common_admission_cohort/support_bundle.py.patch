+@contextmanager
+def source_admission_scope(code_here, *, deadline_ns=None):
+    """Hold the existing physical owner for this exact delivered code cohort.
+
+    This does not establish a grant or substitute a remote support digest for a
+    native selection. Flat/legacy sources have no implicit fenced eligibility.
+    """
+    stable = _source_state_owner(code_here)
+    with admission_scope(stable, deadline_ns=deadline_ns) as check:
+        def require_current_owner():
+            if _source_state_owner(code_here) != stable:
+                raise ValueError("ADMISSION_SOURCE_OWNER_CHANGED")
+            check()
+        require_current_owner()
+        yield stable, require_current_owner
+
