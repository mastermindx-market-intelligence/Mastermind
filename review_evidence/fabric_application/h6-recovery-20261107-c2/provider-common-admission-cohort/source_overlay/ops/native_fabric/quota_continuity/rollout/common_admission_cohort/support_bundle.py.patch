+def _source_state_owner(code_here):
+    """Delegate immutable source custody to its incumbent identity owner."""
+    here = Path(code_here)
+    if (not here.is_absolute() or here != Path(__file__).absolute().parent
+            or here.name != "ext"):
+        raise ValueError("ADMISSION_SOURCE_CONTEXT_REFUSED")
+    if here.parent.parent.name == "native-code-releases":
+        from native_runtime_bindings import owner_path
+        return owner_path(here / "active", here).parent
+    if here.parent.parent.name == "support-releases":
+        from paid_model_owner import canonical_state_ext
+        return canonical_state_ext(here, os.environ)
+    raise ValueError("ADMISSION_SOURCE_OWNER_UNQUALIFIED")
