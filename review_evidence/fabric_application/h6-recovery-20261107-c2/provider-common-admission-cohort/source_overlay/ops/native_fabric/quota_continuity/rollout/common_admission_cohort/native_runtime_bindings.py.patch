+def require_current_selection(code_here):
+    """Return the incumbent selection for this executing native generation.
+
+    A NEW claim's caller must hold the existing physical admission fence until
+    its commit. This pure read does not acquire a lock, publish a selection, or
+    grant admission. Original recovery continues to use owner_path(), which is
+    deliberately independent of CURRENT.
+    """
+    here = Path(code_here)
+    if (not here.is_absolute() or here.name != "ext"
+            or here.parent.parent.name != STORE_NAME
+            or not HEX.fullmatch(here.parent.name)):
+        raise ValueError("native claim source context unavailable")
+    # Reuse the original immutable metadata and fixed-alias custody verifier.
+    owner_path(here / "active", here)
+    try:
+        selected = _json(here.parent.parent / "CURRENT.json", expected_mode=0o600,
+                         maximum=4096, single_link=True)
+    except OSError:
+        raise ValueError("native claim selection unavailable") from None
+    if (type(selected) is not dict or set(selected) != {
+            "schema", "generation", "previous", "sequence"}
+            or selected["schema"] != SELECTION_SCHEMA
+            or type(selected["sequence"]) is not int or selected["sequence"] < 1
+            or type(selected["generation"]) is not str
+            or not HEX.fullmatch(selected["generation"])
+            or selected["previous"] is not None and (
+                type(selected["previous"]) is not str
+                or not HEX.fullmatch(selected["previous"]))):
+        raise ValueError("native claim selection malformed")
+    if selected["generation"] != here.parent.name:
+        raise ValueError("native claim source is no longer selected")
+    return dict(selected)
