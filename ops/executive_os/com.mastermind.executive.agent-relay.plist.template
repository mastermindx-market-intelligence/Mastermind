<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mastermind.executive.agent-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BINARY__</string>
    <string>-I</string>
    <string>-S</string>
    <string>-B</string>
    <string>__RELAY_ENTRYPOINT__</string>
    <string>--socket-path</string>
    <string>__RELAY_SOCKET_PATH__</string>
    <string>--token-file</string>
    <string>__RELAY_TOKEN_FILE__</string>
    <string>--workspace-id</string>
    <string>__SLACK_WORKSPACE_ID__</string>
    <string>--channel-id</string>
    <string>__SLACK_CHANNEL_ID__</string>
    <string>--bot-user-id</string>
    <string>__SLACK_BOT_USER_ID__</string>
    <string>--allowed-peer-uid</string>
    <string>__ALLOWED_PEER_UID__</string>
    <string>--allowed-sol-user-id</string>
    <string>__ALLOWED_SOL_USER_ID__</string>
    <string>--allowed-parent-user-id</string>
    <string>__ALLOWED_PARENT_USER_ID__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RELEASE_ROOT__</string>
  <key>UserName</key>
  <string>__RELAY_USER__</string>
  <key>GroupName</key>
  <string>__RELAY_GROUP__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>15</integer>
  <key>AbandonProcessGroup</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>HardResourceLimits</key>
  <dict>
    <key>Core</key>
    <integer>0</integer>
    <key>FileSize</key>
    <integer>16777216</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__RELAY_HOME__</string>
    <key>LANG</key>
    <string>C.UTF-8</string>
    <key>LC_ALL</key>
    <string>C.UTF-8</string>
    <key>NO_COLOR</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>TZ</key>
    <string>UTC</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__RELAY_STDOUT__</string>
  <key>StandardErrorPath</key>
  <string>__RELAY_STDERR__</string>
</dict>
</plist>
