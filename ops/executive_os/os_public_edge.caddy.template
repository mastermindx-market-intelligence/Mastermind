mcp.mastermind-x.com {
  route {
    @get {
      method GET
      path /os/ /os/auth/callback /workspace/programs/current /workspace/work/current /workspace/control-room/state/current /workspace/control-room/discover/current /workspace/mission/current /workspace/mission/v3/current /workspace/mission/v4/current /workspace/result/current /workspace/plan/current /workspace/operator/activity/current /workspace/window/current __ASSET_PATHS__
    }
    handle @get {
      reverse_proxy 127.0.0.1:__RELAY_PORT__ {
        header_up -Forwarded
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Port
        header_up -X-Real-IP
        header_up -CF-Connecting-IP
        header_up -EO-Connecting-IP
        header_up -EO-Client-IP
        header_up Host mcp.mastermind-x.com
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For 127.0.0.1
      }
    }
    @post {
      method POST
      path /os/executive/context /os/executive/submit /os/executive/status /workspace/control-room/open /workspace/control-room/bind /workspace/control-room/unbind /workspace/control-room/refresh-builds
    }
    handle @post {
      request_body {
        max_size 64KB
      }
      reverse_proxy 127.0.0.1:__RELAY_PORT__ {
        header_up -Forwarded
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Port
        header_up -X-Real-IP
        header_up -CF-Connecting-IP
        header_up -EO-Connecting-IP
        header_up -EO-Client-IP
        header_up Host mcp.mastermind-x.com
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For 127.0.0.1
      }
    }
    abort
  }
}
