[Unit]
Description=Mastermind Executive worker broker (__WORKER_ID__)
After=network-online.target
Requires=__WORKER_SOCKET_UNIT__
Wants=network-online.target

[Service]
Type=simple
User=__WORKER_USER__
Group=__WORKER_GROUP__
UMask=0077
Environment=HOME=__PROVIDER_HOME__
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=NO_COLOR=1
Environment=PYTHONUNBUFFERED=1
Environment=TZ=UTC
ExecStart=__PYTHON_BINARY__ -I -S -B __WORKER_ENTRYPOINT__ serve --config __WORKER_CONFIG__
Restart=no
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__WORKSPACE_ROOT__ __RUN_ROOT__ __PROVIDER_HOME__ __UID_SWEEP_PARENT__
StandardOutput=append:__WORKER_STDOUT__
StandardError=append:__WORKER_STDERR__
TimeoutStopSec=15
KillMode=control-group

# Deliberately no [Install] section: source installation does not arm/start workers.
