<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mastermind.executive.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__BACKUP_WRAPPER__</string>
    <string>--python-binary</string>
    <string>__PYTHON_BINARY__</string>
    <string>--release-root</string>
    <string>__RELEASE_ROOT__</string>
    <string>--config</string>
    <string>__CONTROL_CONFIG__</string>
    <string>--key-file</string>
    <string>__DR_KEY_FILE__</string>
    <string>--receipts-dir</string>
    <string>__DR_RECEIPTS_DIR__</string>
    <string>--transport</string>
    <string>__DR_TRANSPORT__</string>
    <string>--repo</string>
    <string>__DR_VAULT_REPO__</string>
    <string>--token-file</string>
    <string>__DR_TOKEN_FILE__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RELEASE_ROOT__</string>
  <key>UserName</key>
  <string>__BACKUP_USER__</string>
  <key>GroupName</key>
  <string>__BACKUP_GROUP__</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <!-- Adversarial review minor: StartCalendarInterval fires in the HOST's
       LOCAL time zone as macOS/launchd itself is configured; the TZ entry
       under EnvironmentVariables below affects only the child PROCESS's own
       environment, never launchd's own scheduling clock. 09:15 local is
       chosen assuming a US Pacific host (America/Los_Angeles, the operator's
       own workspace time zone; see DR_RUNBOOK.md); that is 16:15 to 17:15
       UTC across PDT and PST, outside the reserved 05:00 to 11:00 UTC
       render window in both cases. Re-verify with `systemsetup
       -gettimezone` and, if this host's real time zone differs, re-pick
       Hour/Minute so the UTC-converted fire time still lands outside
       05:00 to 11:00 UTC. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>ExitTimeOut</key>
  <integer>600</integer>
  <key>AbandonProcessGroup</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>HardResourceLimits</key>
  <dict>
    <key>Core</key>
    <integer>0</integer>
    <key>FileSize</key>
    <integer>268435456</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__BACKUP_HOME__</string>
    <key>LANG</key>
    <string>C.UTF-8</string>
    <key>LC_ALL</key>
    <string>C.UTF-8</string>
    <key>NO_COLOR</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>TZ</key>
    <string>UTC</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__BACKUP_STDOUT__</string>
  <key>StandardErrorPath</key>
  <string>__BACKUP_STDERR__</string>
</dict>
</plist>
