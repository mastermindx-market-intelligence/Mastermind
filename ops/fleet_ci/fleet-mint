#!/usr/bin/python3 -I
"""Fleet CI pool: mint one-job JIT runner configs (adapted from the Terminal e2e lane's
mint-jitconfig; docs/FLEET_CI_POOL.md, "Minting").

Runs only as `fleetmint`, the one account that can read the org credential at
/etc/fleet-ci/mint/token (root:fleetmint 0440, directory 0750). Never prints it.
  mint <name> <labels> <group_id>  -> writes ONLY the encoded JIT config to stdout

Exit codes: 0 success; 75 transient API/network failure (the slot backs off and
retries); 3 a state an operator must fix: a same-name registration to reconcile, or a
credential/group the API refuses (401, 403 not rate-limited, 404, 422); 2 bad input.
"""
import http.client
import json
import re
import socket
import sys
import urllib.error
import urllib.request

ORG = "mastermindx-market-intelligence"
TOKEN_PATH = "/etc/fleet-ci/mint/token"
API = "https://api.github.com"
# <short-hostname>-fleet-<class>-<N>: host identity lives in the name, never the labels.
# Slot numbers are 1-32 everywhere in the pool.
NAME_RE = re.compile(r"^([a-z0-9][a-z0-9-]{0,39})-fleet-(std|heavy)-([1-9]|[12][0-9]|3[0-2])$")
PER_PAGE = 100
MAX_PAGES = 20
EX_TEMPFAIL = 75
EX_RECONCILE = 3
EX_USAGE = 2
PERMANENT_HTTP = frozenset({401, 403, 404, 422})


def labels_for(cls):
    return f"self-hosted,Linux,X64,fleet,fleet-{cls}"


def _exit(code, message):
    print("fleet-mint: " + message, file=sys.stderr)
    sys.exit(code)


def _http_exit(status, what):
    _exit(EX_RECONCILE if status in PERMANENT_HTTP else EX_TEMPFAIL, f"{what} HTTP {status}")


def _token():
    with open(TOKEN_PATH, encoding="utf-8") as fh:
        value = fh.read().strip()
    if not value:
        _exit(EX_RECONCILE, "credential file is empty")
    return value


def _call(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(API + path, data=data, method=method, headers={
        "Authorization": "Bearer " + _token(),
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "fleet-ci-mint",
    })
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as err:
        headers = err.headers or {}
        if err.code == 403 and (headers.get("Retry-After") or headers.get("X-RateLimit-Remaining") == "0"):
            return 429, None
        return err.code, None
    except (OSError, http.client.HTTPException) as err:
        _exit(EX_TEMPFAIL, f"network error {type(err).__name__}")


def _list_all(path, key):
    items = []
    for page in range(1, MAX_PAGES + 1):
        sep = "&" if "?" in path else "?"
        status, data = _call("GET", f"{path}{sep}per_page={PER_PAGE}&page={page}")
        if status != 200:
            _http_exit(status, f"list {key}")
        batch = data.get(key) if isinstance(data, dict) else None
        total = data.get("total_count") if isinstance(data, dict) else None
        if not isinstance(batch, list) or not isinstance(total, int) or isinstance(total, bool):
            _exit(EX_RECONCILE, f"list {key}: unexpected response shape")
        items.extend(batch)
        if len(items) >= total or not batch:
            if len(items) != total:
                _exit(EX_TEMPFAIL, f"list {key}: got {len(items)} of {total} (list changed while paging)")
            return items
    _exit(EX_RECONCILE, f"list {key}: more than {MAX_PAGES} pages")


def _label_set(runner):
    labels = runner.get("labels")
    if not isinstance(labels, list) or not all(isinstance(l, dict) and isinstance(l.get("name"), str) for l in labels):
        return None
    return {l["name"].lower() for l in labels}


def _stale_candidate(name, cls, gid):
    """The one same-name registration that is provably a never-used one-job runner of
    this slot (offline, idle, in the group, exact labels), or exit for reconciliation."""
    matches = [r for r in _list_all(f"/orgs/{ORG}/actions/runners?name={name}", "runners")
               if isinstance(r, dict) and r.get("name") == name]
    if not matches:
        return None
    if len(matches) != 1:
        _exit(EX_RECONCILE, f"{len(matches)} runners are named {name}")
    runner = matches[0]
    rid = runner.get("id")
    if not isinstance(rid, int) or isinstance(rid, bool) or rid <= 0:
        _exit(EX_RECONCILE, f"runner {name} has no valid id")
    group_ids = {r.get("id") for r in _list_all(f"/orgs/{ORG}/actions/runner-groups/{gid}/runners", "runners")
                 if isinstance(r, dict)}
    if rid not in group_ids:
        _exit(EX_RECONCILE, f"runner {name} is not in group {gid}")
    if runner.get("busy") is not False:
        _exit(EX_RECONCILE, f"runner {name} is busy or reports no busy state")
    if runner.get("status") != "offline":
        _exit(EX_RECONCILE, f"runner {name} is not offline")
    if _label_set(runner) != {l.lower() for l in labels_for(cls).split(",")}:
        _exit(EX_RECONCILE, f"runner {name} does not carry exactly the pool labels")
    return rid


def mint(name, labels, gid):
    if not isinstance(gid, int) or isinstance(gid, bool) or gid <= 0:
        _exit(EX_USAGE, "runner group id must be a positive integer (0 is refused)")
    m = NAME_RE.match(name)
    if not m:
        _exit(EX_USAGE, "runner name must be <host>-fleet-<std|heavy>-<N> with N in 1-32")
    host, cls = m.group(1), m.group(2)
    if host != socket.gethostname().split(".", 1)[0]:
        _exit(EX_USAGE, "runner name must start with this host's short name")
    if labels != labels_for(cls):
        _exit(EX_USAGE, "labels must be exactly " + labels_for(cls))
    body = {"name": name, "runner_group_id": gid, "labels": labels.split(","), "work_folder": "_work"}
    status, data = _call("POST", f"/orgs/{ORG}/actions/runners/generate-jitconfig", body)
    if status == 409:
        rid = _stale_candidate(name, cls, gid)
        if rid is not None:
            del_status, _ = _call("DELETE", f"/orgs/{ORG}/actions/runners/{rid}")
            if del_status not in (204, 404):
                _http_exit(del_status, "delete stale runner")
        status, data = _call("POST", f"/orgs/{ORG}/actions/runners/generate-jitconfig", body)
    if status != 201 or not isinstance(data, dict) or not data.get("encoded_jit_config"):
        _http_exit(status, "generate-jitconfig")
    sys.stdout.write(data["encoded_jit_config"])


def main(argv):
    if len(argv) == 5 and argv[1] == "mint" and argv[4].isdigit() and int(argv[4]) > 0:
        mint(argv[2], argv[3], int(argv[4]))
    else:
        _exit(EX_USAGE, "usage: fleet-mint mint <name> <labels> <group_id>")


if __name__ == "__main__":
    main(sys.argv)
