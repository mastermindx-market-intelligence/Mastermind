#!/usr/bin/env python3
"""Fleet CI pool capacity, as the hybrid router reads it (docs/FLEET_CI_POOL.md).

  fleet-capacity [--org ORG] [--group-id ID] [--input FILE] [--soft]

Reads the org runners of the fleet runner group (GET /orgs/{org}/actions/runner-groups/
{id}/runners) AND the queued jobs already targeting fleet labels, and prints one JSON
object:

  {"schema": "mastermind.fleet_capacity.v1", "ok": true,
   "idle_slots": I, "busy_slots": B, "online_slots": I+B, "queued_fleet_jobs": Q,
   "per_class": {"std": {"idle": .., "busy": .., "online": .., "queued": ..},
                 "heavy": {...}}}

Only runners carrying the `fleet` label count; the class comes from `fleet-<class>`.
A one-job JIT runner is online and idle exactly while it waits for its job, but queued
workflow jobs already routed to fleet labels will consume those idle registrations
before a new caller can: `idle` is therefore the raw idle count MINUS the queued fleet
jobs of that class (clamped at 0). This prevents capacity over-commit when several
workflows route at once.

Queued jobs are read from ONE page of 100 queued org workflow runs
(GET /orgs/{org}/actions/runs?status=queued&per_page=100&page=1), then one page of jobs
per run; jobs with status queued/waiting whose labels include `fleet` and `fleet-<class>`
count. Two bounds keep the read cheap and fail closed:
  * if that runs page is FULL (100 runs), the queued count is SATURATED — there may be
    more queued fleet jobs than one page can show — so the result is ok=false;
  * at most 20 job-detail API calls are made per decision; if more than 20 queued runs
    would need a detail read, the cap is hit and the result is ok=false.
In both cases the router falls back to hosted. The token needs org "Self-hosted
runners: read" AND "Actions: read" (queued runs/jobs), passed as FLEET_ROUTE_TOKEN;
never the minting credential. If ANY read fails, the whole result is ok=false: the
router then falls back to hosted (fail closed, never over-commit on a partial view).

--input summarizes a saved JSON ({"runners": [...], "queued_jobs": [...]}) instead of
the API. Any failure prints {"ok": false, "error": ...} and exits 0 when --soft is
given, else exits 1. Never prints the token.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request
from typing import Any, Dict, List, Optional

SCHEMA = "mastermind.fleet_capacity.v1"
API = os.environ.get("GITHUB_API_URL", "https://api.github.com")
CLASSES = ("std", "heavy")
PER_PAGE = 100
MAX_PAGES = 20
# At most this many job-detail API calls per decision; more queued runs -> hosted.
MAX_JOB_DETAIL_CALLS = 20
FULL_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def _label_names(runner: Dict[str, Any]) -> List[str]:
    labels = runner.get("labels")
    if not isinstance(labels, list):
        return []
    return [l["name"].lower() for l in labels if isinstance(l, dict) and isinstance(l.get("name"), str)]


def queued_fleet_counts(jobs: List[Any]) -> Dict[str, int]:
    """Queued/waiting jobs already targeting fleet labels, per class. In-progress jobs
    sit on a runner that already reports busy, so counting them again would double-book."""
    counts = {c: 0 for c in CLASSES}
    for j in jobs:
        if not isinstance(j, dict) or j.get("status") not in ("queued", "waiting"):
            continue
        labels = j.get("labels")
        if not isinstance(labels, list):
            continue
        names = {l.lower() for l in labels if isinstance(l, str)}
        if "fleet" not in names:
            continue
        cls = next((c for c in CLASSES if f"fleet-{c}" in names), None)
        if cls is not None:
            counts[cls] += 1
    return counts


def summarize(runners: List[Dict[str, Any]], queued: Optional[Dict[str, int]] = None) -> Dict[str, Any]:
    per_class = {c: {"idle": 0, "busy": 0, "online": 0, "queued": 0} for c in CLASSES}
    for r in runners:
        if not isinstance(r, dict):
            continue
        names = _label_names(r)
        if "fleet" not in names:
            continue
        cls = next((c for c in CLASSES if f"fleet-{c}" in names), None)
        if cls is None or r.get("status") != "online":
            continue
        bucket = per_class[cls]
        bucket["online"] += 1
        if r.get("busy") is True:
            bucket["busy"] += 1
        elif r.get("busy") is False:
            bucket["idle"] += 1
        # busy missing/odd: online but not counted idle (fail toward hosted)
    q = queued if isinstance(queued, dict) else {}
    for c in CLASSES:
        n = q.get(c, 0)
        n = n if isinstance(n, int) and not isinstance(n, bool) and n >= 0 else 0
        per_class[c]["queued"] = n
        per_class[c]["idle"] = max(0, per_class[c]["idle"] - n)
    idle = sum(b["idle"] for b in per_class.values())
    busy = sum(b["busy"] for b in per_class.values())
    online = sum(b["online"] for b in per_class.values())
    return {"schema": SCHEMA, "ok": True, "idle_slots": idle, "busy_slots": busy,
            "online_slots": online, "queued_fleet_jobs": sum(b["queued"] for b in per_class.values()),
            "per_class": per_class}


def _get(path: str, token: str) -> Dict[str, Any]:
    req = urllib.request.Request(API + path, headers={
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "fleet-ci-capacity",
    })
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.loads(resp.read() or b"{}")


def fetch_runners(org: str, group_id: str, token: str) -> List[Dict[str, Any]]:
    items: List[Dict[str, Any]] = []
    for page in range(1, MAX_PAGES + 1):
        data = _get(f"/orgs/{org}/actions/runner-groups/{group_id}/runners"
                    f"?per_page={PER_PAGE}&page={page}", token)
        batch, total = data.get("runners"), data.get("total_count")
        if not isinstance(batch, list) or not isinstance(total, int):
            raise ValueError("unexpected response shape")
        items.extend(batch)
        if len(items) >= total or not batch:
            return items
    raise ValueError("too many pages")


def fetch_queued_fleet_jobs(org: str, token: str) -> List[Dict[str, Any]]:
    """One page of 100 queued org workflow runs, then one page of jobs per run. Bounded
    work: a full runs page means the queued count is saturated, and at most
    MAX_JOB_DETAIL_CALLS (20) job-detail reads are made per decision. Either bound, or
    any read failure, raises so the caller reports ok=false and the router goes hosted."""
    data = _get(f"/orgs/{org}/actions/runs?status=queued&per_page={PER_PAGE}&page=1", token)
    runs = data.get("workflow_runs")
    if not isinstance(runs, list):
        raise ValueError("unexpected queued-runs response shape")
    if len(runs) >= PER_PAGE:
        raise ValueError(f"queued-runs page saturated ({PER_PAGE}); cannot bound queued fleet jobs")
    if len(runs) > MAX_JOB_DETAIL_CALLS:
        raise ValueError(f"queued job-detail cap ({MAX_JOB_DETAIL_CALLS}) reached; routing hosted")
    jobs: List[Dict[str, Any]] = []
    for run in runs:
        if not isinstance(run, dict):
            raise ValueError("unexpected queued-run entry")
        repo = (run.get("repository") or {}).get("full_name")
        rid = run.get("id")
        if not isinstance(repo, str) or not FULL_NAME_RE.match(repo):
            raise ValueError("queued run has no valid repository full_name")
        if not isinstance(rid, int) or isinstance(rid, bool) or rid <= 0:
            raise ValueError("queued run has no valid id")
        jd = _get(f"/repos/{repo}/actions/runs/{rid}/jobs?per_page={PER_PAGE}&page=1&filter=latest", token)
        batch = jd.get("jobs")
        if not isinstance(batch, list):
            raise ValueError("unexpected jobs response shape")
        jobs.extend(batch)
    return jobs


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(prog="fleet-capacity")
    p.add_argument("--org", default=os.environ.get("FLEET_ORG", "mastermindx-market-intelligence"))
    p.add_argument("--group-id", default=os.environ.get("FLEET_RUNNER_GROUP_ID", ""))
    p.add_argument("--input", help="summarize a saved JSON ({runners:[...], queued_jobs:[...]}) instead of the API")
    p.add_argument("--soft", action="store_true", help="on failure print ok=false and exit 0")
    args = p.parse_args(argv)
    try:
        if args.input:
            with open(args.input, encoding="utf-8") as fh:
                data = json.load(fh)
            runners = data.get("runners") if isinstance(data, dict) else None
            if not isinstance(runners, list):
                raise ValueError("input has no runners list")
            queued_jobs = data.get("queued_jobs", []) if isinstance(data, dict) else []
            if not isinstance(queued_jobs, list):
                raise ValueError("input queued_jobs is not a list")
            queued = queued_fleet_counts(queued_jobs)
        else:
            token = os.environ.get("FLEET_ROUTE_TOKEN", "")
            if not token:
                raise ValueError("FLEET_ROUTE_TOKEN not set")
            if not args.group_id.isdigit() or int(args.group_id) <= 0:
                raise ValueError("fleet runner group id not set")
            runners = fetch_runners(args.org, args.group_id, token)
            queued = queued_fleet_counts(fetch_queued_fleet_jobs(args.org, token))
        print(json.dumps(summarize(runners, queued), sort_keys=True))
        return 0
    except urllib.error.HTTPError as err:
        why = f"HTTP {err.code}"
    except (OSError, ValueError) as err:
        why = f"{type(err).__name__}: {err}" if isinstance(err, ValueError) else type(err).__name__
    print(json.dumps({"schema": SCHEMA, "ok": False, "error": why}, sort_keys=True))
    return 0 if args.soft else 1


if __name__ == "__main__":
    sys.exit(main())
