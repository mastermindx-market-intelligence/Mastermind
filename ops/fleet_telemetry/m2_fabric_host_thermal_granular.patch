+        parts=line.split()
+        if not parts:
+            continue
+        name=parts[0]
+        if name!="cpu" and not (name.startswith("cpu") and name[3:].isdigit()):
+            continue
+        try:
+            nums=[int(v) for v in parts[1:9]]
