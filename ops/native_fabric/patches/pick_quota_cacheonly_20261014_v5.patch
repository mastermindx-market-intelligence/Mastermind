+"""Advisory GLM pool-wide exhaustion requires ALL accounts to be known.
+
+Tests are synthetic cache reads; no live provider call, broker grant, task
+dispatch, cache publication, or mutable host source.
+"""
+from dataclasses import asdict
+from datetime import datetime,timedelta,timezone
+from pathlib import Path
+import json
+import pytest
+import quota_remote as qr
+
+NOW=datetime(2026,10,13,19,0,tzinfo=timezone.utc)
+TS=NOW.timestamp()
+REAL_DECISION=qr.glm_quota_decision
+
+def entry(window,rem,shift=0):
+    return asdict(qr.ProviderQuotaState(
+      provider='glm',window=window,
+      used=(None if rem is None else 100.0-rem),cap=100.0,remaining_pct=rem,
+      reset_at=(NOW+timedelta(hours=2)).isoformat().replace('+00:00','Z'),
+      source='PROVIDER_AUTHORITATIVE',
+      observed_at=(NOW+timedelta(seconds=shift)).isoformat().replace('+00:00','Z'),
+      confidence=1.0,detail='synthetic-no-network'))
+
+def rows(kind):
+    full=[entry('5h',2.0),entry('weekly',2.0)]
+    other={
+       'missing':[],
+       'stale':[entry('5h',2.0,-(qr.FRESH_S+301)),entry('weekly',2.0,-(qr.FRESH_S+301))],
+       'future':[entry('5h',2.0,21),entry('weekly',2.0,21)],
+       'missing5h':[entry('weekly',2.0)],
+       'missing_weekly':[entry('5h',2.0)],
+       'unknown5h':[entry('5h',None),entry('weekly',2.0)],
+       'all_exhausted':full,
+       'has_spare':[entry('5h',90.0),entry('weekly',90.0)]
+    }[kind]
+    return full,other
+
+@pytest.mark.parametrize('kind',[
+ 'missing','stale','future','missing5h','missing_weekly','unknown5h'
+])
+def test_partial_glm_observation_is_unknown_not_authoritative(monkeypatch,tmp_path,kind):
+    full,other=rows(kind)
+    p=tmp_path/'quota.json'
+    doc={'glm':{'accounts':{
+      'a':{'refreshed_at':TS-1,'states':full},
+      'b':{'refreshed_at':TS-1,'states':other},
+    }}}
+    p.write_text(json.dumps(doc))
+    original=p.read_bytes()
+    def no_network(*args,**kwargs):raise AssertionError('UNEXPECTED_EXTERNAL_QUOTA_EFFECT')
+    monkeypatch.setattr(qr,'_atomic_write',no_network)
+    monkeypatch.setattr(qr,'_live_glm',no_network)
+    monkeypatch.setattr(qr,'_glm_accounts_dict',lambda:{
+      'a':{'api_key':'synthetic'},'b':{'api_key':'synthetic'}})
+    monkeypatch.setattr(qr,'glm_quota_decision',REAL_DECISION)
+    d=qr.glm_quota_decision(now_ts=TS,cache_path=str(p),allow_remote=False)
+    assert d['source'] == 'UNKNOWN',f"cannot assert account-wide exhaustion from partial observations: {kind}, {d['state']}"
+    assert d['state'] == 'UNKNOWN'
+    assert p.read_bytes()==original
+
+@pytest.mark.parametrize('kind,expected',[
+ ('all_exhausted','PARKED'),('has_spare','OK')
+])
+def test_wholly_observed_glm_pool_keeps_true_decision(monkeypatch,tmp_path,kind,expected):
+    full,other=rows(kind)
+    p=tmp_path/'quota.json'
+    p.write_text(json.dumps({'glm':{'accounts':{
+      'a':{'refreshed_at':TS-1,'states':full},
+      'b':{'refreshed_at':TS-1,'states':other}
+    }}}))
+    monkeypatch.setattr(qr,'_glm_accounts_dict',lambda:{
+      'a':{'api_key':'synthetic'},'b':{'api_key':'synthetic'}})
+    monkeypatch.setattr(qr,'glm_quota_decision',REAL_DECISION)
+    d=qr.glm_quota_decision(now_ts=TS,cache_path=str(p),allow_remote=False)
+    assert d['source']=='PROVIDER_AUTHORITATIVE'
+    assert d['state']==expected
