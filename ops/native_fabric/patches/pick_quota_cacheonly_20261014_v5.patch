+"""Provider-authoritative quota cache freshness under pure advisory selection."""
+from __future__ import annotations
+from dataclasses import asdict
+from datetime import datetime,timedelta,timezone
+import json
+from unittest.mock import patch
+import pytest
+import quota_remote as qr
+
+T=datetime(2026,10,13,18,8,0,tzinfo=timezone.utc)
+TS=T.timestamp()
+
+def quota(provider, observed):
+    return qr.ProviderQuotaState(provider=provider,window='weekly',used=15.0,
+        cap=100.0,remaining_pct=85.0,
+        reset_at=(T+timedelta(days=3)).isoformat().replace('+00:00','Z'),
+        source='PROVIDER_AUTHORITATIVE',
+        observed_at=observed.isoformat().replace('+00:00','Z'),
+        confidence=1.0,detail='synthetic')
+
+def no_network(monkeypatch):
+    def forbidden(*a,**kw):raise AssertionError('NETWORK_OR_CACHE_WRITE_FORBIDDEN')
+    monkeypatch.setattr(qr, '_atomic_write', forbidden)
+    monkeypatch.setattr(qr, '_live_glm', forbidden)
+    monkeypatch.setattr(qr, 'READERS', {'minimax':forbidden,'glm':forbidden})
+
+@pytest.mark.parametrize('age_s,should_pass', [
+    (0,True),(qr.FRESH_S,True),(qr.FRESH_S+1,False),
+    (-1,False),(-300,False),(86400,False),
+])
+def test_minimax_cache_observation_age_is_authoritative_only(monkeypatch,tmp_path,age_s,should_pass):
+    no_network(monkeypatch)
+    path=tmp_path/'q.json'
+    path.write_text(json.dumps({'minimax':{
+        'refreshed_at':TS-1,
+        'states':[asdict(quota('minimax',T-timedelta(seconds=age_s)))]}}))
+    before=path.read_bytes()
+    result=qr.read_provider('minimax',now_ts=TS,cache_path=str(path),allow_remote=False)
+    assert bool(result) is should_pass
+    assert path.read_bytes()==before
+
+@pytest.mark.parametrize('refreshed_delta',[1, 300, 86400])
+def test_future_refreshed_cache_never_confers_authority(monkeypatch,tmp_path,refreshed_delta):
+    no_network(monkeypatch)
+    path=tmp_path/'q.json'
+    path.write_text(json.dumps({'minimax':{
+        'refreshed_at':TS+refreshed_delta,
+        'states':[asdict(quota('minimax',T))]}}))
+    assert qr.read_provider('minimax',now_ts=TS,cache_path=str(path),allow_remote=False)==[]
+
+@pytest.mark.parametrize('age_s,should_pass', [
+    (0,True),(qr.FRESH_S,True),(qr.FRESH_S+1,False),(-120,False),
+])
+def test_glm_advisory_cache_observation_age(monkeypatch,tmp_path,age_s,should_pass):
+    no_network(monkeypatch)
+    monkeypatch.setattr(qr,'_glm_accounts_dict',lambda:{'a':{'api_key':'synthetic'}})
+    path=tmp_path/'q.json'
+    path.write_text(json.dumps({'glm':{'accounts':{'a':{
+        'refreshed_at':TS-1,
+        'states':[asdict(quota('glm',T-timedelta(seconds=age_s)))]
+    }}}}))
+    raw=path.read_bytes()
+    rows=qr.glm_accounts_state(now_ts=TS,cache_path=str(path),allow_remote=False)
+    assert len(rows)==1
+    assert bool(rows[0]['states']) is should_pass
+    assert rows[0]['source']==('PROVIDER_AUTHORITATIVE' if should_pass else 'UNKNOWN')
+    assert path.read_bytes()==raw
+
+def test_aging_one_glm_account_does_not_promote_its_old_reading(monkeypatch,tmp_path):
+    no_network(monkeypatch)
+    monkeypatch.setattr(qr,'_glm_accounts_dict',lambda:{
+        'a':{'api_key':'synthetic'},'b':{'api_key':'synthetic'}})
+    path=tmp_path/'q.json'
+    path.write_text(json.dumps({'glm':{'accounts':{
+       'a':{'refreshed_at':TS-1,'states':[asdict(quota('glm',T-timedelta(seconds=1000)))]},
+       'b':{'refreshed_at':TS-1,'states':[asdict(quota('glm',T))]}
+    }}}))
+    with patch.object(qr,'_utc_now',return_value=T):
+        rows=qr.glm_accounts_state(now_ts=TS,cache_path=str(path),allow_remote=False)
+    assert [(v['name'],v['source']) for v in rows]==[
+        ('a','UNKNOWN'),('b','PROVIDER_AUTHORITATIVE')]
+    assert not rows[0]['states'] and len(rows[1]['states'])==1
