+def _advisory_fresh_states(states: Iterable[ProviderQuotaState],
+                           now_ts: float) -> List[ProviderQuotaState]:
+    """Advisory cache authority requires a real, nonfuture, dated observation.
+
+    A recently refreshed cache does not renew an old provider measurement.
+    Fail closed on unknown/stale/malformed observations, without writing or
+    making provider requests. Normal quota refresh behavior remains intact.
+    """
+    accepted = []
+    for state in states:
+        if state.source != "PROVIDER_AUTHORITATIVE":
+            continue
+        observed = _iso(state.observed_at)
+        if not observed:
+            continue
+        try:
+            stamp = datetime.fromisoformat(observed[:-1] + "+00:00").timestamp()
+            age = now_ts - stamp
+            if 0.0 <= age <= FRESH_S:
+                # A recent observation belongs to its measured window, not to
+                # the new allowance after that window's reset. Unknown remains
+                # unknown; never refresh or synthesize post-reset capacity here.
+                if state.reset_at is not None:
+                    reset = _iso(state.reset_at)
+                    if not reset:
+                        continue
+                    reset_ts = datetime.fromisoformat(reset[:-1] + "+00:00").timestamp()
+                    if reset_ts <= now_ts:
+                        continue
+                accepted.append(state)
+        except (OSError, OverflowError, ValueError, TypeError):
+            continue
+    return accepted
+
