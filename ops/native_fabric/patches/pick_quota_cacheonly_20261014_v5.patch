+
+
+NOW = datetime(2026, 10, 12, 4, 31, tzinfo=timezone.utc)
+NOW_TS = NOW.timestamp()
+
+
+def state(provider, observed_at=NOW, reset_hours=9):
+    return qr.ProviderQuotaState(
+        provider=provider, window="weekly", used=10.0, cap=100.0,
+        remaining_pct=90.0,
+        reset_at=(NOW + timedelta(hours=reset_hours)).isoformat().replace("+00:00", "Z"),
+        source="PROVIDER_AUTHORITATIVE",
+        observed_at=observed_at.isoformat().replace("+00:00", "Z"),
+        confidence=1.0, detail="synthetic fixture no provider call",
+    )
+
+
+def cache(tmp_path, refreshed_at=NOW_TS - 1, old=False):
+    p = tmp_path / "quota.json"
+    st = state("minimax", NOW - timedelta(minutes=40) if old else NOW)
+    gl = state("glm", NOW - timedelta(minutes=40) if old else NOW)
+    p.write_text(json.dumps({
+        "minimax": {"refreshed_at": refreshed_at, "states": [asdict(st)]},
+        "glm": {"accounts": {"synthetic": {
+            "refreshed_at": refreshed_at, "states": [asdict(gl)]
+        }}},
+    }))
+    return p
+
+
+def guard_external(monkeypatch):
+    def block(*a, **k):
+        raise AssertionError("ADVISORY_ROUTE_CALLED_PROVIDER_NETWORK")
+    monkeypatch.setattr(qr, "READERS", {"minimax": block, "glm": block})
+    monkeypatch.setattr(qr, "_live_glm", block)
+    monkeypatch.setattr(qr, "_glm_accounts_dict", lambda: {"synthetic": {"api_key": "not-real"}})
+    monkeypatch.setattr(qr, "_atomic_write", block)
+
+
+def test_cached_minimax_observation_without_network_or_writes(monkeypatch, tmp_path):
+    path = cache(tmp_path)
+    before = path.read_bytes()
+    guard_external(monkeypatch)
+    rows = qr.read_provider("minimax", now_ts=NOW_TS, cache_path=str(path),
+                            allow_remote=False)
+    assert [(v.source, v.remaining_pct) for v in rows] == [("PROVIDER_AUTHORITATIVE", 90.0)]
+    assert path.read_bytes() == before
+
+
+@pytest.mark.parametrize("age", [qr.REFRESH_INTERVAL_S, qr.REFRESH_INTERVAL_S + 2, 1800])
+def test_minimax_stale_unknown_no_refresh(monkeypatch, tmp_path, age):
+    path = cache(tmp_path, refreshed_at=NOW_TS-age)
+    before = path.read_bytes()
+    guard_external(monkeypatch)
+    assert qr.read_provider("minimax", now_ts=NOW_TS, cache_path=str(path),
+                            allow_remote=False) == []
+    assert path.read_bytes() == before
+
+
