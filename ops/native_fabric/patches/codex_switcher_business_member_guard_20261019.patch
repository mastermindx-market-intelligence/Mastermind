+#[cfg(test)]
+mod member_identity_regressions {
+    use super::{replace_account_oauth_credentials, sync_active_account_tokens};
+    use crate::types::{AccountsStore, AuthData, AuthDotJson, StoredAccount, TokenData};
+    use base64::Engine;
+
+    fn token(workspace: &str, member: Option<&str>, marker: &str) -> String {
+        let claims = serde_json::json!({
+            "https://api.openai.com/auth": {
+                "chatgpt_account_id": workspace,
+                "chatgpt_user_id": member,
+                "chatgpt_plan_type": "self_serve_business_prolite",
+            }
+        });
+        let payload = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(claims.to_string());
+        format!("header.{payload}.{marker}")
+    }
+
+    fn business_store(member: Option<&str>) -> AccountsStore {
+        let account = StoredAccount::new_chatgpt(
+            "Synthetic Business Member".into(),
+            None,
+            Some("self_serve_business_prolite".into()),
+            None,
+            token("shared-workspace", member, "old"),
+            "old-access".into(),
+            "old-refresh".into(),
+            Some("shared-workspace".into()),
+        );
+        AccountsStore {
+            active_account_id: Some(account.id.clone()),
+            accounts: vec![account],
+            ..AccountsStore::default()
+        }
+    }
+
+    fn current_auth(member: Option<&str>) -> AuthDotJson {
+        AuthDotJson {
+            openai_api_key: None,
+            tokens: Some(TokenData {
+                id_token: token("shared-workspace", member, "new"),
+                access_token: "new-access".into(),
+                refresh_token: "new-refresh".into(),
+                account_id: Some("shared-workspace".into()),
+            }),
+            last_refresh: None,
+        }
+    }
+
+    fn stored_refresh(store: &AccountsStore) -> &str {
+        match &store.accounts[0].auth_data {
+            AuthData::ChatGPT { refresh_token, .. } => refresh_token,
+            AuthData::ApiKey { .. } => panic!("wrong fixture"),
+        }
+    }
+
+    #[test]
+    fn same_business_workspace_different_member_refuses_token_rebinding() {
+        let mut store = business_store(Some("member-a"));
+        assert!(!sync_active_account_tokens(
+            &mut store,
+            &current_auth(Some("member-b"))
+        ));
+        assert_eq!(stored_refresh(&store), "old-refresh");
+    }
+
+    #[test]
+    fn same_business_workspace_same_member_preserves_single_use_rotation() {
+        let mut store = business_store(Some("member-a"));
+        assert!(sync_active_account_tokens(
+            &mut store,
+            &current_auth(Some("member-a"))
+        ));
+        assert_eq!(stored_refresh(&store), "new-refresh");
+    }
+
+    #[test]
+    fn business_without_member_claim_on_live_side_refuses_ambiguous_sync() {
+        let mut store = business_store(Some("member-a"));
+        assert!(!sync_active_account_tokens(&mut store, &current_auth(None)));
+        assert_eq!(stored_refresh(&store), "old-refresh");
+    }
+
+    #[test]
+    fn business_without_member_claim_on_stored_side_refuses_ambiguous_sync() {
+        let mut store = business_store(None);
+        assert!(!sync_active_account_tokens(
+            &mut store,
+            &current_auth(Some("member-a"))
+        ));
+        assert_eq!(stored_refresh(&store), "old-refresh");
+    }
+
+    #[test]
+    fn business_without_either_member_claim_cannot_infer_identity_from_workspace() {
+        let mut store = business_store(None);
+        assert!(!sync_active_account_tokens(&mut store, &current_auth(None)));
+        assert_eq!(stored_refresh(&store), "old-refresh");
+    }
+
+    #[test]
+    fn direct_refresh_cannot_overwrite_different_business_member_credentials() {
+        let mut store = business_store(Some("member-b1"));
+        let original = stored_refresh(&store).to_string();
+        let outcome = replace_account_oauth_credentials(
+            &mut store.accounts[0],
+            token("shared-workspace", Some("member-b2"), "refreshed"),
+            "other-access".into(),
+            "other-refresh".into(),
+            Some("shared-workspace".into()),
+        );
+        assert!(outcome.is_err());
+        assert_eq!(stored_refresh(&store), original);
+    }
+
+    #[test]
+    fn direct_refresh_preserves_rotated_credentials_for_verified_same_member() {
+        let mut store = business_store(Some("member-b1"));
+        replace_account_oauth_credentials(
+            &mut store.accounts[0],
+            token("shared-workspace", Some("member-b1"), "refreshed"),
+            "new-access".into(),
+            "new-refresh".into(),
+            Some("shared-workspace".into()),
+        )
+        .unwrap();
+        assert_eq!(stored_refresh(&store), "new-refresh");
+    }
+
+    #[test]
+    fn direct_refresh_unknown_member_fails_closed_before_changing_any_tokens() {
+        let mut store = business_store(None);
+        let result = replace_account_oauth_credentials(
+            &mut store.accounts[0],
+            token("shared-workspace", Some("member-b2"), "refreshed"),
+            "other-access".into(),
+            "other-refresh".into(),
+            Some("shared-workspace".into()),
+        );
+        assert!(result.is_err());
+        assert_eq!(stored_refresh(&store), "old-refresh");
+    }
+
+    #[test]
+    fn direct_refresh_rejects_conflicting_workspace_metadata_in_same_token() {
+        let mut store = business_store(Some("member-b1"));
+        let result = replace_account_oauth_credentials(
+            &mut store.accounts[0],
+            token("shared-workspace", Some("member-b1"), "refreshed"),
+            "other-access".into(),
+            "other-refresh".into(),
+            Some("other-workspace".into()),
+        );
+        assert!(result.is_err());
+        assert_eq!(stored_refresh(&store), "old-refresh");
+    }
+
+    #[test]
+    fn legacy_personal_pro_without_member_claims_can_rotate_same_subscription() {
+        // Do not reuse the Business fixture builder for a Personal case:
+        // its embedded plan claim deliberately says self_serve_business_prolite.
+        let personal_token = |suffix: &str| {
+            let payload = serde_json::json!({
+                "https://api.openai.com/auth": {
+                    "chatgpt_account_id": "personal-workspace",
+                    "chatgpt_plan_type": "pro"
+                }
+            });
+            let encoded =
+                base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(payload.to_string());
+            format!("header.{encoded}.{suffix}")
+        };
+        let mut account = StoredAccount::new_chatgpt(
+            "Synthetic Personal".into(),
+            None,
+            Some("pro".into()),
+            None,
+            personal_token("before"),
+            "access-before".into(),
+            "refresh-before".into(),
+            Some("personal-workspace".into()),
+        );
+        replace_account_oauth_credentials(
+            &mut account,
+            personal_token("after"),
+            "access-after".into(),
+            "refresh-after".into(),
+            Some("personal-workspace".into()),
+        )
+        .unwrap();
+        match account.auth_data {
+            AuthData::ChatGPT { refresh_token, .. } => {
+                assert_eq!(refresh_token, "refresh-after");
+            }
+            _ => panic!("expected ChatGPT account"),
+        }
+    }
+
+    #[test]
+    fn personal_pro_cannot_migrate_to_business_member_silently() {
+        let mut account = StoredAccount::new_chatgpt(
+            "Synthetic Personal".into(),
+            None,
+            Some("pro".into()),
+            None,
+            token("shared-workspace", None, "personal"),
+            "access-before".into(),
+            "refresh-before".into(),
+            Some("shared-workspace".into()),
+        );
+        assert!(replace_account_oauth_credentials(
+            &mut account,
+            token("shared-workspace", Some("business-member"), "new"),
+            "access-after".into(),
+            "refresh-after".into(),
+            Some("shared-workspace".into()),
+        )
+        .is_err());
+        match account.auth_data {
+            AuthData::ChatGPT { refresh_token, .. } => {
+                assert_eq!(refresh_token, "refresh-before");
+            }
+            _ => panic!("expected ChatGPT account"),
+        }
+    }
+}
