+/// Refuse cross-user OAuth token changes while retaining legacy Personal
+/// subscription refresh compatibility when neither token exposes a member.
+/// A workspace is not a user identity in shared Business accounts.
+fn matching_oauth_subscription_member(
+    stored_id_token: &str,
+    stored_workspace_hint: Option<&str>,
+    incoming_id_token: &str,
+    incoming_workspace_hint: Option<&str>,
+    stored_plan: Option<&str>,
+) -> Option<String> {
+    let before = parse_chatgpt_id_token_claims(stored_id_token);
+    let after = parse_chatgpt_id_token_claims(incoming_id_token);
+    // Do not let an untrusted stale top-level account ID override a conflicting
+    // claim, or vice versa. Require the same workspace on both sides.
+    if before
+        .account_id
+        .as_deref()
+        .zip(stored_workspace_hint)
+        .is_some_and(|(a, b)| a != b)
+        || after
+            .account_id
+            .as_deref()
+            .zip(incoming_workspace_hint)
+            .is_some_and(|(a, b)| a != b)
+    {
+        return None;
+    }
+    let stored_workspace = before.account_id.as_deref().or(stored_workspace_hint)?;
+    let current_workspace = after.account_id.as_deref().or(incoming_workspace_hint)?;
+    if stored_workspace.is_empty() || stored_workspace != current_workspace {
+        return None;
+    }
+    let is_shared_workspace_plan = [
+        stored_plan,
+        before.plan_type.as_deref(),
+        after.plan_type.as_deref(),
+    ]
+    .into_iter()
+    .flatten()
+    .any(|p| {
+        matches!(
+            p,
+            "self_serve_business_prolite" | "business" | "team" | "enterprise"
+        )
+    });
+    match (before.user_id.as_deref(), after.user_id.as_deref()) {
+        (Some(a), Some(b)) if a == b => {}
+        (None, None) if !is_shared_workspace_plan => {}
+        _ => return None,
+    }
+    Some(current_workspace.to_string())
+}
+
+/// Credential-only update primitive shared with explicit network refresh.
+/// Verifies the stored workspace and member before *any* mutation; a rotated
+/// OAuth response may not silently change the account holding that token.
+fn replace_account_oauth_credentials(
+    account: &mut StoredAccount,
+    id_token: String,
+    access_token: String,
+    refresh_token: String,
+    chatgpt_account_id: Option<String>,
+) -> Result<()> {
+    let AuthData::ChatGPT {
+        id_token: stored_id_token,
+        access_token: stored_access_token,
+        refresh_token: stored_refresh_token,
+        account_id: stored_account_id,
+    } = &mut account.auth_data
+    else {
+        anyhow::bail!("Cannot update OAuth tokens for an API key account");
+    };
+    let Some(workspace) = matching_oauth_subscription_member(
+        stored_id_token,
+        stored_account_id.as_deref(),
+        &id_token,
+        chatgpt_account_id.as_deref(),
+        account.plan_type.as_deref(),
+    ) else {
+        // No body, token, e-mail, or identity is emitted in the refusal.
+        anyhow::bail!("OAuth account identity changed; token update refused");
+    };
+    *stored_id_token = id_token;
+    *stored_access_token = access_token;
+    *stored_refresh_token = refresh_token;
+    *stored_account_id = Some(workspace);
+    Ok(())
+}
