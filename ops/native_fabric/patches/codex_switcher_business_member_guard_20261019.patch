+/// Credential-only update primitive shared with explicit network refresh.
+/// Verifies the stored workspace and member before *any* mutation; a rotated
+/// OAuth response may not silently change the account holding that token.
+fn replace_account_oauth_credentials(
+    account: &mut StoredAccount,
+    id_token: String,
+    access_token: String,
+    refresh_token: String,
+    chatgpt_account_id: Option<String>,
+) -> Result<()> {
+    let AuthData::ChatGPT {
+        id_token: stored_id_token,
+        access_token: stored_access_token,
+        refresh_token: stored_refresh_token,
+        account_id: stored_account_id,
+    } = &mut account.auth_data
+    else {
+        anyhow::bail!("Cannot update OAuth tokens for an API key account");
+    };
+    let Some(workspace) = matching_oauth_subscription_member(
+        stored_id_token,
+        stored_account_id.as_deref(),
+        &id_token,
+        chatgpt_account_id.as_deref(),
+        account.plan_type.as_deref(),
+    ) else {
+        // No body, token, e-mail, or identity is emitted in the refusal.
+        anyhow::bail!("OAuth account identity changed; token update refused");
+    };
+    *stored_id_token = id_token;
+    *stored_access_token = access_token;
+    *stored_refresh_token = refresh_token;
+    *stored_account_id = Some(workspace);
+    Ok(())
+}
