+#[cfg(test)]
+mod business_member_claim_tests {
+    use super::parse_chatgpt_id_token_claims;
+    use base64::Engine;
+
+    fn token(user: serde_json::Value) -> String {
+        let encoded = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(
+            serde_json::json!({
+                "https://api.openai.com/auth": {
+                    "chatgpt_account_id": "shared-business-workspace",
+                    "chatgpt_plan_type": "self_serve_business_prolite",
+                    "chatgpt_user_id": user,
+                }
+            })
+            .to_string(),
+        );
+        format!("header.{encoded}.signature")
+    }
+
+    #[test]
+    fn parses_bounded_business_member_without_changing_workspace_identity() {
+        let claims = parse_chatgpt_id_token_claims(&token(serde_json::json!("member-a")));
+        assert_eq!(
+            claims.account_id.as_deref(),
+            Some("shared-business-workspace")
+        );
+        assert_eq!(claims.user_id.as_deref(), Some("member-a"));
+    }
+
+    #[test]
+    fn rejects_empty_oversized_and_wrong_type_member_identifiers() {
+        for malformed in [
+            serde_json::json!(""),
+            serde_json::json!("x".repeat(257)),
+            serde_json::json!(123),
+            serde_json::Value::Null,
+        ] {
+            assert!(parse_chatgpt_id_token_claims(&token(malformed))
+                .user_id
+                .is_none());
+        }
+        assert_eq!(
+            parse_chatgpt_id_token_claims(&token(serde_json::json!("x".repeat(256))))
+                .user_id
+                .as_deref()
+                .map(str::len),
+            Some(256),
+        );
+    }
+}
