+    fn token(workspace: &str, member: Option<&str>, marker: &str) -> String {
+        let claims = serde_json::json!({
+            "https://api.openai.com/auth": {
+                "chatgpt_account_id": workspace,
+                "chatgpt_user_id": member,
+                "chatgpt_plan_type": "self_serve_business_prolite",
+            }
+        });
+        let payload = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(claims.to_string());
+        format!("header.{payload}.{marker}")
+    }
+
+    fn token_with_plan(workspace: &str, plan: Option<&str>, marker: &str) -> String {
+        let claims = serde_json::json!({
+            "https://api.openai.com/auth": {
+                "chatgpt_account_id": workspace,
+                "chatgpt_user_id": null,
+                "chatgpt_plan_type": plan,
+            }
+        });
+        let payload = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(claims.to_string());
+        format!("header.{payload}.{marker}")
+    }
+
+    fn ambiguous_memberless_plan_must_refuse(plan: Option<&str>) {
+        let before = token_with_plan("shared-workspace", plan, "old");
+        let after = token_with_plan("shared-workspace", plan, "new");
+        let account = StoredAccount::new_chatgpt(
+            "Unknown plan".into(),
+            None,
+            plan.map(String::from),
+            None,
+            before,
+            "old-access".into(),
+            "old-refresh".into(),
+            Some("shared-workspace".into()),
+        );
+        let mut store = AccountsStore {
+            active_account_id: Some(account.id.clone()),
+            accounts: vec![account],
+            ..AccountsStore::default()
+        };
+        let live = AuthDotJson {
+            openai_api_key: None,
+            tokens: Some(TokenData {
+                id_token: after.clone(),
+                access_token: "new-access".into(),
+                refresh_token: "new-refresh".into(),
+                account_id: Some("shared-workspace".into()),
+            }),
+            last_refresh: None,
+        };
+        assert!(!sync_active_account_tokens(&mut store, &live));
+        assert_eq!(stored_refresh(&store), "old-refresh");
+        let result = replace_account_oauth_credentials(
+            &mut store.accounts[0],
+            after,
+            "new-access".into(),
+            "new-refresh".into(),
+            Some("shared-workspace".into()),
+        );
+        assert!(result.is_err());
+        assert_eq!(stored_refresh(&store), "old-refresh");
+    }
+
+    #[test]
+    fn completely_missing_plan_and_member_is_not_assumed_personal() {
+        ambiguous_memberless_plan_must_refuse(None);
+    }
+
+    #[test]
+    fn future_unknown_plan_and_missing_member_is_not_assumed_personal() {
+        ambiguous_memberless_plan_must_refuse(Some("future-unknown-plan"));
+    }
+
+    #[test]
+    fn memberless_token_cannot_change_known_personal_into_unknown_plan() {
+        let account = StoredAccount::new_chatgpt(
+            "Legacy Personal".into(),
+            None,
+            Some("pro".into()),
+            None,
+            token_with_plan("shared-workspace", Some("pro"), "old"),
+            "old-access".into(),
+            "old-refresh".into(),
+            Some("shared-workspace".into()),
+        );
+        let mut store = AccountsStore {
+            active_account_id: Some(account.id.clone()),
+            accounts: vec![account],
+            ..AccountsStore::default()
+        };
+        let next = token_with_plan("shared-workspace", Some("future-unknown"), "new");
+        let live = AuthDotJson {
+            openai_api_key: None,
+            tokens: Some(TokenData {
+                id_token: next.clone(),
+                access_token: "new-access".into(),
+                refresh_token: "new-refresh".into(),
+                account_id: Some("shared-workspace".into()),
+            }),
+            last_refresh: None,
+        };
+        assert!(!sync_active_account_tokens(&mut store, &live));
+        assert_eq!(stored_refresh(&store), "old-refresh");
+        assert!(replace_account_oauth_credentials(
+            &mut store.accounts[0],
+            next,
+            "new-access".into(),
+            "new-refresh".into(),
+            Some("shared-workspace".into()),
+        )
+        .is_err());
+        assert_eq!(stored_refresh(&store), "old-refresh");
+    }
