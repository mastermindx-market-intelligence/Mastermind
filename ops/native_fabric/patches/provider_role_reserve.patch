+def _literal_launches(command: str) -> list[tuple[str, str, list[str]]]:
+    """Extract common literal launch forms without executing shell expansion.
+
+    This best-effort provider-edge check is not a shell sandbox, a funding
+    attestation, or a replacement for typed Runtime/Model Router admission.
+    Unrecognized command forms do not receive an authorization receipt.
+    """
+    if len(command) > 32768:
+        return []
+    try:
+        lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|()\n")
+        lexer.whitespace = " \t\r"
+        tokens = list(lexer)
+    except ValueError:
+        return []
+    if len(tokens) > 2048:
+        return []
+    segments: list[list[str]] = [[]]
+    for token in tokens:
+        if token and all(c in ";&|()\n" for c in token):
+            segments.append([])
+        else:
+            segments[-1].append(token)
+    result: list[tuple[str, str, list[str]]] = []
+    for segment in segments:
+        i = 0
+        while i < len(segment):
+            token = segment[i]
+            base = token.rsplit("/", 1)[-1]
+            if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", token):
+                i += 1
+            elif base in {"command", "exec", "then", "do", "else"}:
+                i += 1
+                while i < len(segment) and segment[i].startswith("-"):
+                    i += 1
+            elif base == "env":
+                i += 1
+                while i < len(segment) and segment[i].startswith("-"):
+                    option = segment[i]
+                    i += 2 if option in {"-u", "--unset"} else 1
+            else:
+                break
+        if i >= len(segment):
+            continue
+        executable = segment[i].rsplit("/", 1)[-1]
+        args = segment[i + 1:]
+        if executable == "pool" and args:
+            action = args[0]
+            if action == "remote" and "--dry-run" in args[5:]:
+                continue
+            if action == "run" and len(args) >= 3:
+                result.append(("fabric", args[1], args[4:5] if len(args) >= 5 else []))
+            elif action == "remote" and len(args) >= 4:
+                result.append(("fabric", args[2], args[5:6] if len(args) >= 6 else []))
+            continue
+        if executable in {"sub.sh", "remote_sub.sh"}:
+            offset = 0 if executable == "sub.sh" else 1
+            if executable == "remote_sub.sh" and "--dry-run" in args[4:]:
+                continue
+            if len(args) >= offset + 2:
+                result.append(("fabric", args[offset], args[offset + 3:offset + 4]))
+            continue
+        if executable not in {"codex", "claude", "cursor-agent", "agent"}:
+            continue
+        # Respect the CLI end-of-options delimiter before examining model flags.
+        if "--" in args:
+            args = args[:args.index("--")]
+        # A help token in the prompt is data, not a command-line help request.
+        prompt_at = next((j for j, x in enumerate(args) if x in {"-p", "--print", "--prompt"}), len(args))
+        if any(x in {"-h", "--help", "--version"} for x in args[:prompt_at]):
+            continue
+        models: list[str] = []
+        for j, arg in enumerate(args):
+            if arg.startswith("--model="):
+                models.append(arg.split("=", 1)[1])
+            elif arg in {"--model", "-m"} and j + 1 < len(args):
+                models.append(args[j + 1])
+            elif executable == "codex" and arg in {"-c", "--config"} and j + 1 < len(args):
+                setting = args[j + 1]
+                if setting.startswith("model="):
+                    models.append(setting.split("=", 1)[1].strip("\"'"))
+        inference = bool(models) or (
+            executable == "codex" and any(x in {"exec", "e", "review"} for x in args)
+        ) or (executable != "codex" and any(x in {"-p", "--print", "--prompt"} for x in args))
+        if inference:
+            result.append(("direct", executable, models))
+    return result
+
