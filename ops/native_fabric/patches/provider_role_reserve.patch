+def guard_selected_model_launches(command: str) -> None:
+    """Deny explicit policy violations; never select, admit or reserve a model."""
+    for route, executable, models in _literal_launches(command):
+        for model in models:
+            match = re.search(r"(?:^|[./:-])(sonnet|terra|luna|haiku)(?:$|[._:/\[\]-])", model, re.I)
+            selected = match.group(1).lower() if match else None
+            if selected in {"sonnet", "terra"}:
+                deny(
+                    "Mastermind model-exclusion policy: Sonnet and Terra are excluded "
+                    "from new automatic launches. Idle capacity, expiry pressure and "
+                    "a cheaper serving surface do not override this exclusion."
+                )
+            if not model or any(x in model for x in ("$", "`", "\n", "\r")):
+                deny(
+                    "Mastermind model-reserve policy: unresolved model selection. "
+                    "The admitted owner must supply a literal qualified model; an "
+                    "environment expression is not proof of family or funding."
+                )
+            if route == "direct" and executable in {"codex", "claude"} and selected in {"luna", "haiku"}:
+                deny(
+                    "Mastermind subscription-reserve policy: an unqualified direct "
+                    "Codex/Claude cheap-model launch may consume reserved principal "
+                    "allowance. Only an already-admitted, separately funded Fabric "
+                    "offer may use an economical fallback. The CLI is not funding proof."
+                )
+        multimodel = executable in {"cursor", "grok", "go-codex", "go-claude", "cursor-agent", "agent"}
+        native = route == "direct" and executable in {"codex", "claude"}
+        if not models and (multimodel or native):
+            deny(
+                "Mastermind model-reserve policy: implicit model selection on a "
+                "multi-model/native launch is unqualified. Preserve existing admission "
+                "and supply the explicit selected model rather than guessing the default."
+            )
+
+
