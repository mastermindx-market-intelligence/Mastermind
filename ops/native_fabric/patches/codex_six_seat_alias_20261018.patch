+def project_native_account_observation(
+    alias: str,
+    sample: Mapping[str, object],
+    *,
+    now: datetime,
+    binding_verified: bool,
+    entitlement_class: Optional[str],
+    qualified_models: Optional[frozenset[str]],
+    active_leases: int,
+    lease_cap: int,
+) -> AccountObservation:
+    """Bridge the incumbent sanitized native account probe to its ranker.
+
+    This does NOT authorize an account, verify a JWT signature, establish an
+    included Business Premium seat, attest the independent model-list read,
+    reserve tokens, mint a broker lease, or start a worker. Those facts come
+    from the existing trusted owner and are checked AGAIN at atomic claim.
+    Reject unknown/multiple quota horizons rather than collapsing constraints.
+    """
+    refusal = ValueError("codex_native_observation_invalid")
+    now = _utc(now)
+    if (type(alias) is not str or alias not in CODEX_ACCOUNT_ALIASES
+            or type(binding_verified) is not bool
+            or type(active_leases) is not int or active_leases < 0
+            or type(lease_cap) is not int or lease_cap < 0
+            or not isinstance(sample, Mapping)
+            or sample.get("state") != "NATIVE_READS_COMPLETED"
+            or sample.get("api_fallback") is not False):
+        raise refusal
+    stop, home, account = (
+        sample.get("stop"), sample.get("home_identity"), sample.get("account")
+    )
+    if (not isinstance(stop, Mapping) or stop.get("private_group_empty") is not True
+            or not isinstance(home, Mapping) or not isinstance(account, Mapping)
+            or account.get("auth_state") != "MANAGED_CHATGPT_OBSERVED"
+            or account.get("capacity_state") != "AVAILABLE_OBSERVED"
+            or account.get("limit_id") != "codex"):
+        raise refusal
+    # Model visibility MUST come from the native App Server catalog observed
+    # with this same account/limit sample. Caller-supplied model choices may
+    # narrow, never widen, that verified catalog.
+    catalog = sample.get("model_visibility")
+    if (not isinstance(catalog, Mapping)
+            or set(catalog) != {"state", "supported_models", "source", "admission_granted"}
+            or catalog.get("state") != "OBSERVED"
+            or catalog.get("source") != "model/list"
+            or catalog.get("admission_granted") is not False):
+        raise refusal
+    listed = catalog.get("supported_models")
+    if (type(listed) is not list or len(listed) > 2
+            or any(type(m) is not str or m not in {"gpt-6-astra", "gpt-6.1-sol"}
+                   for m in listed)
+            or len(set(listed)) != len(listed)):
+        raise refusal
+    native_models = frozenset(listed)
+    if qualified_models is not None and (
+        type(qualified_models) is not frozenset
+        or not qualified_models.issubset(native_models)
+    ):
+        raise refusal
+    verified_models = native_models if qualified_models is None else qualified_models
+    workspace, member = home.get("account_id_sha256"), home.get("user_id_sha256")
+    if type(workspace) is not str or _SHA256.fullmatch(workspace) is None:
+        raise refusal
+    if member is not None and (
+        type(member) is not str or _SHA256.fullmatch(member) is None
+    ):
+        raise refusal
+    if alias in BUSINESS_ALIASES:
+        if account.get("plan_type") != "self_serve_business_prolite" or member is None:
+            raise refusal
+    elif account.get("plan_type") != "pro":
+        raise refusal
+    observed_ts = account.get("observed_at_unix")
+    if (type(observed_ts) not in (int, float)
+            or not isfinite(observed_ts) or observed_ts <= 0):
+        raise refusal
+    try:
+        seen = datetime.fromtimestamp(observed_ts, tz=timezone.utc)
+    except (ValueError, OverflowError, OSError):
+        raise refusal from None
+    if not -timedelta(seconds=30) <= now-seen <= MAX_OBSERVATION_AGE:
+        raise refusal
+    windows = account.get("windows")
+    states = account.get("window_states")
+    if (not isinstance(windows, Mapping) or not isinstance(states, Mapping)
+            or set(states) != {"primary", "secondary"}):
+        raise refusal
+    observed = [key for key in ("primary", "secondary")
+                if states[key] == "OBSERVED"]
+    if (len(observed) != 1 or any(states[key] != "NOT_APPLICABLE"
+                                  for key in ("primary", "secondary")
+                                  if key not in observed)
+            or set(windows) != set(observed)):
+        raise refusal
+    quota = windows[observed[0]]
+    if not isinstance(quota, Mapping):
+        raise refusal
+    remaining, used = quota.get("remaining_percent"), quota.get("used_percent")
+    reset_epoch, minutes = quota.get("resets_at"), quota.get("window_minutes")
+    if (type(remaining) not in (int, float) or type(used) not in (int, float)
+            or not isfinite(remaining) or not isfinite(used)
+            or not 0 <= remaining <= 100 or not 0 <= used <= 100
+            or abs(remaining + used - 100) > 0.001
+            or type(reset_epoch) is not int or type(minutes) is not int
+            or minutes <= 0 or reset_epoch <= observed_ts):
+        raise refusal
+    try:
+        reset_at = datetime.fromtimestamp(reset_epoch, tz=timezone.utc)
+    except (ValueError, OverflowError, OSError):
+        raise refusal from None
+    if reset_at <= now:
+        raise refusal
+    return AccountObservation(
+        alias=alias, remaining_pct=float(remaining),
+        observed_at=seen, reset_at=reset_at, reset_credits=None,
+        active_leases=active_leases, lease_cap=lease_cap,
+        auth_ready=True, binding_verified=binding_verified,
+        account_id_sha256=workspace, user_id_sha256=member,
+        entitlement_class=entitlement_class, qualified_models=verified_models,
+    )
