+def _selection_host(value: str | None) -> str:
+    """Only the incumbent picker's explicit host registry can qualify a pinned host."""
+    if value is None or value == "auto":
+        return "auto"
+    if type(value) is not str or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", value):
+        raise FabricTaskError("INVALID_HOST_SELECTOR")
+    return value
+
+
+def _selection_auto(value: str | None) -> str | None:
+    """Public auto means no model/pool preference; it grants nothing."""
+    return None if value is None or value == "auto" else value
+
