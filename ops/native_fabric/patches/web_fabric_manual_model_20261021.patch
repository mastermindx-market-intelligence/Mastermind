+const manualPinned={...packet,task_class:'review',task_complexity:'C2_COMPLEX_BOUNDED',pool:'grok',model:'grok-4.7'};
+const manualPreview={state:'PREVIEW_ONLY',reserved:false,run_id:id.run_id,pool:'grok',model:'grok-4.7',host:'ubuntu1',mode:'grok'};
+test('manual pool and model remain typed and never expose a shell, host or account',async()=>{
+ const e=engine(),f=facade(e);
+ for(const change of [{pool:'grok;echo'},{pool:'codex-native'},{model:'grok-4.7 $(id)'},{host:'ubuntu1'},{cwd:'~'}])
+  assert.equal(unwrap(await f.call('fabric_request',{...manualPinned,...change})).error,'INVALID_ARGUMENT');
+ const noPool={...manualPinned};delete noPool.pool;
+ assert.equal(unwrap(await f.call('fabric_request',noPool)).error,'INVALID_ARGUMENT');
+ assert.equal(e.calls.length,0);
+});
+test('manual exact model preview fails closed on unsupported/mismatched model',async()=>{
+ for(const value of ['not-json',JSON.stringify({...manualPreview,model:'grok-4.6'}),
+  JSON.stringify({...manualPreview,pool:'glm'}),JSON.stringify({...manualPreview,reserved:true})]){
+  const e=engine([capturedJSON(absent),captured(value)]);
+  const out=unwrap(await facade(e).call('fabric_request',manualPinned));
+  assert.equal(out.error,'MANUAL_ROUTE_UNAVAILABLE');
+  assert.equal(out.retry_allowed,false);
+  assert.equal(e.calls.length,2);
+ }
+});
+test('approved manual pin forwards exact pool/model without quota model-change',async()=>{
+ const e=engine([captured('--quota-fallback'),captured('--follow'),capturedJSON(absent),capturedJSON(manualPreview),pending()]);
+ const out=unwrap(await continuingFacade(e).call('fabric_request',manualPinned));
+ assert.equal(out.delivery,'CONTROLLER_CREATED');
+ assert.equal(e.calls.length,5);
+ assert.match(e.calls[3].arguments.command,/'preview' '--id' 'web-fabric-001'/);
+ assert.match(e.calls[3].arguments.command,/'--pool' 'grok' '--model' 'grok-4.7'/);
+ assert.match(e.calls[4].arguments.command,/'--pool' 'grok' '--model' 'grok-4.7'/);
+ assert.doesNotMatch(e.calls[4].arguments.command,/'--quota-fallback'/);
+});
