# Create an untracked file named .env, chmod 600, and fill credentials there.
# Use a generated random local token (e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(32))').
FABRIC_PROXY_TOKEN=REPLACE_WITH_RANDOM_LOCAL_TOKEN_32_PLUS_CHARS
EXPLABS_KEY_1=REPLACE_WITH_FIRST_EXPERIENTIAL_LABS_KEY
# Remove the leading '#' as additional legitimate key grants become available.
# EXPLABS_KEY_2=
# EXPLABS_KEY_3=
# EXPLABS_KEY_4=
# Optional read-only Brain account observations; OFF by default and needs ONE key.
# EXPLABS_ACCOUNT_METADATA_ENABLED=1 permits only /api/whoami,
# /api/v1/key and /api/v1/credits. Never use with multiple EXPLABS_KEY_N.
EXPLABS_ACCOUNT_METADATA_ENABLED=0
# Exact :free model IDs stop on free exhaustion. No automatic paid spill.
# Paid mode requires the existing owner to verify the account's monthly budget.
EXPLABS_PLAN_POLICY=free_only
SAFE_RPM_PER_KEY=1000
# Optional: set the actual safe organization-wide RPM limit across all these keys.
# SAFE_RPM_SHARED=1000
FABRIC_MAX_PENDING=2000
FABRIC_MAX_PENDING_BYTES=67108864
FABRIC_MAX_INFLIGHT_PER_KEY=128
FABRIC_MAX_QUEUE_WAIT_S=600
FABRIC_GATEWAY_STATE_DIR=.state
