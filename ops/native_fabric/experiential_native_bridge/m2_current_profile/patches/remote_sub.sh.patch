@@ -914,7 +932,30 @@
     ACQUIRE_POOL=bailian
     LEDGER_POOL=bailian
     ;;
+  experiential)
+    ACQUIRE_POOL=experiential
+    LEDGER_POOL=experiential
+    ;;
 esac
+
+# MANUAL-only Experiential Labs route qualification. Runs BEFORE any lease,
+# broker or host effect: an unqualified route (transport uninstalled, route
+# unattested, unknown cap, missing consents) refuses typed and prelaunch.
+if [ "$MODE" = experiential ] && [ "$DRY_RUN" -ne 1 ]; then
+  "$REMOTE_SUB_PYTHON" "$HERE/experiential_bridge.py" launch-preflight \
+    --run-id "$ID" --host "$HOST_ARG" --model "$MODEL" --cwd "$REMOTE_CWD" \
+    --root "${POOL_ORCHESTRATOR_ID:-}" --parent "${POOL_PARENT_RUN_ID:-}" \
+    --task-class "${POOL_TASK_CLASS:-}" \
+    --retention-acknowledged "${EXPERIENTIAL_RETENTION_ACKNOWLEDGED:-0}" \
+    --sensitive-data-opt-in "${EXPERIENTIAL_SENSITIVE_DATA_OPT_IN:-0}" \
+    --proprietary-code "${EXPERIENTIAL_PROPRIETARY_CODE:-0}" \
+    --code-exposure-opt-in "${EXPERIENTIAL_CODE_EXPOSURE_OPT_IN:-0}" \
+    --strict-manual-pin "${EXPERIENTIAL_STRICT_MANUAL_PIN:-0}" || {
+    log "EXPERIENTIAL_PREFLIGHT_REFUSED before_lease=1 before_launch=1"
+    RC=78
+    exit "$RC"
+  }
+fi
 
