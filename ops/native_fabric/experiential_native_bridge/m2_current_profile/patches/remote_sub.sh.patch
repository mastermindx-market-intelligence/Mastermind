+    # the bridge carries the experiential economic witness instead.
+    experiential)
+      if ! "$REMOTE_SUB_PYTHON" "$HERE/experiential_bridge.py" policy-check \
+          --mode experiential --class "${POOL_TASK_CLASS:-}" --model "$MODEL" \
+          --task-complexity "${POOL_TASK_COMPLEXITY:-}" \
+          --escalation-reason "${POOL_ESCALATION_REASON:-}"; then
+        log "ECONOMIC_POLICY_REFUSED experiential_bridge_policy"
