+  fi
+  LAUNCH_REMOTE="$NATIVE_TIMING_PREFIX $RPATH; $HOST_ENV; $NATIVE_TIMING_AFTER_ENV umask 077 || exit; cd $REMOTE_LANES_Q/ext || exit; $REMOTE_OUTPUT_SETUP || exit; LANE_DIRECTORY=$REMOTE_LANES_Q KEY='$ID' MODE='$MODE' PACKET=$REMOTE_LANES_Q/tmp/${ID}.txt REMOTE_CWD='$REMOTE_CWD' MODEL='$MODEL' RC_FILE=$REMOTE_LANES_Q/ext/$REMOTE_RC nohup env REMOTE_SUB_LANES=$REMOTE_LANES_Q REMOTE_SUB_QWEN_PHYSICAL_CONFIG=$QWEN_PHYSICAL_CONFIG $NATIVE_TIMING_ENV $ROUTING_ENV $OPERATOR_ENV $COMMISSION_REMOTE_ENV $EXPERIENTIAL_REMOTE_ENV REMOTE_SUB_LANE_ROOT_LAYOUT='$LANE_ROOT_LAYOUT_TOKEN' REMOTE_SUB_LANE_PACKET_SHA256='$LANE_ROOT_PACKET_SHA' SUPPORT_DIGEST='$SUPPORT_DIGEST' PYTHONDONTWRITEBYTECODE=1 LANE_LEASED=1 POOL_ACCOUNT='$ACCOUNT_ARG' POOL_LEASE_ID='$LEASE_ID' REMOTE_SUB_RUN_ID='$ID' LANE_REMOTE_HOST='$HOST_ARG' NATIVE_LEASE_ISSUED='$NATIVE_LEASE_ISSUED' NATIVE_LEASE_DEADLINE='$NATIVE_LEASE_DEADLINE' LANE_MAX_ACTIVE='$MAX_ACTIVE' LANE_MIN_FREE_MEM_GB='$MIN_FREE_MEM_GB' LANE_MAX_CPU_TCTL_C='$MAX_CPU_TCTL_C' LANE_MIN_FREE_DISK_GB='$MIN_FREE_DISK_GB' FABRIC_NEW_MACRO_COMMIT='$NEW_MACRO_COMMIT' FABRIC_CPU_SCOPE_QUOTA_PCT='$CPU_SCOPE_QUOTA' LANE_MAX_LOAD_RATIO='$LANE_HOST_LOAD_RATIO' LANE_NICE=10 REMOTE_SUB_CHILD_TIMEOUT='$CHILD_TIMEOUT' $REMOTE_LAUNCH_EXEC </dev/null $REMOTE_OUTPUT_REDIRECT &"
