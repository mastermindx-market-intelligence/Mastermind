diff --git a/sub.sh b/sub.sh
--- a/sub.sh
+++ b/sub.sh
@@ -982,5 +982,40 @@
     python3 "$HERE/slot.py" cursor --wait 3600 -- bash -c 'cd "$1" && exec cursor-agent -p --trust --force --sandbox disabled --output-format text "$2" </dev/null' _ "$CWD" "$PROMPT" || _rc=$?
     python3 "$HERE/pool_ledger.py" append --pool cursor --task-class cursor --rc "$_rc" --signal ok 2>/dev/null || true
     exit "$_rc" ;;
-  *) echo "pool must be grok, qwen, minimax, glm, minimax-codex, glm-codex, go-codex, go-claude, oc-free or cursor" >&2; exit 2 ;;
+  experiential)
+    # MANUAL-only Experiential Labs transport. Exact slug (default dark: no
+    # model default), sole route through the host-owned bridge/adapter, no
+    # cross-provider fallback, never the canonical Z.AI GLM keys or endpoint.
+    [ "$MODEL" = "glm-5.3-uncensored" ] || { echo "EXPERIENTIAL_MODEL_SLUG_REFUSED" >&2; exit 78; }
+    [ -n "${POOL_RUN_ID:-}" ] || { echo "EXPERIENTIAL_RUN_ID_REQUIRED sole_route=native_request" >&2; exit 78; }
+    python3 "$HERE/experiential_bridge.py" exec-preflight \
+      --run-id "$POOL_RUN_ID" --cwd "$CWD" \
+      --task-class "${POOL_TASK_CLASS:-}" \
+      --root "${POOL_ORCHESTRATOR_ID:-}" --parent "${POOL_PARENT_RUN_ID:-}" \
+      --retention-acknowledged "${EXPERIENTIAL_RETENTION_ACKNOWLEDGED:-0}" \
+      --sensitive-data-opt-in "${EXPERIENTIAL_SENSITIVE_DATA_OPT_IN:-0}" \
+      --proprietary-code "${EXPERIENTIAL_PROPRIETARY_CODE:-0}" \
+      --code-exposure-opt-in "${EXPERIENTIAL_CODE_EXPOSURE_OPT_IN:-0}" \
+      --strict-manual-pin "${EXPERIENTIAL_STRICT_MANUAL_PIN:-0}" || {
+      echo "EXPERIENTIAL_PREFLIGHT_REFUSED" >&2; exit 78; }
+    TMP="$(mktemp "${TMPDIR:-/tmp}/sub_experiential.XXXXXX")" || exit 78
+    printf '%s' "$PROMPT" > "$TMP" && chmod 600 "$TMP"
+    _rc=0
+    # Existing capacity architecture: slot.py owns admission (experiential cap
+    # is 0 until the original owner attests); the bridge then performs the ONE
+    # admitted opt-in request. No slot bypass, no duplicate worker effect.
+    python3 "$HERE/slot.py" experiential --wait 3600 -- \
+      python3 "$HERE/experiential_bridge.py" exec \
+      --run-id "$POOL_RUN_ID" --cwd "$CWD" \
+      --task-class "${POOL_TASK_CLASS:-}" --prompt-file "$TMP" \
+      --root "${POOL_ORCHESTRATOR_ID:-}" --parent "${POOL_PARENT_RUN_ID:-}" \
+      --retention-acknowledged "${EXPERIENTIAL_RETENTION_ACKNOWLEDGED:-0}" \
+      --sensitive-data-opt-in "${EXPERIENTIAL_SENSITIVE_DATA_OPT_IN:-0}" \
+      --proprietary-code "${EXPERIENTIAL_PROPRIETARY_CODE:-0}" \
+      --code-exposure-opt-in "${EXPERIENTIAL_CODE_EXPOSURE_OPT_IN:-0}" \
+      --strict-manual-pin "${EXPERIENTIAL_STRICT_MANUAL_PIN:-0}" || _rc=$?
+    rm -f "$TMP"
+    python3 "$HERE/pool_ledger.py" append --pool experiential --task-class "${POOL_TASK_CLASS:-experiential}" --model "$MODEL" --rc "$_rc" --signal ok 2>/dev/null || true
+    exit "$_rc" ;;
+  *) echo "pool must be grok, qwen, minimax, glm, minimax-codex, glm-codex, go-codex, go-claude, oc-free, cursor or experiential" >&2; exit 2 ;;
 esac
