# Copy to the host-owned runtime env file (chmod 600). Do not commit secrets.
FABRIC_PROXY_TOKEN=REPLACE_WITH_RANDOM_LOCAL_TOKEN_32_PLUS_CHARS
FABRIC_GATEWAY_STATE_DIR=/Users/chriswong/.local/share/mastermind/anthropic-gateway/state
ANTHROPIC_AUTH_STORE=/Users/chriswong/.hermes/auth.json
# Local admission policy (weighted requests), not a provider entitlement.
ANTHROPIC_FIVE_HOUR_BUDGET=100
ANTHROPIC_WEEKLY_BUDGET=700
ANTHROPIC_WINDOW_5H_S=18000
ANTHROPIC_WINDOW_WEEKLY_S=604800
# First match wins; Fable counts 2x, Opus-5 1.5x against the budgets.
ANTHROPIC_MODEL_WEIGHTS=claude-fable-5*=2.0,claude-opus-5*=1.5,*=1.0
ANTHROPIC_MAX_INFLIGHT_PER_ACCOUNT=1
FABRIC_MAX_PENDING=32
FABRIC_MAX_PENDING_BYTES=16777216
FABRIC_MAX_QUEUE_WAIT_S=600
FABRIC_MAX_BODY_BYTES=8388608
