+def _request_waiter_id(orch: str, pool: str, request_id: Optional[str]) -> Optional[str]:
+    """Correlate queued demand only; not auth, a lease or execution idempotency."""
+    if request_id is None or request_id == "":
+        return None
+    import hashlib
+    import json
+    import re
+    if (type(request_id) is not str
+            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}", request_id)):
+        raise ValueError("invalid_request_id")
+    encoded = json.dumps([orch, pool, request_id], separators=(",", ":")).encode("utf-8")
+    return "rq-" + hashlib.sha256(encoded).hexdigest()
 
 
