+    def _waiter_pinned_model_full(
+        self, conn: sqlite3.Connection, pool: str, waiter: sqlite3.Row
+    ) -> bool:
+        """Only a known model cap can exclude a pinned waiter from ready-slot FIFO.
+
+        A missing/legacy model, ambiguous account or unknown per-model allowance
+        remains competing demand. This changes no pin, grant, queue identity or
+        original-root reclamation. Both model and total capacity are rechecked
+        by the incumbent _pick_account at the actual grant.
+        """
+        try:
+            account = waiter["account"]
+            model = waiter["model"]
+            if (type(account) is not str or not account
+                    or type(model) is not str or not model
+                    or self.provider_name(pool) != "glm"):
+                return False
+            eligible = [a for a in self.grantable_accounts(pool)
+                        if a.get("name") == account]
+            if len(eligible) != 1:
+                return False
+            model_cap = self.account_model_cap(pool, eligible[0], model)
+            if type(model_cap) is not int or model_cap < 0:
+                return False
+            used = self._account_model_held(conn, pool, account, model)
+            return type(used) is int and used >= model_cap
+        except (AttributeError, KeyError, IndexError, TypeError, ValueError,
+                ImportError, OSError, sqlite3.Error):
+            return False
+
