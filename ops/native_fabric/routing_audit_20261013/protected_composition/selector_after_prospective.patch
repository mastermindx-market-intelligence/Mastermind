+def _selection_host(value: str | None) -> str:
+    """An explicit host is only a request to the incumbent qualified picker."""
+    if value is None or value == "auto":
+        return "auto"
+    if type(value) is not str or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", value):
+        raise FabricTaskError("INVALID_HOST_SELECTOR")
+    return value
+
+
+def _selection_auto(value: str | None) -> str | None:
+    """Public auto clears preference; it grants no model, host or account."""
+    return None if value is None or value == "auto" else value
+
+
+def preview_route(
+    run_id: str,
+    task_class: str,
+    *,
+    host: str | None = None,
+    pool: str | None = None,
+    prefer: str | None = None,
+    subject_pool: str | None = None,
+    task_complexity: str = "",
+    escalation_reason: str = "",
+    requested_model: str | None = None,
+) -> dict[str, object]:
+    """Advisory only: fresh request rechecks model/host and never inherits a reservation."""
+    rid = validate_run_id(run_id)
+    route = _parse_route(pick.format_pick(
+        task_class,
+        host=_selection_host(host),
+        pool=_selection_auto(pool),
+        prefer=_selection_auto(prefer),
+        **({"subject_pool": subject_pool} if subject_pool is not None else {}),
+        task_complexity=task_complexity,
+        escalation_reason=escalation_reason,
+        requested_model=_selection_auto(requested_model),
+        route_key=rid,
+    ))
+    guard = pick.launch_policy(
+        route["MODE"], task_class, route["MODEL"],
+        escalation_reason=escalation_reason, task_complexity=task_complexity,
+    )
+    if not guard.get("allowed"):
+        raise FabricTaskError("ECONOMIC_POLICY_REFUSED: " + str(guard.get("reason")))
+    return {
+        "state": "PREVIEW_ONLY",
+        "reserved": False,
+        "run_id": rid,
+        "pool": route["POOL"],
+        "model": route["MODEL"],
+        "host": route["HOST"],
+        "mode": route["MODE"],
+        "reason": route.get("REASON") or "",
+        "selection_rechecked_at_request": True,
+    }
+
+
