+    def _waiter_pinned_quota_parked(self, pool: str, waiter: sqlite3.Row) -> bool:
+        """A retained pin may yield only on the incumbent quota owner's proof.
+
+        No rerouting, refresh, new grant or waiter deletion occurs. Missing,
+        ambiguous, stale or unqualified quota data keeps the waiter competing.
+        """
+        try:
+            account = waiter["account"]
+            if (type(account) is not str or not account or not self.external_gates
+                    or self.provider_name(pool) != "glm"):
+                return False
+            spec = self.provider(pool)
+            if spec.get("enabled") is False:
+                return False
+            matches = [row for row in (spec.get("accounts") or [])
+                       if isinstance(row, dict) and row.get("name") == account]
+            if len(matches) != 1:
+                return False
+            from quota_remote import cached_glm_account_parked
+            return cached_glm_account_parked(account, now_ts=self.now()) is True
+        except (AttributeError, KeyError, IndexError, TypeError, ValueError,
+                ImportError, OSError, sqlite3.Error):
+            return False
+
