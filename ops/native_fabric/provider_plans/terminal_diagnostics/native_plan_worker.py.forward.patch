+_TERMINAL_REASONS = frozenset({
+    "PLAN_PHYSICAL_CUSTODY_UNSETTLED", "PLAN_ADMISSION_RETURN_MISMATCH",
+    "PLAN_ADMISSION_RETURN_UNQUALIFIED", "PLAN_LOCAL_EFFECT_UNCERTAIN",
+    "PLAN_PROCESS_RETURN_AMBIGUOUS", "PLAN_PROVIDER_RETURN_BINDING",
+    "PLAN_PROVIDER_CUSTODY_UNSETTLED", "PLAN_PROVIDER_CAPTURE_CHANGED",
+    "PLAN_PROVIDER_CLASSIFICATION_CHANGED", "PLAN_PROVIDER_RESPONSE_CHANGED",
+    "PLAN_LOCAL_RESULT_UNQUALIFIED",
+})
+
+
+class TerminalQualificationRefused(ValueError):
+    """A closed source-owned discriminator; never a terminal outcome."""
+
+
+def _terminal_failure_reason(exc):
+    if (type(exc) is TerminalQualificationRefused and exc.args
+            and type(exc.args[0]) is str and exc.args[0] in _TERMINAL_REASONS):
+        return exc.args[0]
+    if type(exc) is FileNotFoundError:
+        return "PLAN_TERMINAL_ARTIFACT_MISSING"
+    if type(exc) is PermissionError:
+        return "PLAN_TERMINAL_ARTIFACT_REFUSED"
+    if type(exc) is json.JSONDecodeError or isinstance(exc, UnicodeError):
+        return "PLAN_TERMINAL_RECEIPT_MALFORMED"
+    if isinstance(exc, sqlite3.Error):
+        return "PLAN_TERMINAL_QUOTA_OBSERVATION_UNAVAILABLE"
+    if type(exc) in (KeyError, TypeError):
+        return "PLAN_TERMINAL_RECEIPT_SHAPE_UNQUALIFIED"
+    if isinstance(exc, OSError):
+        return "PLAN_TERMINAL_ARTIFACT_UNAVAILABLE"
+    return "PLAN_TERMINAL_QUALIFICATION_UNAVAILABLE"
+
+
+def _diagnostic_identity(run, root, parent, pool, model):
+    raw = json.dumps([run, root, parent, pool, model],
+                     separators=(",", ":"), ensure_ascii=True).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _terminal_diagnostic_anchor(pool, model, request, request_raw, launch_raw):
+    """Capture hashes from the original validation, never fresh launch authority."""
+    import provider_outcome as outcome
+    try:
+        source = outcome.regular_bytes(Path(__file__), 1024 * 1024)
+        return {
+            "identity_sha256": _diagnostic_identity(request["run_id"], request["root_id"],
+                request.get("parent_run_id"), pool, model),
+            "request_sha256": outcome.digest(request_raw),
+            "launch_sha256": outcome.digest(launch_raw),
+            "source_sha256": outcome.digest(source),
+        }
+    except Exception:
+        # Optional diagnostics cannot acquire, block or reinterpret execution.
+        return None
+
+
+def _retain_terminal_diagnostic(pool, model, run, state, env, anchor, reason):
+    """One immutable UNKNOWN witness; no bodies, identities, replay or ledger."""
+    import provider_outcome as outcome
+    if (type(anchor) is not dict or set(anchor) != {
+            "identity_sha256", "request_sha256", "launch_sha256", "source_sha256"}
+            or any(type(v) is not str or re.fullmatch(r"[0-9a-f]{64}", v) is None
+                   for v in anchor.values())
+            or type(reason) is not str
+            or reason not in _TERMINAL_REASONS | {
+                "PLAN_TERMINAL_ARTIFACT_MISSING", "PLAN_TERMINAL_ARTIFACT_REFUSED",
+                "PLAN_TERMINAL_RECEIPT_MALFORMED", "PLAN_TERMINAL_QUOTA_OBSERVATION_UNAVAILABLE",
+                "PLAN_TERMINAL_RECEIPT_SHAPE_UNQUALIFIED", "PLAN_TERMINAL_ARTIFACT_UNAVAILABLE",
+                "PLAN_TERMINAL_QUALIFICATION_UNAVAILABLE"}
+            or state != HERE / "state" / "remote_sub"
+            or anchor["identity_sha256"] != _diagnostic_identity(run,
+                env.get("POOL_ORCHESTRATOR_ID"), env.get("POOL_PARENT_RUN_ID") or None,
+                pool, model)):
+        return False
+
+    def same_original():
+        return (outcome.digest(outcome.regular_bytes(state / (run + ".request.json"), 32768))
+                    == anchor["request_sha256"]
+                and outcome.digest(outcome.regular_bytes(state / (run + ".request-launch.json"), 32768))
+                    == anchor["launch_sha256"]
+                and outcome.digest(outcome.regular_bytes(Path(__file__), 1024 * 1024))
+                    == anchor["source_sha256"])
+    try:
+        if not same_original():
+            return False
+        # The binding is opaque: no root/account/model, output, error text,
+        # provider receipt or process/lease identity is copied into this frame.
+        binding = outcome.digest(json.dumps(anchor, sort_keys=True,
+            separators=(",", ":")).encode())
+        outcome.write_new(state / (run + ".local-terminal-diagnostic.json"), {
+            "schema": "mastermind.local_terminal_diagnostic.v1",
+            "binding_sha256": binding, "source_sha256": anchor["source_sha256"],
+            "reason": reason, "state": "EFFECT_UNKNOWN",
+            "qualification": "NOT_RECONCILED", "terminal_authorized": False,
+            "replay_allowed": False,
+        })
+        # A retained historical frame supplies no currentness or terminal grant.
+        # Drift here withholds even the public retained acknowledgement.
+        return same_original()
+    except Exception:
+        return False
+
