+def _plan_active_directory():
+    """Resolve only the incumbent publisher's declared shared-active binding."""
+    from pathlib import Path
+    active = Path(HERE) / "active"
+    if active.is_symlink():
+        release = json.loads((Path(HERE).parent / "RELEASE.json").read_text())
+        stable = Path(release["stable_ext"])
+        expected = str(stable / "active")
+        if (not stable.is_absolute() or release["links"].get("ext/active") != expected
+                or os.readlink(active) != expected):
+            raise ValueError("plan shared active binding mismatch")
+        active = active.resolve(strict=True)
+    return active
+
