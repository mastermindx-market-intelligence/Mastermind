+def _json_safe_time(value: Any) -> Any:
+    """Render YAML-loaded timestamps for the JSON status snapshot.
+
+    PyYAML turns an unquoted `parked_until: 2026-11-09T03:30:00Z` into a
+    datetime, which json.dump rejects. Aware values are written in UTC with Z.
+    """
+    if isinstance(value, datetime):
+        if value.tzinfo is None:
+            return value.isoformat()
+        return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+    if isinstance(value, date):
+        return value.isoformat()
+    if isinstance(value, dict):
+        return {key: _json_safe_time(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_json_safe_time(item) for item in value]
+    return value
+
