+def _is_retained_settlement_metadata(path):
+    """Classify retained metadata; never settle a run or remove a lane marker.
+
+    Every non-metadata entry still blocks publication, including the original
+    run marker if removal was interrupted. Do not ignore arbitrary dotfiles.
+    Only the closed settlement kinds below qualify, each in its exact recorded
+    shape: a settlement that proves no live worker of its run, or a moved hold
+    marker whose retained seat settlement binds its exact bytes. Classifying a
+    record never clears its EFFECT_UNKNOWN or touches the file.
+    """
+    match = re.fullmatch(_RETAINED_METADATA_NAME, path.name)
+    if not match:
+        return False
+    run, kind = match[1], match[2]
+    try:
+        from lane_runtime import LaneRuntimeError, validate_preexec_settlement_receipt
+    except ImportError:
+        return False
+    try:
+        loaded = _read_retained_metadata(path)
+        if loaded is None:
+            return False
+        raw, value = loaded
+        if kind == "preexec-settlement":
+            if value.get('run_id') != run:
+                return False
+            validate_preexec_settlement_receipt(value)
+            return True
+        if kind == "seat-settlement":
+            return _retained_seat_settlement(value, run, path)
+        if kind == "sparse-settlement":
+            return _retained_sparse_settlement(value, run)
+        if kind == "physical-cleanup-settlement":
+            return _retained_physical_settlement(value, run)
+        if not _retained_hold(value, run):
+            return False
+        seat_path = path.with_name("." + run + ".seat-settlement.json")
+        seat = _read_retained_metadata(seat_path)
+        return (seat is not None and _retained_seat_settlement(seat[1], run, seat_path)
+                and seat[1].get("marker_moved_to") == str(path)
+                and seat[1]["marker_sha256"] == hashlib.sha256(raw).hexdigest()
+                and seat[1]["hold"] == value)
+    except (OSError, ValueError, TypeError, UnicodeError, RecursionError, LaneRuntimeError):
+        return False
+
