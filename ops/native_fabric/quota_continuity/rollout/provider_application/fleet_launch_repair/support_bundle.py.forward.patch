+def _retained_text(value):
+    return type(value) is str and 0 < len(value) <= 4096
+
+
+def _retained_count(value, minimum=0):
+    return type(value) is int and value >= minimum
+
+
+def _retained_time(value):
+    return type(value) is str and re.fullmatch(_RETAINED_TIME, value) is not None
