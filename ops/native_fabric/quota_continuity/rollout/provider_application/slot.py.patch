+def main(argv=None):
+    args = sys.argv[1:] if argv is None else list(argv)
+    if not args or args[0] not in {"byteplus", "experiential"}:
+        return _main(argv)
+    from pathlib import Path
+    from lane_runtime import LaneLease, LaneAdmissionRefused, enforce_remote_first_lane_launch
+    env = dict(os.environ)
+    pool = args[0]
+    if env.get("LANE_LEASED") == "1" or env.get("POOL_LEASE_ID"):
+        print("PLAN_UNVERIFIED_OUTER_LEASE_REFUSED", file=sys.stderr)
+        return 78
+    run, root = env.get("POOL_RUN_ID", ""), env.get("POOL_ORCHESTRATOR_ID", "")
+    if not all(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}", value) for value in (run, root)):
+        print("PLAN_ORIGINAL_IDENTITY_REQUIRED", file=sys.stderr)
+        return 78
+    active = Path(HERE) / "active"
+    if env.get("LANE_ACTIVE_DIR") and Path(env["LANE_ACTIVE_DIR"]).resolve() != active.resolve():
+        print("PLAN_NONCANONICAL_ACTIVE_DIRECTORY", file=sys.stderr)
+        return 78
+    refusal = _local_host_admission_refusal(pool)
+    if refusal:
+        _plan_admission_refusal(pool, "host_admission", 78)
+        print("PLAN_HOST_ADMISSION_REFUSED " + refusal, file=sys.stderr)
+        return 78
+    physical = None
+    try:
+        limits = enforce_remote_first_lane_launch(Path(HERE), env, requested_engines=(pool,))
+        if limits is None:
+            raise LaneRuntimeConfigError("plan_local_host_policy_required")
+        key = "plan-" + hashlib.sha256((root + "\n" + run + "\n" + pool).encode()).hexdigest()[:40]
+        physical = LaneLease.acquire(
+            active, key=key, label=key, max_active=limits["max_active"],
+            load_ratio_limit=limits["load_ratio_limit"],
+            source_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+            env=env, reconcile_unreleased=True)
+        return _main(argv, physical_lease=physical)
+    except LaneAdmissionRefused as exc:
+        _plan_admission_refusal(pool, "physical_admission", 75)
+        print("LANE_ADMISSION_REFUSED " + json.dumps(exc.snapshot.public_dict(), sort_keys=True), file=sys.stderr)
+        return 75
+    except LaneRuntimeConfigError as exc:
+        if physical is None:
+            _plan_admission_refusal(pool, "host_policy", 78)
+        print("PLAN_HOST_POLICY_REFUSED " + str(exc), file=sys.stderr)
+        return 78
+    finally:
+        if physical is not None:
+            physical.release()
+
+
 if __name__ == "__main__":
     sys.exit(main())
