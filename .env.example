# Copy to .env (gitignored) and fill in. Loaded automatically by `import bot`.
# Claude Code subscription token — mint with: claude setup-token
# This is the LEGACY bare token; prefer the numbered pool below when multiple accounts available.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# 'waterfall' = Macro shared pool: Codex first, Claude OAuth slots as fallback (VPS);
# 'codex'/'cli' = direct diagnostics; 'api' = metered Anthropic Messages API
# 'explabs' = Experiential Labs gateway (opt in only; never automatic fallback)
BOT_LLM_BACKEND=cli
MASTERMIND_SHARED_LLM_POOL=0

# Experiential Labs OpenAI-compatible gateway. To opt in locally, set
# BOT_LLM_BACKEND=explabs; leave unchanged to keep the current waterfall.
# The actual EXPLABS_API_KEY goes ONLY in your gitignored .env, never in Git.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=deepseek-v4.1-flash

# Two-organization active-active gateway. Completely disabled until BOTH
# organizations, distinct keys and per-key budget/serving gates are verified.
# Account labels stay in local .env, not this public example.
# This Brain-local selector does not replace Executive OS capacity admission.
EXPLABS_POOL_ENABLED=0
EXPLABS_ACCOUNT_1_ENABLED=0
EXPLABS_ACCOUNT_1_ORG_SLUG=
EXPLABS_ACCOUNT_1_MAX_INFLIGHT=2
# Match the gateway-enforced per-key daily USD cap; blank refuses dispatch.
EXPLABS_ACCOUNT_1_DAILY_CAP_USD=
# Separate second-org key; never reuse the first key or a provider BYOK key.
EXPLABS_API_KEY_2=
EXPLABS_ACCOUNT_2_ENABLED=0
EXPLABS_ACCOUNT_2_ORG_SLUG=
EXPLABS_ACCOUNT_2_MAX_INFLIGHT=2
EXPLABS_ACCOUNT_2_DAILY_CAP_USD=

# Codex automation. On the shared VPS this is the SAME protected CODEX_HOME used
# by Macro Dashboard's load balancer. Keep the CLI itself read-only; paper
# submissions flow only through the typed MCP tools.
CODEX_HOME=
MASTERMIND_CODEX_PYTHON=
MASTERMIND_CODEX_TIMEOUT_SEC=1800
MASTERMIND_CODEX_WEB_SEARCH=1
# --- OAuth key pool (rotation failover) ---
# Numbered OAuth token slots 1..7. Slots 3..7 are the primary pool; 1..2 legacy fallback.
# Add tokens from additional Claude accounts/subscriptions for automatic failover.
# The rotation layer (brain/key_rotor.py) picks the first non-cooling key automatically.
# CLAUDE_CODE_OAUTH_TOKEN_3=sk-ant-oat01-...
# CLAUDE_CODE_OAUTH_TOKEN_4=sk-ant-oat01-...
# CLAUDE_CODE_OAUTH_TOKEN_5=sk-ant-oat01-...
# CLAUDE_CODE_OAUTH_TOKEN_6=sk-ant-oat01-...
# CLAUDE_CODE_OAUTH_TOKEN_7=sk-ant-oat01-...
# Which slots are eligible (csv of slot numbers and/or "legacy"). Absent = all enabled.
# Example: METAB_KEYS_ENABLED=3,4,5
METAB_KEYS_ENABLED=
# --- Auth ---
# The browser password-cookie LOGIN flow was REMOVED (page-only scope): there is no
# /login page and reads are always open. Mutating/LLM-triggering POSTs are still
# gated by the bearer OPERATOR tier below, and MASTERMIND_SERVE_ONLY still blocks
# operator mutations on the internet-facing read mirror.
# Bearer token for the OPERATOR tier + non-browser clients (snapshot push / uptime
# ping). Required to fire mutating/LLM POSTs; unset = operator paths open (dev only).
#   Authorization: Bearer <token>
MASTERMIND_AUTH_TOKEN=
# Serve-only (read-only mirror) mode: =1 blocks operator mutations + never starts the
# scheduler. Set on the internet-facing VPS mirror; leave unset on the primary.
# MASTERMIND_SERVE_ONLY=1
