{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind.local/schemas/navigator-capability-health-v1.json",
  "title": "Mastermind Navigator capability health packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "protected_master_sha",
    "role_profile",
    "domain_overlays",
    "requested_route",
    "sources",
    "surfaces",
    "selected_surface_id",
    "suppressed_surface_ids"
  ],
  "properties": {
    "schema": {
      "const": "mastermind.navigator_capability_health.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "protected_master_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "role_profile": {
      "enum": [
        "web_ceo_core",
        "native_builder_operator",
        "browser_provider_operator"
      ]
    },
    "domain_overlays": {
      "type": "array",
      "items": {
        "enum": [
          "domain_deploy",
          "domain_data",
          "domain_design",
          "domain_comms"
        ]
      },
      "uniqueItems": true
    },
    "requested_route": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "selected_surface_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "suppressed_surface_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "dimension": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "nullableRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_ref",
        "project_ref",
        "session_ref",
        "runtime_generation",
        "source_sha"
      ],
      "properties": {
        "host_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "project_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "session_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "runtime_generation": {
          "$ref": "#/$defs/nullableRef"
        },
        "source_sha": {
          "$ref": "#/$defs/nullableRef"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "source_type",
        "artifact_identity",
        "revision",
        "observed_at",
        "coverage",
        "claim",
        "supports_dimensions"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "owner_native",
            "projection",
            "provider_report",
            "observed_call",
            "repository_source"
          ]
        },
        "artifact_identity": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "supports_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "installed",
              "enabled",
              "authenticated_or_connected",
              "callable",
              "organizationally_authorized",
              "proven_live",
              "binding_current",
              "implementation_state",
              "usable_scope"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "capability_class",
        "canonical_owner",
        "minimal_tool_family",
        "required_for_role",
        "implementation_state",
        "usable_scope",
        "binding_current",
        "installed",
        "enabled",
        "authenticated_or_connected",
        "callable",
        "organizationally_authorized",
        "proven_live",
        "state",
        "evidence",
        "binding",
        "blocker",
        "next_probe"
      ],
      "properties": {
        "surface_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_class": {
          "type": "string",
          "minLength": 1
        },
        "canonical_owner": {
          "type": "string",
          "minLength": 1
        },
        "minimal_tool_family": {
          "type": "string",
          "minLength": 1
        },
        "required_for_role": {
          "type": "boolean"
        },
        "implementation_state": {
          "enum": [
            "BUILT",
            "SPEC_ONLY",
            "NOT_BUILT",
            "UNKNOWN"
          ]
        },
        "usable_scope": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE",
            "UNKNOWN"
          ]
        },
        "binding_current": {
          "$ref": "#/$defs/dimension"
        },
        "installed": {
          "$ref": "#/$defs/dimension"
        },
        "enabled": {
          "$ref": "#/$defs/dimension"
        },
        "authenticated_or_connected": {
          "$ref": "#/$defs/dimension"
        },
        "callable": {
          "$ref": "#/$defs/dimension"
        },
        "organizationally_authorized": {
          "$ref": "#/$defs/dimension"
        },
        "proven_live": {
          "$ref": "#/$defs/dimension"
        },
        "state": {
          "enum": [
            "PROVEN_LIVE",
            "UNAVAILABLE",
            "BUILT_NOT_PROVEN",
            "DEGRADED",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_probe": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PROVEN_LIVE"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "implementation_state": {
                "const": "BUILT"
              },
              "usable_scope": {
                "const": "FULL"
              },
              "binding_current": {
                "const": "YES"
              },
              "installed": {
                "const": "YES"
              },
              "enabled": {
                "const": "YES"
              },
              "authenticated_or_connected": {
                "const": "YES"
              },
              "callable": {
                "const": "YES"
              },
              "organizationally_authorized": {
                "const": "YES"
              },
              "proven_live": {
                "const": "YES"
              },
              "binding": {
                "anyOf": [
                  {
                    "properties": {
                      "host_ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "host_ref"
                    ]
                  },
                  {
                    "properties": {
                      "project_ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "project_ref"
                    ]
                  },
                  {
                    "properties": {
                      "session_ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "session_ref"
                    ]
                  },
                  {
                    "properties": {
                      "runtime_generation": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "runtime_generation"
                    ]
                  },
                  {
                    "properties": {
                      "source_sha": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_sha"
                    ]
                  }
                ]
              },
              "blocker": {
                "type": "null"
              },
              "next_probe": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "blocker": {
                "type": "string",
                "minLength": 1
              },
              "next_probe": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "PROVEN_LIVE"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "$ref": "#/$defs/stateRuleProvenLive"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNAVAILABLE"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "$ref": "#/$defs/stateRuleUnavailable"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "BUILT_NOT_PROVEN"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "$ref": "#/$defs/stateRuleBuiltNotProven"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "DEGRADED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "$ref": "#/$defs/stateRuleDegraded"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "$ref": "#/$defs/stateRuleUnknown"
          }
        }
      ]
    },
    "stateRuleProvenLive": {
      "properties": {
        "implementation_state": {
          "const": "BUILT"
        },
        "usable_scope": {
          "const": "FULL"
        },
        "binding_current": {
          "const": "YES"
        },
        "installed": {
          "const": "YES"
        },
        "enabled": {
          "const": "YES"
        },
        "authenticated_or_connected": {
          "const": "YES"
        },
        "callable": {
          "const": "YES"
        },
        "organizationally_authorized": {
          "const": "YES"
        },
        "proven_live": {
          "const": "YES"
        }
      },
      "required": [
        "implementation_state",
        "usable_scope",
        "binding_current",
        "installed",
        "enabled",
        "authenticated_or_connected",
        "callable",
        "organizationally_authorized",
        "proven_live"
      ]
    },
    "stateRuleUnavailable": {
      "anyOf": [
        {
          "properties": {
            "implementation_state": {
              "const": "NOT_BUILT"
            }
          },
          "required": [
            "implementation_state"
          ]
        },
        {
          "properties": {
            "usable_scope": {
              "const": "NONE"
            }
          },
          "required": [
            "usable_scope"
          ]
        },
        {
          "properties": {
            "installed": {
              "const": "NO"
            }
          },
          "required": [
            "installed"
          ]
        },
        {
          "properties": {
            "enabled": {
              "const": "NO"
            }
          },
          "required": [
            "enabled"
          ]
        },
        {
          "properties": {
            "authenticated_or_connected": {
              "const": "NO"
            }
          },
          "required": [
            "authenticated_or_connected"
          ]
        },
        {
          "properties": {
            "callable": {
              "const": "NO"
            }
          },
          "required": [
            "callable"
          ]
        },
        {
          "properties": {
            "organizationally_authorized": {
              "const": "NO"
            }
          },
          "required": [
            "organizationally_authorized"
          ]
        },
        {
          "properties": {
            "binding_current": {
              "const": "NO"
            }
          },
          "required": [
            "binding_current"
          ]
        }
      ]
    },
    "stateRuleBuiltNotProven": {
      "allOf": [
        {
          "properties": {
            "implementation_state": {
              "const": "BUILT"
            },
            "proven_live": {
              "const": "NO"
            }
          },
          "required": [
            "implementation_state",
            "proven_live"
          ]
        },
        {
          "properties": {
            "usable_scope": {
              "enum": [
                "FULL",
                "UNKNOWN"
              ]
            }
          },
          "required": [
            "usable_scope"
          ]
        },
        {
          "not": {
            "$ref": "#/$defs/stateRuleUnavailable"
          }
        }
      ]
    },
    "stateRuleDegraded": {
      "allOf": [
        {
          "properties": {
            "implementation_state": {
              "const": "BUILT"
            },
            "usable_scope": {
              "const": "PARTIAL"
            }
          },
          "required": [
            "implementation_state",
            "usable_scope"
          ]
        },
        {
          "not": {
            "$ref": "#/$defs/stateRuleUnavailable"
          }
        }
      ]
    },
    "stateRuleUnknown": {
      "not": {
        "anyOf": [
          {
            "$ref": "#/$defs/stateRuleProvenLive"
          },
          {
            "$ref": "#/$defs/stateRuleUnavailable"
          },
          {
            "$ref": "#/$defs/stateRuleBuiltNotProven"
          },
          {
            "$ref": "#/$defs/stateRuleDegraded"
          }
        ]
      }
    },
    "authorizedOverlaySurfaceDomainDeploy": {
      "type": "object",
      "properties": {
        "capability_class": {
          "const": "domain_deploy"
        },
        "organizationally_authorized": {
          "const": "YES"
        },
        "evidence": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": {
              "source_type": {
                "const": "owner_native"
              },
              "supports_dimensions": {
                "type": "array",
                "contains": {
                  "const": "organizationally_authorized"
                },
                "minContains": 1
              }
            },
            "required": [
              "source_type",
              "supports_dimensions"
            ]
          },
          "minContains": 1
        }
      },
      "required": [
        "capability_class",
        "organizationally_authorized",
        "evidence"
      ]
    },
    "authorizedOverlaySurfaceDomainData": {
      "type": "object",
      "properties": {
        "capability_class": {
          "const": "domain_data"
        },
        "organizationally_authorized": {
          "const": "YES"
        },
        "evidence": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": {
              "source_type": {
                "const": "owner_native"
              },
              "supports_dimensions": {
                "type": "array",
                "contains": {
                  "const": "organizationally_authorized"
                },
                "minContains": 1
              }
            },
            "required": [
              "source_type",
              "supports_dimensions"
            ]
          },
          "minContains": 1
        }
      },
      "required": [
        "capability_class",
        "organizationally_authorized",
        "evidence"
      ]
    },
    "authorizedOverlaySurfaceDomainDesign": {
      "type": "object",
      "properties": {
        "capability_class": {
          "const": "domain_design"
        },
        "organizationally_authorized": {
          "const": "YES"
        },
        "evidence": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": {
              "source_type": {
                "const": "owner_native"
              },
              "supports_dimensions": {
                "type": "array",
                "contains": {
                  "const": "organizationally_authorized"
                },
                "minContains": 1
              }
            },
            "required": [
              "source_type",
              "supports_dimensions"
            ]
          },
          "minContains": 1
        }
      },
      "required": [
        "capability_class",
        "organizationally_authorized",
        "evidence"
      ]
    },
    "authorizedOverlaySurfaceDomainComms": {
      "type": "object",
      "properties": {
        "capability_class": {
          "const": "domain_comms"
        },
        "organizationally_authorized": {
          "const": "YES"
        },
        "evidence": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": {
              "source_type": {
                "const": "owner_native"
              },
              "supports_dimensions": {
                "type": "array",
                "contains": {
                  "const": "organizationally_authorized"
                },
                "minContains": 1
              }
            },
            "required": [
              "source_type",
              "supports_dimensions"
            ]
          },
          "minContains": 1
        }
      },
      "required": [
        "capability_class",
        "organizationally_authorized",
        "evidence"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "domain_overlays": {
            "contains": {
              "const": "domain_deploy"
            },
            "minContains": 1
          }
        },
        "required": [
          "domain_overlays"
        ]
      },
      "then": {
        "properties": {
          "surfaces": {
            "contains": {
              "$ref": "#/$defs/authorizedOverlaySurfaceDomainDeploy"
            },
            "minContains": 1
          }
        },
        "required": [
          "surfaces"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "surfaces": {
            "contains": {
              "type": "object",
              "properties": {
                "capability_class": {
                  "const": "domain_deploy"
                }
              },
              "required": [
                "capability_class"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "surfaces"
        ]
      },
      "then": {
        "properties": {
          "domain_overlays": {
            "contains": {
              "const": "domain_deploy"
            },
            "minContains": 1
          }
        },
        "required": [
          "domain_overlays"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "domain_overlays": {
            "contains": {
              "const": "domain_data"
            },
            "minContains": 1
          }
        },
        "required": [
          "domain_overlays"
        ]
      },
      "then": {
        "properties": {
          "surfaces": {
            "contains": {
              "$ref": "#/$defs/authorizedOverlaySurfaceDomainData"
            },
            "minContains": 1
          }
        },
        "required": [
          "surfaces"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "surfaces": {
            "contains": {
              "type": "object",
              "properties": {
                "capability_class": {
                  "const": "domain_data"
                }
              },
              "required": [
                "capability_class"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "surfaces"
        ]
      },
      "then": {
        "properties": {
          "domain_overlays": {
            "contains": {
              "const": "domain_data"
            },
            "minContains": 1
          }
        },
        "required": [
          "domain_overlays"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "domain_overlays": {
            "contains": {
              "const": "domain_design"
            },
            "minContains": 1
          }
        },
        "required": [
          "domain_overlays"
        ]
      },
      "then": {
        "properties": {
          "surfaces": {
            "contains": {
              "$ref": "#/$defs/authorizedOverlaySurfaceDomainDesign"
            },
            "minContains": 1
          }
        },
        "required": [
          "surfaces"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "surfaces": {
            "contains": {
              "type": "object",
              "properties": {
                "capability_class": {
                  "const": "domain_design"
                }
              },
              "required": [
                "capability_class"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "surfaces"
        ]
      },
      "then": {
        "properties": {
          "domain_overlays": {
            "contains": {
              "const": "domain_design"
            },
            "minContains": 1
          }
        },
        "required": [
          "domain_overlays"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "domain_overlays": {
            "contains": {
              "const": "domain_comms"
            },
            "minContains": 1
          }
        },
        "required": [
          "domain_overlays"
        ]
      },
      "then": {
        "properties": {
          "surfaces": {
            "contains": {
              "$ref": "#/$defs/authorizedOverlaySurfaceDomainComms"
            },
            "minContains": 1
          }
        },
        "required": [
          "surfaces"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "surfaces": {
            "contains": {
              "type": "object",
              "properties": {
                "capability_class": {
                  "const": "domain_comms"
                }
              },
              "required": [
                "capability_class"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "surfaces"
        ]
      },
      "then": {
        "properties": {
          "domain_overlays": {
            "contains": {
              "const": "domain_comms"
            },
            "minContains": 1
          }
        },
        "required": [
          "domain_overlays"
        ]
      }
    }
  ]
}
