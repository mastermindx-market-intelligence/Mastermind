{
  "schema": "mastermind.navigator_capability_state_rules.v1",
  "dimensions": [
    "installed",
    "enabled",
    "authenticated_or_connected",
    "callable",
    "organizationally_authorized",
    "proven_live",
    "requested_action_serviceability"
  ],
  "unknown_never_promotes": true,
  "package_name_never_promotes": true,
  "ordered_rules": [
    {
      "state": "PROVEN_LIVE",
      "when": {
        "all": [
          {
            "field": "implementation_state",
            "equals": "BUILT"
          },
          {
            "field": "usable_scope",
            "equals": "FULL"
          },
          {
            "field": "installed",
            "equals": "YES"
          },
          {
            "field": "enabled",
            "equals": "YES"
          },
          {
            "field": "callable",
            "equals": "YES"
          },
          {
            "field": "organizationally_authorized",
            "equals": "YES"
          },
          {
            "field": "proven_live",
            "equals": "YES"
          },
          {
            "field": "binding_current",
            "equals": "YES"
          },
          {
            "field": "requested_action_serviceability",
            "equals": "YES"
          }
        ],
        "any": [
          {
            "field": "authenticated_or_connected",
            "equals": "YES"
          },
          {
            "field": "authenticated_or_connected",
            "equals": "NOT_APPLICABLE"
          }
        ]
      }
    },
    {
      "state": "UNAVAILABLE",
      "when": {
        "any": [
          {
            "field": "implementation_state",
            "equals": "NOT_BUILT"
          },
          {
            "field": "usable_scope",
            "equals": "NONE"
          },
          {
            "field": "installed",
            "equals": "NO"
          },
          {
            "field": "enabled",
            "equals": "NO"
          },
          {
            "field": "authenticated_or_connected",
            "equals": "NO"
          },
          {
            "field": "callable",
            "equals": "NO"
          },
          {
            "field": "organizationally_authorized",
            "equals": "NO"
          },
          {
            "field": "binding_current",
            "equals": "NO"
          },
          {
            "field": "requested_action_serviceability",
            "equals": "NO"
          }
        ]
      }
    },
    {
      "state": "BUILT_NOT_PROVEN",
      "when": {
        "all": [
          {
            "field": "implementation_state",
            "equals": "BUILT"
          },
          {
            "field": "proven_live",
            "equals": "NO"
          }
        ],
        "any": [
          {
            "field": "usable_scope",
            "equals": "FULL"
          },
          {
            "field": "usable_scope",
            "equals": "UNKNOWN"
          }
        ]
      }
    },
    {
      "state": "DEGRADED",
      "when": {
        "all": [
          {
            "field": "implementation_state",
            "equals": "BUILT"
          },
          {
            "field": "usable_scope",
            "equals": "PARTIAL"
          }
        ],
        "none": [
          {
            "field": "installed",
            "equals": "NO"
          },
          {
            "field": "enabled",
            "equals": "NO"
          },
          {
            "field": "authenticated_or_connected",
            "equals": "NO"
          },
          {
            "field": "callable",
            "equals": "NO"
          },
          {
            "field": "organizationally_authorized",
            "equals": "NO"
          },
          {
            "field": "binding_current",
            "equals": "NO"
          },
          {
            "field": "requested_action_serviceability",
            "equals": "NO"
          }
        ]
      }
    },
    {
      "state": "UNKNOWN",
      "when": {}
    }
  ],
  "notes": [
    "PROVEN_LIVE requires BUILT implementation, FULL usable scope, a current binding, and exact YES evidence for every effective-capability gate.",
    "UNAVAILABLE requires explicit negative owner evidence for implementation, usable scope, installation, enablement, connection, callability, authorization, or binding currentness.",
    "BUILT_NOT_PROVEN means built source or component evidence exists without accepted live proof for the exact target epoch.",
    "DEGRADED means a bounded partial path remains usable, with no explicit negative gate, and its limitation is named.",
    "UNKNOWN is the fail-closed default when decisive owner-native evidence is missing.",
    "Requested action class is closed to READ, WRITE, or ADMIN and is evaluated independently from route-level callability.",
    "A successful READ observation never establishes WRITE or ADMIN serviceability; an unprobed requested action remains UNKNOWN until owner-native discovery or non-effectful preflight evidence resolves it.",
    "A requested action may be UNAVAILABLE from requested_action_serviceability=NO only when direct current owner-native or observed-call evidence binds that exact action class."
  ]
}
