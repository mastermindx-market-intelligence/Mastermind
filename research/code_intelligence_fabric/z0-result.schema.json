{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastermind CodeIntel Z0 Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "generated_at",
    "manifest_digest",
    "path_policy_digest",
    "tool_schema_digest",
    "zoekt_source_commit",
    "binary_digests",
    "repository_statuses",
    "resource_observations"
  ],
  "properties": {
    "schema_version": {"const": "mastermind.codeintel_z0_result.v1"},
    "decision": {
      "enum": [
        "ZOEKT_FACADE_ACCEPTED_FOR_CI3",
        "ZOEKT_REQUIRES_ARCHITECTURE_REVISION",
        "NO_SAFE_GLOBAL_INDEX"
      ]
    },
    "generated_at": {"type": "string"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "zoekt_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "binary_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoekt_git_index", "zoekt_webserver"],
      "properties": {
        "zoekt_git_index": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "zoekt_webserver": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "repository_statuses": {"type": "array"},
    "resource_observations": {"type": "object"},
    "evaluation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "manifest_digest",
        "source_census_digest",
        "ledger_digest",
        "run_kind",
        "active_generation_id",
        "required_trial_count",
        "recorded_trial_count",
        "failed_trial_count",
        "required_failure_injection_count",
        "recorded_failure_injection_count",
        "all_resources_known",
        "all_identity_bound",
        "reasons"
      ],
      "properties": {
        "state": {
          "enum": [
            "ELIGIBLE_REAL_EMPIRICAL_EVIDENCE",
            "NON_DECISION_INCOMPLETE_EVIDENCE",
            "NON_DECISION_SYNTHETIC_ONLY"
          ]
        },
        "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_census_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ledger_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_kind": {"enum": ["real", "synthetic"]},
        "active_generation_id": {"type": ["string", "null"]},
        "required_trial_count": {"type": "integer", "minimum": 0},
        "recorded_trial_count": {"type": "integer", "minimum": 0},
        "failed_trial_count": {"type": "integer", "minimum": 0},
        "required_failure_injection_count": {"type": "integer", "minimum": 0},
        "recorded_failure_injection_count": {"type": "integer", "minimum": 0},
        "all_resources_known": {"type": "boolean"},
        "all_identity_bound": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["decision"],
        "properties": {
          "decision": {"const": "ZOEKT_FACADE_ACCEPTED_FOR_CI3"}
        }
      },
      "then": {
        "required": ["evaluation_evidence"],
        "properties": {
          "evaluation_evidence": {
            "required": [
              "state",
              "run_kind",
              "active_generation_id",
              "required_trial_count",
              "recorded_trial_count",
              "failed_trial_count",
              "required_failure_injection_count",
              "recorded_failure_injection_count",
              "all_resources_known",
              "all_identity_bound",
              "reasons"
            ],
            "properties": {
              "state": {"const": "ELIGIBLE_REAL_EMPIRICAL_EVIDENCE"},
              "run_kind": {"const": "real"},
              "active_generation_id": {"type": "string", "minLength": 1},
              "required_trial_count": {"minimum": 1},
              "recorded_trial_count": {"minimum": 1},
              "failed_trial_count": {"const": 0},
              "required_failure_injection_count": {"minimum": 1},
              "recorded_failure_injection_count": {"minimum": 1},
              "all_resources_known": {"const": true},
              "all_identity_bound": {"const": true},
              "reasons": {"maxItems": 0}
            }
          }
        }
      }
    }
  ]
}
