          "minimum_output": ["preparation_ref", "expires_at", "candidate_paths", "candidate_diff_hash", "preconditions", "status", "issues"],
          "notes": "Preparation performs no file write and creates no durable prepared-action database."
        },
        {
          "name": "commit_workspace_patch",
          "privilege": "W1_ROUTINE",
          "mutating": true,
          "model_input": ["preparation_ref"],
          "minimum_output": ["effect_state", "changed_paths", "post_image_hashes", "workspace_diff_hash", "source_preconditions", "reconciliation_ref"],
