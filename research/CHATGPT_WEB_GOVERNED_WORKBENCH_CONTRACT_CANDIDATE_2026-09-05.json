  "protected_source_basis": "8f3370e349ab8f1a54acac4c63697740f32715b1",
  "capability_state": "SPEC_ONLY",
  "principles": [
    "The workbench is a facade over an existing exact Attempt/provider execution context, not a lifecycle, session, memory, retry, queue, permission, workspace, or evidence owner.",
    "Leader and operator capability profiles are separate.",
    "The model never supplies host, principal, credential, account, profile, absolute root, worktree, branch, lease, fence, capability generation, or effect state.",
    "Every modifying call revalidates current owner predicates at invocation time.",
    "EFFECT_UNKNOWN blocks retry and provider/account/carrier failover.",
    "A durable process or MCP task handle is not proof that an inactive ChatGPT reasoning session can be awakened.",
    "Existing frozen Mastermind tool contracts are not modified by this candidate.",
    "All named tools below are proposed semantics, not callable or approved schemas."
  ],
  "capability_profiles": [
    {
      "id": "LEADER_READ",
      "purpose": "Task-relevant source/evidence reads for a Sol leader.",
      "allowed_surfaces": ["workspace_read"],
      "forbidden_surfaces": ["workspace_change", "process", "desktop"],
      "authority_note": "Use existing Steward, GitHub and CodeIntel owners where possible; no unrestricted local access."
    },
    {
      "id": "EXACT_OPERATOR",
      "purpose": "File and process capabilities for one host-injected Job/Attempt/worker/workspace binding.",
      "allowed_surfaces": ["workspace_read", "workspace_change", "process"],
      "forbidden_surfaces": ["desktop"],
      "authority_note": "Requires exact Attempt binding, current source and an enforcing worker sandbox/provider owner."
    },
    {
      "id": "EXACT_OPERATOR_DESKTOP",
      "purpose": "Optional disposable worker-browser observation and bounded semantic actuation.",
      "allowed_surfaces": ["workspace_read", "workspace_change", "process", "desktop"],
      "forbidden_surfaces": [],
      "authority_note": "Requires a separately reviewed Desktop capability generation and exact approved profile/window."
    }
  ],
