        },
        {
          "name": "checkpoint_workspace",
          "privilege": "R0_OBSERVE",
          "mutating": false,
          "model_input": [],
          "minimum_output": ["source_continuity_receipt", "workspace_ref", "local_head", "remote_head", "tree", "paths", "dirty_state", "issues"],
