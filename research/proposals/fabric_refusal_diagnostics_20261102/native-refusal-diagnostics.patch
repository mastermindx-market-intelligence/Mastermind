 class FabricTaskError(RuntimeError):
     pass
+
+
+# Diagnostic values only: never admission, retry, routing or parent attestation.
+_REQUEST_REFUSAL_CODES = frozenset({
+    "NO_ROUTE", "ROUTE_INCOMPLETE", "REQUEST_ROUTING_RETURN_UNQUALIFIED",
+    "REQUEST_MAX_TURNS_INVALID", "REQUEST_MAX_TURNS_ROUTE_UNSUPPORTED",
+    "ECONOMIC_POLICY_REFUSED", "UNCLASSIFIED_PRELAUNCH_REFUSAL",
+})
+
+
+def _safe_request_refusal_code(exc: BaseException) -> str:
+    unknown = "UNCLASSIFIED_PRELAUNCH_REFUSAL"
+    if type(exc) is not FabricTaskError:
+        return unknown
+    # Only the owner-assigned route marker and exact allowlisted error prefixes
+    # survive. Never serialize exception text, arguments, credentials or paths.
+    marker = getattr(exc, "_request_refusal_code", None)
+    if type(marker) is str and len(marker) <= 64 and marker in _REQUEST_REFUSAL_CODES:
+        return marker
+    args = exc.args
+    if not args or type(args[0]) is not str or len(args[0]) > 1024:
+        return unknown
+    code = args[0].partition(":")[0]
+    return code if code in _REQUEST_REFUSAL_CODES else unknown
 
 
