+    def _fresh_glm_expiring_accounts(self, names: set[str]) -> Dict[str, float]:
+        """Optional account-level R31 preference using the EXISTING provider cache.
+
+        No provider calls, refreshes, credential reads, account writes, claims,
+        leases or new quota authority. Caller still selects/claims under the
+        incumbent SQLite lock, with its original hard grant/model cap checks.
+        Missing/stale/ambiguous observations confer *no* preference; ordinary
+        non-expiring account selection remains unchanged.
+        """
+        if not names:
+            return {}
+        try:
+            import pick
+            import quota_remote
+            policy = pick._burn_down_cfg(pick.load_pools())
+            if not policy["promote"]:
+                return {}
+            horizon_s = float(policy["hours_before_reset"]) * 3600.0
+            floor = float(policy["min_remaining_pct"])
+            if (not math.isfinite(horizon_s) or not 0 < horizon_s <= 7 * 86400
+                    or not math.isfinite(floor) or not 0 <= floor <= 100):
+                return {}
+            # This is the already-owned quota reader's local atomic cache,
+            # never glm_accounts_state/read_provider (which may call network).
+            path = quota_remote.CACHE_PATH
+            st = os.stat(path, follow_symlinks=False)
+            if not stat.S_ISREG(st.st_mode) or not 0 < st.st_size <= 1_048_576:
+                return {}
+            # One bounded no-follow descriptor binds source qualification to
+            # the bytes actually read. Never reopen the observed cache path.
+            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK
+                         | getattr(os, "O_NOFOLLOW", 0))
+            try:
+                opened = os.fstat(fd)
+                signature = (st.st_dev, st.st_ino, st.st_size,
+                             st.st_mtime_ns, st.st_ctime_ns)
+                first = (opened.st_dev, opened.st_ino, opened.st_size,
+                         opened.st_mtime_ns, opened.st_ctime_ns)
+                if not stat.S_ISREG(opened.st_mode) or first != signature:
+                    return {}
+                remaining = st.st_size
+                parts: List[bytes] = []
+                while remaining:
+                    chunk = os.read(fd, min(65536, remaining))
+                    if not chunk:
+                        return {}
+                    parts.append(chunk)
+                    remaining -= len(chunk)
+                after = os.fstat(fd)
+                last = (after.st_dev, after.st_ino, after.st_size,
+                        after.st_mtime_ns, after.st_ctime_ns)
+                if last != first:
+                    return {}
+                cache = json.loads(b"".join(parts))
+                if not isinstance(cache, dict):
+                    return {}
+            finally:
+                os.close(fd)
+            rows = ((cache.get("glm") or {}).get("accounts") or {})
+            if not isinstance(rows, dict):
+                return {}
+            now = float(self.now())
+            if not math.isfinite(now):
+                return {}
+            freshness = min(float(quota_remote.FRESH_S),
+                            float(quota_remote.REFRESH_INTERVAL_S))
+            if not math.isfinite(freshness) or freshness <= 0:
+                return {}
+        except (AttributeError, ImportError, OSError, TypeError, ValueError):
+            return {}
+
+        def date_epoch(value: Any) -> Optional[float]:
+            if type(value) is not str or not value.strip():
+                return None
+            try:
+                dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
+                if dt.utcoffset() is None:
+                    return None
+                epoch = dt.timestamp()
+                return epoch if math.isfinite(epoch) else None
+            except (OverflowError, TypeError, ValueError):
+                return None
+
+        def paired(row: Any, window: str) -> Optional[Tuple[float, float, float]]:
+            if not isinstance(row, dict):
+                return None
+            if (row.get("provider") != "glm"
+                    or row.get("window") != window
+                    or row.get("source") != "PROVIDER_AUTHORITATIVE"):
+                return None
+            pct = row.get("remaining_pct")
+            if type(pct) not in (float, int) or not math.isfinite(pct):
+                return None
+            observed = date_epoch(row.get("observed_at"))
+            reset = date_epoch(row.get("reset_at"))
+            if (observed is None or reset is None
+                    or not 0 <= now - observed <= freshness
+                    or reset <= now or not 0 <= pct <= 100):
+                return None
+            return (reset, float(pct), observed)
+
+        urgent: Dict[str, float] = {}
+        for name in names:
+            entry = rows.get(name)
+            if not isinstance(entry, dict):
+                continue
+            refreshed = entry.get("refreshed_at")
+            if (type(refreshed) not in (int, float)
+                    or not math.isfinite(refreshed)
+                    or not 0 <= now - refreshed <= freshness):
+                continue
+            states = entry.get("states")
+            if not isinstance(states, list) or len(states) > 8:
+                continue
+            # A missing or contradictory five-hour observation is not proof
+            # this account can use its still-unspent weekly window right now.
+            week = [paired(row, "weekly") for row in states
+                    if isinstance(row, dict) and row.get("window") == "weekly"]
+            short = [paired(row, "5h") for row in states
+                     if isinstance(row, dict) and row.get("window") == "5h"]
+            if len(week) != 1 or len(short) != 1 or week[0] is None or short[0] is None:
+                continue
+            weekly_reset, weekly_pct, weekly_observed = week[0]
+            _five_reset, five_pct, five_observed = short[0]
+            if (weekly_observed != five_observed
+                    or weekly_pct < floor or five_pct < floor
+                    or not 0 < weekly_reset - now <= horizon_s):
+                continue
+            urgent[name] = weekly_reset
+        return urgent
