{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mastermind OS",
  "version": "0.1.0",
  "identifier": "com.mastermind.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build -- --mode native"
  },
  "app": {
    "windows": [
      {
        "title": "Mastermind OS",
        "width": 1200,
        "height": 820,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "com.mastermind.os"
        ]
      }
    }
  }
}
