+def _clean_linked_sparse_donor(original: Path) -> Path:
+    """Select only a pre-provisioned, reviewed *linked* worktree in the same Git.
+
+    This is an opt-in source-root choice, not a new checkout/provisioning owner.
+    The old source checkout, its feature branch and its dirty bytes stay intact.
+    An absent or drifting dedicated donor refuses before any mint.
+    """
+    alternate = original.parent / "macro-fabric-reviewed"
+    try:
+        info = alternate.lstat()
+        link_info = (alternate / ".git").lstat()
+        original_git = (original / ".git").resolve(strict=True)
+        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
+                or alternate.is_symlink() or alternate.resolve(strict=True) != alternate
+                or not stat.S_ISREG(link_info.st_mode) or link_info.st_uid != os.getuid()
+                or (alternate / ".git").is_symlink()
+                or not original_git.is_dir()):
+            raise SparseWorkspaceRefused("FABRIC_SPARSE_REVIEWED_DONOR_UNQUALIFIED")
+    except (OSError, RuntimeError) as exc:
+        raise SparseWorkspaceRefused("FABRIC_SPARSE_REVIEWED_DONOR_UNAVAILABLE") from exc
+
+    def inspect(*args: str) -> str:
+        try:
+            p = subprocess.run(
+                ["git", "--no-optional-locks", "-C", str(alternate), *args],
+                capture_output=True, text=True, timeout=12, check=False,
+            )
+        except (OSError, subprocess.TimeoutExpired) as exc:
+            raise SparseWorkspaceRefused("FABRIC_SPARSE_REVIEWED_DONOR_UNAVAILABLE") from exc
+        if p.returncode or len(p.stdout) > 8192 or len(p.stderr) > 8192:
+            raise SparseWorkspaceRefused("FABRIC_SPARSE_REVIEWED_DONOR_UNQUALIFIED")
+        return p.stdout.strip()
+
+    try:
+        common = Path(inspect("rev-parse", "--path-format=absolute",
+                              "--git-common-dir")).resolve(strict=True)
+        gitdir = Path(inspect("rev-parse", "--path-format=absolute",
+                              "--git-dir")).resolve(strict=True)
+    except (OSError, RuntimeError) as exc:
+        raise SparseWorkspaceRefused("FABRIC_SPARSE_REVIEWED_DONOR_UNAVAILABLE") from exc
+    if (common != original_git
+            or gitdir.parent != original_git / "worktrees"
+            or inspect("rev-parse", "HEAD") != _MACRO_REVIEWED_MERGE
+            or inspect("rev-parse", "HEAD:scripts/worktree_sparse.py") != _MACRO_FABRIC_SPARSE_BLOB
