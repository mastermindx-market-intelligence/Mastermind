+def print_thermal_table(rows: List[Dict[str, Any]]) -> None:
+    """Read-only live host thermal projection, never a placement owner."""
+    entries = [r for r in rows if r.get("platform") == "linux"
+               and "lanes" in str(r.get("roles") or "").split(",")]
+    print("  THERMAL  (existing hwmon/procfs host snapshots; no extra daemon)")
+    if not entries:
+        print("  (no Linux lane hosts observed)")
+        return
+    print(f"  {'HOST':<8} {'CPU TCTL':>9} {'CPU BUSY':>9} {'HEAT':>14} {'COOLDOWN':>10} {'AGE':>8}")
+    for r in entries:
+        is_fresh = bool(r.get("reachable")) and r.get("age_label") not in ("STALE","NO_PROBE")
+        temp = r.get("cpu_temp_c") if is_fresh else None
+        busy = r.get("cpu_busy_pct") if is_fresh else None
+        risk = r.get("thermal_risk", "UNKNOWN") if is_fresh else (
+            "STALE" if r.get("age_label") == "STALE" else "DOWN/NO_PROBE")
+        temp_s = f"{float(temp):.1f}C" if type(temp) in (int,float) else "—"
+        busy_s = f"{float(busy):.1f}%" if type(busy) in (int,float) else "—"
+        secs = r.get("cooldown_remaining_s",0) if is_fresh else 0
+        cooldown = f"{(secs+59)//60}m" if type(secs) is int and secs>0 else "—"
+        print(f"  {r['host']:<8} {temp_s:>9} {busy_s:>9} {risk:>14} {cooldown:>10} {r.get('age_label','—'):>8}")
+        if is_fresh and risk in ("HOT","CRITICAL","RISING_FAST"):
+            tops = r.get("hot_processes") or []
+            if tops:
+                names = ", ".join(f"{x['comm']} {float(x['cpu_pct']):.0f}%"
+                                  for x in tops if isinstance(x.get("cpu_pct"),(int,float)))
+                print(f"    sampled CPU: {names[:105]}")
+    print("  Thermal observations are advisory; host picker and LaneLease enforce admission.")
 
 
