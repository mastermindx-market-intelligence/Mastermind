+"""Host registry metadata must never become a physical Fabric host."""
+import json
+import pathlib
+import subprocess
+import sys
+
+import host_pick
+import pool_status
+
+
+def test_metadata_keys_not_hosts_in_pick_status_or_pull(tmp_path, monkeypatch):
+    path = tmp_path / "hosts.json"
+    path.write_text(json.dumps({
+        "_doc": {"schema": "documentation"},
+        "_thermal_headroom_change_20261013": {"comment": "not a host"},
+        "ubuntu2": {"roles": ["lanes"], "ssh_alias": "ubuntu2",
+                    "worktree_root": "/home/ubuntu2"},
+    }))
+    assert list(host_pick.load_registry(str(path))) == ["ubuntu2"]
+    monkeypatch.setattr(pool_status, "HOSTS_JSON_PATH", str(path))
+    assert list(pool_status._load_host_registry()) == ["ubuntu2"]
+    pull = pathlib.Path(host_pick.__file__).with_name("host_pull_backend.py")
+    result = subprocess.run([sys.executable, str(pull), "read-hosts", str(path), "", "1"],
+                            check=False, capture_output=True, text=True, timeout=8)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.strip() == "ubuntu2|0|ubuntu2|/home/ubuntu2"
+    rejected = subprocess.run([sys.executable, str(pull), "read-hosts",
+                               str(path), "_thermal_headroom_change_20261013", "1"],
+                              check=False, capture_output=True, text=True, timeout=8)
+    assert rejected.returncode == 2
+    assert rejected.stdout == ""
+    assert "unknown host" in rejected.stderr
+
+
+def test_missing_account_validator_keeps_telemetry_but_grants_no_readiness(tmp_path):
+    # The readiness source is optional to host telemetry, never to account admission.
+    # The isolated backend intentionally cannot import glm_host_account_source.
+    import shutil
+    standalone = tmp_path / "isolated"
+    standalone.mkdir()
+    backend = standalone / "host_pull_backend.py"
+    shutil.copy2(pathlib.Path(host_pick.__file__).with_name("host_pull_backend.py"), backend)
+    state = tmp_path / "state"
+    state.mkdir(mode=0o700)
+    probe = ("load1=0.5\nncpu=4\nmem_free_gb=12\ndisk_free_gb=90\n"
+             "active_lanes_status=known\nactive_lanes=0\nprocess_active_lanes=0\n")
+    result = subprocess.run([sys.executable, str(backend), "write-state",
+                             str(state), "ubuntu1", "0", probe, "ubuntu1"],
+                            capture_output=True, text=True, timeout=8)
+    assert result.returncode == 0, result.stderr
+    output = json.loads((state / "ubuntu1.json").read_text())
+    assert output["reachable"] is True and output["load1"] == 0.5
+    assert output["active_lanes"] == 0
+    assert "glm_local_account_readiness" not in output
+    assert "bailian_local_account_readiness" not in output
