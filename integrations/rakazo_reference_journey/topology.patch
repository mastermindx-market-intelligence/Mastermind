+// Derived attempt-owned runner. These bytes are not an unchanged upstream run.
+const DONOR_APP_IMAGE = "rakazo/app:topology";
+const DONOR_COMPUTER_IMAGE = "rakazo/computer:topology";
+const SHARED_DOCKER_SOCKET = "/var/run/docker.sock";
+
+type Attempt = {
+  project: string;
+  overrideFile: string;
+  appImage: string;
+  computerImage: string;
+  evidencePath: string;
+  dockerHost: string;
+  dockerSocket: string;
+  ownedRoot: string;
+};
+
+function attemptManifestPath(): string {
+  const index = process.argv.indexOf("--mmx-attempt");
+  const manifestPath = index >= 0 ? process.argv[index + 1] : undefined;
+  if (!manifestPath || manifestPath.startsWith("-")) {
+    throw new Error("derived topology runner requires --mmx-attempt <owned-manifest>");
+  }
+  return manifestPath;
+}
+
+function requireOwned(value: string, ownedRoot: string, label: string): string {
+  const parts = value.split("/");
+  if (!value.startsWith(`${ownedRoot}/`) || value.includes("\0") || parts.includes("..")) {
+    throw new Error(`${label} is outside the owned attempt root`);
+  }
+  return value;
+}
+
+function loadAttempt(): Attempt {
+  if (process.argv.includes("--keep")) {
+    throw new Error("derived topology runner refuses --keep");
+  }
+  const raw = JSON.parse(readFileSync(attemptManifestPath(), "utf8")) as Record<string, unknown>;
+  const ownedRoot = raw.owned_root;
+  const project = raw.project;
+  const overrideFile = raw.override_file;
+  const appImage = raw.app_image;
+  const computerImage = raw.computer_image;
+  const evidencePath = raw.evidence_path;
+  const dockerHost = raw.docker_host;
+  const dockerSocket = raw.docker_socket;
+  if (
+    typeof ownedRoot !== "string" ||
+    typeof project !== "string" ||
+    typeof overrideFile !== "string" ||
+    typeof appImage !== "string" ||
+    typeof computerImage !== "string" ||
+    typeof evidencePath !== "string" ||
+    typeof dockerHost !== "string" ||
+    typeof dockerSocket !== "string"
+  ) {
+    throw new Error("attempt manifest is incomplete");
+  }
+  if (!/^mmx-rakazo-journey-[0-9a-f]{32}$/.test(project)) {
+    throw new Error("attempt project is not owned");
+  }
+  if (
+    appImage === DONOR_APP_IMAGE ||
+    computerImage === DONOR_COMPUTER_IMAGE ||
+    appImage.startsWith("rakazo/") ||
+    computerImage.startsWith("rakazo/")
+  ) {
+    throw new Error("refusing donor shared topology image tags");
+  }
+  if (
+    dockerSocket === SHARED_DOCKER_SOCKET ||
+    dockerHost === `unix://${SHARED_DOCKER_SOCKET}` ||
+    dockerHost.startsWith("tcp:") ||
+    dockerHost.startsWith("ssh:") ||
+    dockerHost.startsWith("http:")
+  ) {
+    throw new Error("refusing unqualified docker daemon");
+  }
+  requireOwned(overrideFile, ownedRoot, "override");
+  requireOwned(evidencePath, ownedRoot, "evidence");
+  requireOwned(dockerSocket, ownedRoot, "docker socket");
+  return {
+    project,
+    overrideFile,
+    appImage,
+    computerImage,
+    evidencePath,
+    dockerHost,
+    dockerSocket,
+    ownedRoot,
+  };
+}
+
+const attempt = loadAttempt();
