+    assert.equal(parent.thread.projectId, projectAId);
+  }).pipe(Effect.provide(Layer.mergeAll(layerTest, layerReactor))),
+);
+
+it.effect("refuses a raw cross-project command without a strict worktree strategy", () =>
+  Effect.gen(function* () {
