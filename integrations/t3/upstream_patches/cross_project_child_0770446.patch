+import { assert, it } from "@effect/vitest";
+import {
+  type ApplicationProjectEvent,
+  CommandId,
+  EventId,
+  MessageId,
+  NodeId,
+  type OrchestrationV2Command,
+  type OrchestrationV2DomainEvent,
+  ProjectId,
+  ProviderDriverKind,
+  ProviderInstanceId,
+  type ProviderInteractionMode,
+  RuntimeRequestId,
+  type RuntimeMode,
+  ThreadId,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+
+import * as SqlitePersistence from "../persistence/Sqlite.ts";
+import * as ServerSettings from "../serverSettings.ts";
+import { CodexProviderCapabilitiesV2 } from "./Adapters/CodexAdapterV2.ts";
+import * as CommandReceiptStore from "./CommandReceiptStore.ts";
+import {
+  DelegatedTaskQuestionReactor,
+  layer as layerQuestionReactor,
+} from "./DelegatedTaskQuestionReactor.ts";
+import * as EffectOutbox from "./EffectOutbox.ts";
+import * as EventStore from "./EventStore.ts";
+import * as Orchestrator from "./Orchestrator.ts";
+import * as ProjectionStore from "./ProjectionStore.ts";
+import * as ProjectStore from "./ProjectStore.ts";
+import * as ProviderAdapterRegistry from "./ProviderAdapterRegistry.ts";
+import * as ThreadManagementService from "./ThreadManagementService.ts";
+import * as ProviderReplayHarness from "./testkit/ProviderReplayHarness.ts";
+import type * as ProviderAdapter from "@t3tools/provider-core/server/ProviderAdapter";
+
+const instanceId = ProviderInstanceId.make("codex");
+const modelSelection = { instanceId, model: "gpt-5.1-codex" };
+const adapter = {
+  instanceId,
+  driver: ProviderDriverKind.make("codex"),
+  getCapabilities: () => Effect.succeed(CodexProviderCapabilitiesV2),
+  planSelectionTransition: () => Effect.succeed({ type: "apply_on_next_turn" as const }),
+  openSession: () => Effect.die("Runs here never reach a provider"),
+} as ProviderAdapter.ProviderAdapterV2["Service"];
+const projectAId = ProjectId.make("project:cross-project-a");
+const projectBId = ProjectId.make("project:cross-project-b");
+const layerDatabase = SqlitePersistence.layerMemory;
+const layerHarness = ProviderReplayHarness.layerWithRegistry(
+  { name: "cross-project-delegation" },
+  ProviderAdapterRegistry.layerFromAdapters([adapter]),
+  { databaseLayer: layerDatabase, runEffectWorker: false },
+);
+const layerCore = Layer.mergeAll(
+  layerDatabase,
+  ProjectionStore.layer.pipe(Layer.provide(layerDatabase)),
+  EventStore.layer.pipe(Layer.provide(layerDatabase)),
+  EffectOutbox.layer.pipe(Layer.provide(layerDatabase)),
+  // A separate store instance over the same database the harness's
+  // orchestrator reads, so tests can seed project rows.
+  ProjectStore.layer.pipe(Layer.provide(layerDatabase)),
+  layerHarness,
+);
+const layerTest = ThreadManagementService.layer.pipe(
+  Layer.provideMerge(layerCore),
+  Layer.provideMerge(ServerSettings.layerTest()),
+  Layer.provideMerge(CommandReceiptStore.layer.pipe(Layer.provide(layerDatabase))),
+);
+const layerReactor = layerQuestionReactor.pipe(Layer.provideMerge(layerCore));
+
+const createThread = (
+  threadId: ThreadId,
+  projectId: ProjectId,
+  modes: { runtimeMode?: RuntimeMode; interactionMode?: ProviderInteractionMode } = {},
+) =>
+  Effect.gen(function* () {
+    const orchestrator = yield* Orchestrator.OrchestratorV2;
+    yield* orchestrator.dispatch({
+      type: "thread.create",
+      commandId: CommandId.make(`create:${threadId}`),
+      threadId,
+      projectId,
+      title: threadId,
+      modelSelection,
+      runtimeMode: modes.runtimeMode ?? "full-access",
+      interactionMode: modes.interactionMode ?? "default",
+      branch: null,
+      worktreePath: null,
+      createdBy: "user",
+      creationSource: "web",
+    });
+  });
+
+const send = (threadId: ThreadId, text: string) =>
+  Effect.gen(function* () {
+    const orchestrator = yield* Orchestrator.OrchestratorV2;
+    yield* orchestrator.dispatch({
+      type: "message.dispatch",
+      commandId: CommandId.make(`send:${threadId}:${text}`),
+      threadId,
+      messageId: MessageId.make(`message:${threadId}:${text}`),
+      text,
+      attachments: [],
+      dispatchMode: { type: "start_immediately" },
+      createdBy: "user",
+      creationSource: "web",
+    });
+  });
+
+const seedProject = (projectId: ProjectId, title: string, archivedAt: string | null = null) =>
+  Effect.gen(function* () {
+    const projects = yield* ProjectStore.ProjectStoreV2;
+    const occurredAt = "2026-11-11T00:00:00.000Z";
+    const envelope = {
+      sequence: 1,
+      eventId: EventId.make(`event:${projectId}`),
+      aggregateKind: "project",
+      aggregateId: projectId,
+      occurredAt,
+      commandId: null,
+      causationEventId: null,
+      correlationId: null,
+      metadata: {},
+    };
+    yield* projects.apply({
+      ...envelope,
+      type: "project.created",
+      payload: {
+        projectId,
+        title,
+        workspaceRoot: `/repos/${title.toLowerCase().replace(/\s+/g, "-")}`,
+        defaultModelSelection: null,
+        scripts: [],
+        createdAt: occurredAt,
+        updatedAt: occurredAt,
+      },
+    } as ApplicationProjectEvent);
+    if (archivedAt !== null) {
+      yield* projects.apply({
+        ...envelope,
+        type: "project.meta-updated",
+        payload: { projectId, archivedAt, updatedAt: archivedAt },
+      } as ApplicationProjectEvent);
+    }
+  });
+
+const delegateCrossProject = (parentThreadId: ThreadId, task: string) =>
+  Effect.gen(function* () {
+    const threads = yield* ThreadManagementService.ThreadManagementService;
+    const orchestrator = yield* Orchestrator.OrchestratorV2;
+    // The MCP layer admits only registered projects, so the dispatch this
+    // helper models must find its target in the project store.
+    yield* seedProject(projectBId, "Cross Project B");
+    const parentRun = (yield* orchestrator.getThreadProjection(parentThreadId)).runs.at(-1)!;
+    yield* threads.dispatch({
+      type: "delegated_task.request",
+      commandId: CommandId.make(`delegate:${task}`),
+      parentThreadId,
+      parentRunId: parentRun.id,
+      parentNodeId: parentRun.rootNodeId!,
+      task,
+      modelSelection,
+      runtimeMode: "full-access",
+      interactionMode: "default",
+      completionWake: "always",
+      createdBy: "agent",
+      creationSource: "mcp",
+      projectId: projectBId,
+      workspaceStrategy: {
+        type: "worktree",
+        baseRef: "origin/main",
+        startFromOrigin: true,
+        requireRemoteBase: true,
+      },
+    } as Parameters<typeof threads.dispatch>[0]);
+    const projection = yield* orchestrator.getThreadProjection(parentThreadId);
+    return projection.subagents.find((candidate) => candidate.prompt === task)!.childThreadId!;
+  });
+
+it.effect("creates a cross-project child in the target project with a strict worktree", () =>
+  Effect.gen(function* () {
+    const orchestrator = yield* Orchestrator.OrchestratorV2;
+    const parentThreadId = ThreadId.make("thread:cross-project:create");
+    yield* createThread(parentThreadId, projectAId);
+    yield* send(parentThreadId, "Parent work");
+    const childThreadId = yield* delegateCrossProject(parentThreadId, "Work in project B.");
+
+    const parent = yield* orchestrator.getThreadProjection(parentThreadId);
+    const task = parent.subagents.find((candidate) => candidate.prompt === "Work in project B.")!;
+    assert.equal(task.origin, "app_owned");
+    assert.equal(task.threadId, parentThreadId);
+
+    const child = yield* orchestrator.getThreadProjection(childThreadId);
+    assert.equal(child.thread.projectId, projectBId);
+    assert.equal(child.thread.lineage.parentThreadId, parentThreadId);
+    assert.equal(child.thread.lineage.relationshipToParent, "subagent");
+    assert.equal(child.runs[0]?.status, "preparing");
+    assert.deepEqual(child.runs[0]?.workspacePreparation, {
+      type: "worktree",
+      baseRef: "origin/main",
+      startFromOrigin: true,
+      requireRemoteBase: true,
+    });
+  }).pipe(Effect.provide(layerTest)),
+);
+
+it.effect("replaying an accepted cross-project request creates no second child", () =>
+  Effect.gen(function* () {
+    const orchestrator = yield* Orchestrator.OrchestratorV2;
+    const parentThreadId = ThreadId.make("thread:cross-project:replay");
+    yield* createThread(parentThreadId, projectAId);
+    yield* send(parentThreadId, "Parent work");
+    const first = yield* delegateCrossProject(parentThreadId, "Replayed task.");
+    const second = yield* delegateCrossProject(parentThreadId, "Replayed task.");
+    assert.equal(second, first);
+    const parent = yield* orchestrator.getThreadProjection(parentThreadId);
+    assert.lengthOf(parent.subagents, 1);
+  }).pipe(Effect.provide(layerTest)),
+);
+
+it.effect("cancelling the task stops the cross-project child", () =>
+  Effect.gen(function* () {
+    const orchestrator = yield* Orchestrator.OrchestratorV2;
+    const parentThreadId = ThreadId.make("thread:cross-project:cancel");
+    yield* createThread(parentThreadId, projectAId);
+    yield* send(parentThreadId, "Parent work");
+    const childThreadId = yield* delegateCrossProject(parentThreadId, "Cancelled task.");
+    const parentBefore = yield* orchestrator.getThreadProjection(parentThreadId);
+    const task = parentBefore.subagents[0]!;
+
+    yield* orchestrator.dispatch({
+      type: "thread.stop",
+      commandId: CommandId.make(`stop-child:${parentThreadId}`),
+      threadId: childThreadId,
+    });
+    // An interrupted delegated child settles its parent task through
+    // recovery, the same path a server restart takes.
+    yield* orchestrator.recoverDelegatedTasks;
+
+    const child = yield* orchestrator.getThreadProjection(childThreadId);
+    assert.equal(child.runs[0]?.status, "interrupted");
+    assert.equal(child.thread.projectId, projectBId);
+    const parent = yield* orchestrator.getThreadProjection(parentThreadId);
+    assert.equal(
+      parent.subagents.find((candidate) => candidate.id === task.id)?.status,
+      "interrupted",
+    );
+  }).pipe(Effect.provide(layerTest)),
+);
+
+it.effect("a question from the cross-project child wakes the parent", () =>
+  Effect.gen(function* () {
+    const orchestrator = yield* Orchestrator.OrchestratorV2;
+    const reactor = yield* DelegatedTaskQuestionReactor;
+    const projections = yield* ProjectionStore.ProjectionStoreV2;
+    const parentThreadId = ThreadId.make("thread:cross-project:question");
+    yield* createThread(parentThreadId, projectAId);
+    yield* send(parentThreadId, "Parent work");
+    const childThreadId = yield* delegateCrossProject(parentThreadId, "Questioning task.");
+
+    const now = yield* DateTime.now;
+    const requestPayload = {
+      id: RuntimeRequestId.make("request:cross-project-question"),
+      nodeId: NodeId.make("node:cross-project-question"),
+      providerTurnId: null,
+      nativeRequestRef: null,
+      kind: "user_input",
+      status: "pending",
+      responseCapability: { type: "message" },
+      createdAt: now,
+      resolvedAt: null,
+    } as const;
+    const requestEvent = {
+      id: EventId.make("event:cross-project-question"),
+      type: "runtime-request.updated",
+      threadId: childThreadId,
+      runId: null,
+      nodeId: null,
+      driver: adapter.driver,
+      providerInstanceId: instanceId,
+      occurredAt: now,
+      payload: requestPayload,
+    } as unknown as OrchestrationV2DomainEvent;
+    yield* projections.apply(requestEvent);
+    yield* reactor.handle(requestEvent);
+
+    const parent = yield* orchestrator.getThreadProjection(parentThreadId);
+    const wake = parent.messages.find(
+      (message) =>
+        message.text.includes("Delegated task") && message.text.includes(requestPayload.id),
+    );
+    assert.isDefined(wake);
+    assert.include(wake!.text, `threadId ${childThreadId}`);
