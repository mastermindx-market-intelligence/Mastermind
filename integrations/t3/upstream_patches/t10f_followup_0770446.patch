+      current.restartContinuationOfRunId === undefined
+        ? undefined
+        : runs.find((candidate) => candidate.id === current.restartContinuationOfRunId);
+    if (previous === undefined || visited.has(previous.id)) return current;
+    visited.add(previous.id);
+    current = previous;
+  }
