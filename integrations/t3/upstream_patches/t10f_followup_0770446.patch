+/**
+ * A one-shot store fault, armed by the test: when a statement matching `matches` runs, the next
+ * top-level SELECT fails once with a retryable connection error, like a transient locked database.
+ */
+type SqlFault = {
+  armed: boolean;
+  latched: boolean;
+  failed: boolean;
+  readonly matches: (text: string, values: ReadonlyArray<unknown>) => boolean;
+};
+
+const interceptSql = (base: SqlClient.SqlClient, fault: SqlFault): SqlClient.SqlClient =>
+  Object.assign(
+    (strings: TemplateStringsArray, ...values: unknown[]) => {
+      const text = strings.join(" ");
+      if (!fault.failed && fault.armed) {
+        if (!fault.latched && fault.matches(text, values)) {
+          fault.latched = true;
+        } else if (fault.latched && text.trimStart().startsWith("SELECT")) {
+          fault.failed = true;
+          return new SqlError.SqlError({
+            reason: new SqlError.ConnectionError({
+              cause: new Error("injected transient store fault"),
+              message: "injected transient store fault",
+            }),
+          });
+        }
+      }
+      return (base as unknown as (strings: TemplateStringsArray, ...values: unknown[]) => unknown)(
+        strings,
+        ...values,
+      );
+    },
+    base,
+  ) as unknown as SqlClient.SqlClient;
+
+const flakyMemoryDatabase = (fault: SqlFault) =>
+  Layer.effect(SqlClient.SqlClient, Effect.map(SqlClient.SqlClient, (base) => interceptSql(base, fault)))
+    .pipe(Layer.provide(SqlitePersistence.layerMemory));
