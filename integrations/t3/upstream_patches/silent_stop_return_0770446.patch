+/**
+ * The newest run in the chain that resumed `source` after restarts, or `source` itself. A run
+ * the provider started and a restart then cancelled is that chain's head.
+ */
+export function latestRestartContinuation<
+  R extends Pick<OrchestrationV2Run, "id" | "restartContinuationOfRunId">,
+>(source: R, runs: ReadonlyArray<R>): R {
+  let current = source;
+  const visited = new Set([current.id]);
+  for (;;) {
+    const next = runs.find((candidate) => candidate.restartContinuationOfRunId === current.id);
+    if (next === undefined || visited.has(next.id)) return current;
+    visited.add(next.id);
+    current = next;
+  }
+}
