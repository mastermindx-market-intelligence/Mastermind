+++ b/apps/server/src/mastermind/MastermindAdmissionAdapter.test.ts
@@ -0,0 +1,434 @@
+import type { CommandId, ProjectId, RunId, ThreadId } from "@t3tools/contracts";
+import { describe, expect, it } from "@effect/vitest";
+import * as Cause from "effect/Cause";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Layer from "effect/Layer";
+
+import * as EffectWorker from "../orchestration-v2/EffectWorker.ts";
+import * as EffectOutbox from "../orchestration-v2/EffectOutbox.ts";
+import * as ThreadLaunch from "../orchestration-v2/ThreadLaunchService.ts";
+import {
+  MastermindAdmissionBlockedError,
+  MastermindAdmissionService,
+  decorateOrchestrationEffectExecutor,
+  decorateThreadLaunch,
+  makeMastermindAdmissionService,
+  readMastermindAdmissionConfig,
+} from "./MastermindAdmissionAdapter.ts";
+
+// ---------------------------------------------------------------------------
+// Fixtures
+// ---------------------------------------------------------------------------
+
+const threadId = "thread-admission-test" as ThreadId;
+const runId = "run-admission-test" as RunId;
+const commandId = "command-admission-test" as CommandId;
+const projectId = "project-admission-test" as ProjectId;
+
+const jsonResponse = (body: Record<string, unknown>): Response =>
+  new Response(JSON.stringify(body), {
+    status: 200,
+    headers: { "content-type": "application/json" },
+  });
+
+/** A fetch double that records every consult and replays a decision list. */
+const recordingFetch = (decisions: Array<Record<string, unknown>>) => {
+  const consulted: Array<Record<string, unknown>> = [];
+  const fetchImpl: typeof fetch = (async (_input: unknown, init?: RequestInit) => {
+    consulted.push(JSON.parse(String(init?.body)) as Record<string, unknown>);
+    const decision = decisions[Math.min(consulted.length - 1, decisions.length - 1)]!;
+    return jsonResponse(decision);
+  }) as typeof fetch;
+  return { fetchImpl, consulted };
+};
+
+const admittedService = () =>
+  makeMastermindAdmissionService(
+    { mode: "enforce", endpoint: "http://admission.test", rootRef: undefined },
+    { fetchImpl: recordingFetch([{ decision: "admitted", rootRef: "root-1" }]).fetchImpl },
+  );
+
+const alwaysBlockedService = () => {
+  const { fetchImpl, consulted } = recordingFetch([
+    { decision: "blocked_with_reason", reason: "stale lease: mastermind session lost" },
+  ]);
+  return {
+    service: makeMastermindAdmissionService(
+      { mode: "enforce", endpoint: "http://admission.test", rootRef: undefined },
+      { fetchImpl },
+    ),
+    consulted,
+  };
+};
+
+const threadLaunchIncumbent = (calls: string[]) =>
+  ({
+    launch: (request: ThreadLaunch.ThreadLaunchInput) =>
+      Effect.sync(() => {
+        calls.push(`launch:${request.commandId}`);
+        return { threadId, projection: {}, resumed: false } as never;
+      }),
+    checkWorktreeBase: () => Effect.void,
+    retryPreparation: () => Effect.void,
+    prepareRun: () => Effect.void,
+  }) as unknown as ThreadLaunch.ThreadLaunchService["Service"];
+
+const effect = (
+  type: "provider-turn.start" | "provider-turn.restart" | "provider-turn.interrupt" | "provider-turn.steer",
+): EffectOutbox.OrchestrationEffectV2 =>
+  ({
+    id: `effect-${type}`,
+    commandId,
+    threadId,
+    status: "pending",
+    attemptCount: 0,
+    availableAt: "1970-01-01T00:00:00.000Z",
+    leaseOwner: null,
+    createdAt: "1970-01-01T00:00:00.000Z",
+    updatedAt: "1970-01-01T00:00:00.000Z",
+    request:
+      type === "provider-turn.start"
+        ? { type, runId }
+        : type === "provider-turn.restart"
+          ? {
+              type,
+              runId,
+              providerSessionId: "s",
+              providerThreadId: "pt",
+              providerTurnId: "pu",
+              interruptedAttemptId: "a",
+            }
+          : type === "provider-turn.steer"
+            ? { type, providerSessionId: "s", providerThreadId: "pt", providerTurnId: "pu", messageId: "m" }
+            : { type, providerSessionId: "s", providerThreadId: "pt", providerTurnId: "pu" },
+  }) as EffectOutbox.OrchestrationEffectV2;
+
+const executorIncumbent = (calls: string[]) =>
+  ({
+    execute: (e: EffectOutbox.OrchestrationEffectV2) =>
+      Effect.sync(() => {
+        calls.push(e.request.type);
+      }),
+  }) as unknown as EffectWorker.OrchestrationEffectExecutorV2Shape;
+
+// ---------------------------------------------------------------------------
+// 1. Disabled mode is a pure passthrough
+// ---------------------------------------------------------------------------
+
+describe("MastermindAdmissionAdapter disabled mode", () => {
+  it.effect("unset endpoint configures disabled mode", () =>
+    Effect.gen(function* () {
+      const config = readMastermindAdmissionConfig({});
+      expect(config.mode).toBe("disabled");
+      expect(config.endpoint).toBeUndefined();
+      expect(readMastermindAdmissionConfig({ MASTERMIND_ADMISSION_ENDPOINT: " " }).mode).toBe(
+        "disabled",
+      );
+      expect(
+        readMastermindAdmissionConfig({ MASTERMIND_ADMISSION_ENDPOINT: "http://x" }).mode,
+      ).toBe("enforce");
+    }),
+  );
+
+  it.effect("admitLaunch never consults any endpoint and passes through", () =>
+    Effect.gen(function* () {
+      let consulted = 0;
+      const service = makeMastermindAdmissionService(
+        readMastermindAdmissionConfig({}),
+        {
+          fetchImpl: (async () => {
+            consulted += 1;
+            throw new Error("must not be consulted in disabled mode");
+          }) as typeof fetch,
+        },
+      );
+      const decision = yield* service.admitLaunch({ projectId, commandId, creationSource: "test" });
+      expect(decision).toEqual({ type: "passthrough" });
+      expect(consulted).toBe(0);
+      expect(yield* service.revalidateExecution({ threadId, runId, phase: "launch" })).toEqual({
+        type: "passthrough",
+      });
+    }),
+  );
+
+  it.effect("decorators return the incumbent service instance unchanged", () =>
+    Effect.gen(function* () {
+      const incumbent = threadLaunchIncumbent([]);
+      const executor = executorIncumbent([]);
+      const admission = Layer.succeed(
+        MastermindAdmissionService,
+        makeMastermindAdmissionService(readMastermindAdmissionConfig({})),
+      );
+      const decoratedLaunch = yield* Layer.build(
+        decorateThreadLaunch(Layer.succeed(ThreadLaunch.ThreadLaunchService, incumbent)).pipe(
+          Layer.provideMerge(admission),
+        ),
+      );
+      // Bit-for-bit passthrough: with admission disabled the decorator hands
+      // back the incumbent service object itself.
+      expect(Context.get(decoratedLaunch, ThreadLaunch.ThreadLaunchService)).toBe(incumbent);
+      const decoratedExecutor = yield* Layer.build(
+        decorateOrchestrationEffectExecutor(
+          Layer.succeed(EffectWorker.OrchestrationEffectExecutorV2, executor as never),
+        ).pipe(Layer.provideMerge(admission)),
+      );
+      expect(Context.get(decoratedExecutor, EffectWorker.OrchestrationEffectExecutorV2)).toBe(
+        executor,
+      );
+    }),
+  );
+});
+
+// ---------------------------------------------------------------------------
+// 1b. Composition: a decorated incumbent and the undecorated graph share
+//     every dependency, built EXACTLY ONCE (no nested Layer.build fork).
+// ---------------------------------------------------------------------------
+
+describe("MastermindAdmissionAdapter composition", () => {
+  // A shared singleton dependency standing in for ProjectionStore /
+  // CommandOutputHub / Orchestrator / TextGeneration in runtimeLayer.ts.
+  class SharedStore extends Context.Service<SharedStore, { readonly instance: number }>()(
+    "t3/mastermind/MastermindAdmissionAdapter.test/SharedStore",
+  ) {}
+  // An undecorated sibling service that consumes the same shared store.
+  class Sibling extends Context.Service<Sibling, { readonly store: number }>()(
+    "t3/mastermind/MastermindAdmissionAdapter.test/Sibling",
+  ) {}
+
+  const graph = (
+    mode: "disabled" | "enforce",
+    order: "decorated-first" | "undecorated-first",
+  ) => {
+    const counts = { sharedStore: 0, incumbent: 0 };
+    const sharedStoreLayer = Layer.effect(
+      SharedStore,
+      Effect.sync(() => {
+        counts.sharedStore += 1;
+        return { instance: counts.sharedStore };
+      }),
+    );
+    const incumbent = threadLaunchIncumbent([]);
+    const incumbentLayer = Layer.effect(
+      ThreadLaunch.ThreadLaunchService,
+      Effect.gen(function* () {
+        yield* SharedStore;
+        counts.incumbent += 1;
+        return incumbent;
+      }),
+    ).pipe(Layer.provide(sharedStoreLayer));
+    const siblingLayer = Layer.effect(
+      Sibling,
+      Effect.gen(function* () {
+        const store = yield* SharedStore;
+        return { store: store.instance };
+      }),
+    ).pipe(Layer.provide(sharedStoreLayer));
+    const admission = Layer.succeed(
+      MastermindAdmissionService,
+      mode === "disabled"
+        ? makeMastermindAdmissionService(readMastermindAdmissionConfig({}))
+        : admittedService(),
+    );
+    const decorated = decorateThreadLaunch(incumbentLayer).pipe(Layer.provide(admission));
+    const merged =
+      order === "decorated-first"
+        ? Layer.mergeAll(decorated, siblingLayer)
+        : Layer.mergeAll(siblingLayer, decorated);
+    return { counts, incumbent, merged };
+  };
+
+  for (const mode of ["disabled", "enforce"] as const) {
+    for (const order of ["decorated-first", "undecorated-first"] as const) {
+      it.effect(`shared dependency is built exactly once (${mode}, ${order})`, () =>
+        Effect.gen(function* () {
+          const { counts, incumbent, merged } = graph(mode, order);
+          const services = yield* Layer.build(merged);
+          // One shared singleton for the whole graph; the decorated incumbent
+          // and the undecorated sibling see the SAME instance.
+          expect(counts.sharedStore).toBe(1);
+          expect(counts.incumbent).toBe(1);
+          expect(Context.get(services, Sibling).store).toBe(1);
+          const launch = Context.get(services, ThreadLaunch.ThreadLaunchService);
+          if (mode === "disabled") {
+            // Pure passthrough at composition level, not just per instance.
+            expect(launch).toBe(incumbent);
+          } else {
+            expect(launch).not.toBe(incumbent);
+          }
+        }),
+      );
+    }
+  }
+});
+
+// ---------------------------------------------------------------------------
+// 2. A blocked launch surfaces the typed cause
+// ---------------------------------------------------------------------------
+
+describe("MastermindAdmissionAdapter blocked launch", () => {
+  it.effect("launch fails with ThreadLaunchError carrying the blocked cause", () =>
+    Effect.gen(function* () {
+      const calls: string[] = [];
+      const { service, consulted } = alwaysBlockedService();
+      const admission = Layer.succeed(MastermindAdmissionService, service);
+      const decorated = yield* Layer.build(
+        decorateThreadLaunch(
+          Layer.succeed(ThreadLaunch.ThreadLaunchService, threadLaunchIncumbent(calls)),
+        ).pipe(Layer.provideMerge(admission)),
+      );
+      const launch = Context.get(decorated, ThreadLaunch.ThreadLaunchService).launch;
+      const exit = yield* Effect.exit(
+        launch({
+          commandId,
+          projectId,
+          title: "t",
+          generateTitle: false,
+        } as never as ThreadLaunch.ThreadLaunchInput),
+      );
+      expect(Exit.isFailure(exit)).toBe(true);
+      if (Exit.isFailure(exit)) {
+        const failure = Cause.squash(exit.cause);
+        expect(failure).toBeInstanceOf(ThreadLaunch.ThreadLaunchError);
+        const cause = (failure as unknown as { cause: unknown }).cause;
+        expect(cause).toBeInstanceOf(MastermindAdmissionBlockedError);
+        expect((cause as MastermindAdmissionBlockedError).reason).toContain("stale lease");
+        expect((cause as MastermindAdmissionBlockedError).phase).toBe("launch");
+      }
+      // Blocked BEFORE any preparation effect: the incumbent never launched.
+      expect(calls).toEqual([]);
+      expect(consulted.length).toBe(1);
+    }),
+  );
+
+  it.effect("an admitted launch proceeds and binds the thread in the ledger", () =>
+    Effect.gen(function* () {
+      const calls: string[] = [];
+      const admission = Layer.succeed(MastermindAdmissionService, admittedService());
+      const service = Context.get(
+        yield* Layer.build(admission),
+        MastermindAdmissionService,
+      );
+      const decorated = yield* Layer.build(
+        decorateThreadLaunch(
+          Layer.succeed(ThreadLaunch.ThreadLaunchService, threadLaunchIncumbent(calls)),
+        ).pipe(Layer.provideMerge(admission)),
+      );
+      const result = yield* Context.get(decorated, ThreadLaunch.ThreadLaunchService).launch({
+        commandId,
+        projectId,
+        title: "t",
+      } as never as ThreadLaunch.ThreadLaunchInput);
+      expect((result as { threadId: ThreadId }).threadId).toBe(threadId);
+      expect(calls).toEqual([`launch:${commandId}`]);
+      const snapshot = yield* service.ledgerSnapshot;
+      expect(snapshot.at(-1)?.threadId).toBe(threadId);
+      expect(snapshot.at(-1)?.rootRef).toBe("root-1");
+    }),
+  );
+});
+
+// ---------------------------------------------------------------------------
+// 3. Stale lease blocks start/restart but NEVER interrupt (cancel)
+// ---------------------------------------------------------------------------
+
+describe("MastermindAdmissionAdapter stale-lease fence", () => {
+  const staleLeaseExecutor = () => {
+    const calls: string[] = [];
+    const { service, consulted } = alwaysBlockedService();
+    const admission = Layer.succeed(MastermindAdmissionService, service);
+    return { calls, consulted, admission };
+  };
+
+  it.effect("provider-turn.start is blocked with the typed admission cause", () =>
+    Effect.gen(function* () {
+      const { calls, consulted, admission } = staleLeaseExecutor();
+      const decorated = yield* Layer.build(
+        decorateOrchestrationEffectExecutor(
+          Layer.succeed(
+            EffectWorker.OrchestrationEffectExecutorV2,
+            executorIncumbent(calls) as never,
+          ),
+        ).pipe(Layer.provideMerge(admission)),
+      );
+      const exit = yield* Effect.exit(
+        Context.get(decorated, EffectWorker.OrchestrationEffectExecutorV2).execute(
+          effect("provider-turn.start"),
+        ),
+      );
+      expect(Exit.isFailure(exit)).toBe(true);
+      if (Exit.isFailure(exit)) {
+        const failure = Cause.squash(exit.cause);
+        expect(failure).toBeInstanceOf(EffectWorker.OrchestrationEffectExecutionError);
+        const cause = (failure as unknown as { cause: unknown }).cause;
+        expect(cause).toBeInstanceOf(MastermindAdmissionBlockedError);
+        expect((cause as MastermindAdmissionBlockedError).reason).toContain("stale lease");
+      }
+      expect(calls).toEqual([]);
+      expect(consulted.length).toBe(1);
+    }),
+  );
+
+  it.effect("provider-turn.restart is blocked before the upstream interrupt runs", () =>
+    Effect.gen(function* () {
+      const { calls, admission } = staleLeaseExecutor();
+      const decorated = yield* Layer.build(
+        decorateOrchestrationEffectExecutor(
+          Layer.succeed(
+            EffectWorker.OrchestrationEffectExecutorV2,
+            executorIncumbent(calls) as never,
+          ),
+        ).pipe(Layer.provideMerge(admission)),
+      );
+      const exit = yield* Effect.exit(
+        Context.get(decorated, EffectWorker.OrchestrationEffectExecutorV2).execute(
+          effect("provider-turn.restart"),
+        ),
+      );
+      expect(Exit.isFailure(exit)).toBe(true);
+      // The whole compound restart effect failed: the original turn was never
+      // interrupted by a stale-lease holder.
+      expect(calls).toEqual([]);
+    }),
+  );
+
+  it.effect("interrupt is never decorated: proceeds while the lease is stale", () =>
+    Effect.gen(function* () {
+      const { calls, consulted, admission } = staleLeaseExecutor();
+      const decorated = yield* Layer.build(
+        decorateOrchestrationEffectExecutor(
+          Layer.succeed(
+            EffectWorker.OrchestrationEffectExecutorV2,
+            executorIncumbent(calls) as never,
+          ),
+        ).pipe(Layer.provideMerge(admission)),
+      );
+      yield* Context.get(decorated, EffectWorker.OrchestrationEffectExecutorV2).execute(
+        effect("provider-turn.interrupt"),
+      );
+      expect(calls).toEqual(["provider-turn.interrupt"]);
+      // Admission was never even consulted for an interrupt.
+      expect(consulted.length).toBe(0);
+    }),
+  );
+
+  it.effect("steer records the stale lease but still proceeds", () =>
+    Effect.gen(function* () {
+      const { calls, consulted, admission } = staleLeaseExecutor();
+      const decorated = yield* Layer.build(
+        decorateOrchestrationEffectExecutor(
+          Layer.succeed(
+            EffectWorker.OrchestrationEffectExecutorV2,
+            executorIncumbent(calls) as never,
+          ),
+        ).pipe(Layer.provideMerge(admission)),
+      );
+      yield* Context.get(decorated, EffectWorker.OrchestrationEffectExecutorV2).execute(
+        effect("provider-turn.steer"),
+      );
+      expect(calls).toEqual(["provider-turn.steer"]);
+      expect(consulted.length).toBe(1);
+    }),
+  );
+});
