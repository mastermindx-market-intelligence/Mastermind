@@ -0,0 +1,704 @@
+/**
+ * Mastermind pinned admission patch - donor: github.com/pingdotgg/t3code @0770446869d247a8b28c27d7ed93f47f8ff0c1e4
+ *
+ * MastermindAdmissionAdapter adapts T3 Code's own Effect-TS Context.Service /
+ * Layer system into an admission gate for Mastermind. That system is the ONLY
+ * supported extension mechanism upstream exposes (apps/server/src has no
+ * plugin/middleware/extension registry), so every seam below is a decorator
+ * Layer around an incumbent `export const layer` — the incumbent layers and all
+ * upstream service logic are left untouched.
+ *
+ * Inert by default: with MASTERMIND_ADMISSION_ENDPOINT unset (the upstream
+ * default), `mode` is "disabled" and every decorator returns the incumbent
+ * service unchanged, so upstream behavior is bit-for-bit identical without
+ * Mastermind. Authority cannot be minted by prompt text, request fields, or any
+ * process environment variable other than the operator-configured root ref:
+ * MASTERMIND_ADMISSION_ROOT_REF. Manual UI launches are admitted as ordinary
+ * interactive roots within the existing grant — there is no per-prompt
+ * admission ceremony.
+ *
+ * Decorator seams (composed in `orchestration-v2/runtimeLayer.ts`):
+ *   a. ThreadLaunchService (launch): decide admission BEFORE the first
+ *      preparation effect of the single funnel for all thread creation, then
+ *      bind the admitted root/binding onto the launched thread.
+ *   b. ThreadManagementService (dispatch): propagate the existing root/binding
+ *      through messages, delegation, and prepared-run release/retry. Propagate
+ *      only — dispatch is never re-decided here.
+ *   c. OrchestrationEffectExecutorV2 (execute): revalidate the current
+ *      attempt/placement/fence immediately before provider-turn start, steer,
+ *      and restart effects. A stale lease blocks NEW EXECUTION ONLY (start and
+ *      restart-into-replacement); interrupt/cancel effects are never
+ *      decorated, so a stale lease can never interrupt or cancel work. Steer
+ *      revalidation records but never blocks (steer delivers into an existing
+ *      turn). Upstream restart lifecycle is preserved: when admitted, restart
+ *      still interrupts the original turn before starting the replacement.
+ *   d. ProviderTurnStartService (start) + ProviderSessionManagerV2 (open):
+ *      revalidate placement + fence immediately before the native
+ *      process/session binding — defense in depth for every caller of these
+ *      services, which also spawn the ACP agent process at open.
+ *   e. ThreadTitleRegenerationService (execute): accounted helper-route record
+ *      for the app-owned helper-model call (title generation). Accounting
+ *      only — no upstream behavior change. ThreadPullRequestService performs
+ *      no helper-model calls at this pin, so nothing is accounted there.
+ *   f. Native child spawns are covered by (b) + (c): every delegate/child
+ *      command flows through dispatch and provider-turn effects. Orchestrator.ts
+ *      is deliberately NOT patched.
+ *
+ * Wire protocol (consulted only when MASTERMIND_ADMISSION_ENDPOINT is set):
+ *   POST {endpoint}/v1/admit  {"kind":"launch"|"revalidate", ...}
+ *   -> {"decision":"admitted","rootRef"?,"admissionId"?,"grantedAt"?}
+ *      {"decision":"blocked_with_reason","reason":"..."}
+ *      {"decision":"passthrough"}
+ * An unreachable endpoint or malformed payload fails closed (blocks), which —
+ * by the stale-lease rule — can only block new execution, never interrupts.
+ */
+import type { CommandId, ProjectId, RunId, ThreadId } from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Predicate from "effect/Predicate";
+import * as Schema from "effect/Schema";
+
+import * as EffectWorker from "../orchestration-v2/EffectWorker.ts";
+import * as ProviderSessionManager from "../orchestration-v2/ProviderSessionManager.ts";
+import * as ProviderTurnStartService from "../orchestration-v2/ProviderTurnStartService.ts";
+import * as ThreadLaunch from "../orchestration-v2/ThreadLaunchService.ts";
+import * as ThreadManagement from "../orchestration-v2/ThreadManagementService.ts";
+import * as ThreadTitleRegenerationService from "../orchestration-v2/ThreadTitleRegenerationService.ts";
+
+// ---------------------------------------------------------------------------
+// Configuration (env-driven; unset = disabled = pure passthrough)
+// ---------------------------------------------------------------------------
+
+export const MASTERMIND_ADMISSION_ENDPOINT_ENV = "MASTERMIND_ADMISSION_ENDPOINT";
+export const MASTERMIND_ADMISSION_ROOT_REF_ENV = "MASTERMIND_ADMISSION_ROOT_REF";
+
+export interface MastermindAdmissionConfig {
+  /** "disabled" = pure passthrough (upstream default); "enforce" consults the endpoint. */
+  readonly mode: "disabled" | "enforce";
+  readonly endpoint: string | undefined;
+  readonly rootRef: string | undefined;
+}
+
+export const readMastermindAdmissionConfig = (
+  env: Record<string, string | undefined> = process.env,
+): MastermindAdmissionConfig => {
+  const endpoint = env[MASTERMIND_ADMISSION_ENDPOINT_ENV]?.trim();
+  const rootRef = env[MASTERMIND_ADMISSION_ROOT_REF_ENV]?.trim();
+  return {
+    mode: endpoint === undefined || endpoint === "" ? "disabled" : "enforce",
+    endpoint: endpoint === undefined || endpoint === "" ? undefined : endpoint,
+    rootRef: rootRef === undefined || rootRef === "" ? undefined : rootRef,
+  };
+};
+
+// ---------------------------------------------------------------------------
+// Admission decision record
+// ---------------------------------------------------------------------------
+
+export type MastermindAdmissionPhase =
+  | "launch"
+  | "provider_turn_start"
+  | "provider_turn_restart"
+  | "provider_turn_steer"
+  | "provider_session_open";
+
+export interface MastermindAdmissionBinding {
+  readonly rootRef: string | undefined;
+  readonly admissionId: string | undefined;
+  readonly grantedAt: string | undefined;
+}
+
+/** admitted | blocked_with_reason | passthrough */
+export type MastermindAdmissionDecision =
+  | {
+      readonly type: "admitted";
+      readonly rootRef: string | undefined;
+      readonly binding: MastermindAdmissionBinding | undefined;
+    }
+  | { readonly type: "blocked_with_reason"; readonly reason: string }
+  | { readonly type: "passthrough" };
+
+/** One propagated binding per thread, bounded to keep runtime memory flat. */
+export const MAX_LEDGER_ENTRIES = 1024;
+
+export interface MastermindAdmissionLedgerEntry {
+  readonly threadId: ThreadId;
+  readonly commandId: CommandId;
+  readonly creationSource: string;
+  readonly rootRef: string | undefined;
+  readonly binding: MastermindAdmissionBinding | undefined;
+  readonly propagatedCommands: number;
+  readonly helperCalls: number;
+}
+
+// ---------------------------------------------------------------------------
+// Errors
+// ---------------------------------------------------------------------------
+
+export class MastermindAdmissionBlockedError extends Schema.TaggedError<MastermindAdmissionBlockedError>()(
+  "MastermindAdmissionBlockedError",
+  {
+    phase: Schema.String,
+    reason: Schema.String,
+  },
+) {
+  override get message(): string {
+    return `Mastermind admission blocked ${this.phase}: ${this.reason}`;
+  }
+}
+
+export class MastermindAdmissionEndpointError extends Schema.TaggedError<MastermindAdmissionEndpointError>()(
+  "MastermindAdmissionEndpointError",
+  {
+    endpoint: Schema.String,
+    phase: Schema.String,
+    cause: Schema.optional(Schema.Defect()),
+  },
+) {
+  override get message(): string {
+    return `Mastermind admission endpoint call failed during ${this.phase} (endpoint: ${this.endpoint}).`;
+  }
+}
+
+const admissionBlocked = (
+  reason: string,
+  phase: MastermindAdmissionPhase,
+): MastermindAdmissionBlockedError => new MastermindAdmissionBlockedError({ phase, reason });
+
+// ---------------------------------------------------------------------------
+// MastermindAdmissionService
+// ---------------------------------------------------------------------------
+
+export interface MastermindAdmissionServiceShape {
+  readonly config: MastermindAdmissionConfig;
+  /** Admission decision for the single thread-launch funnel. */
+  readonly admitLaunch: (input: {
+    readonly projectId: ProjectId;
+    readonly commandId: CommandId;
+    readonly creationSource: string;
+  }) => Effect.Effect<MastermindAdmissionDecision, MastermindAdmissionEndpointError>;
+  /** Revalidate the current attempt/placement/fence immediately before an effect. */
+  readonly revalidateExecution: (input: {
+    readonly threadId: ThreadId;
+    readonly runId: RunId | undefined;
+    readonly phase: MastermindAdmissionPhase;
+  }) => Effect.Effect<MastermindAdmissionDecision, MastermindAdmissionEndpointError>;
+  /** Bind an admitted launch's root/ref binding onto its created thread (ledger only). */
+  readonly bindThread: (input: {
+    readonly threadId: ThreadId;
+    readonly commandId: CommandId;
+    readonly creationSource: string;
+    readonly decision: Extract<MastermindAdmissionDecision, { readonly type: "admitted" }>;
+  }) => Effect.Effect<void>;
+  /** Propagate an existing binding through a dispatched command. Never blocks, never re-decides. */
+  readonly recordPropagation: (input: {
+    readonly threadId: ThreadId | undefined;
+    readonly runId: RunId | undefined;
+    readonly commandType: string;
+  }) => Effect.Effect<void>;
+  /** Account one app-owned helper-model call against the admission ledger (accounting only). */
+  readonly recordHelperRoute: (input: {
+    readonly threadId: ThreadId;
+    readonly route: "title_regeneration" | "pull_request";
+    readonly detail: string | undefined;
+  }) => Effect.Effect<void>;
+  readonly ledgerSnapshot: Effect.Effect<ReadonlyArray<MastermindAdmissionLedgerEntry>>;
+}
+
+export class MastermindAdmissionService extends Context.Service<
+  MastermindAdmissionService,
+  MastermindAdmissionServiceShape
+>()("t3/mastermind/MastermindAdmissionAdapter/MastermindAdmissionService") {}
+
+export interface MastermindAdmissionServiceOptions {
+  /** Overridable for tests. */
+  readonly fetchImpl?: typeof fetch | undefined;
+}
+
+export const makeMastermindAdmissionService = (
+  config: MastermindAdmissionConfig,
+  options: MastermindAdmissionServiceOptions = {},
+): MastermindAdmissionServiceShape => {
+  const ledger = new Map<ThreadId, MastermindAdmissionLedgerEntry>();
+  const doFetch = options.fetchImpl ?? fetch;
+  const enforced = config.mode === "enforce" && config.endpoint !== undefined;
+
+  const ledgerLookup = (
+    threadId: ThreadId,
+  ): Effect.Effect<MastermindAdmissionLedgerEntry | undefined> =>
+    Effect.sync(() => ledger.get(threadId));
+
+  const consultEndpoint = (
+    body: Record<string, unknown>,
+  ): Effect.Effect<MastermindAdmissionDecision, MastermindAdmissionEndpointError> => {
+    const endpoint = config.endpoint;
+    const phase = typeof body["phase"] === "string" ? body["phase"] : "launch";
+    if (!enforced || endpoint === undefined) {
+      return Effect.succeed({ type: "passthrough" });
+    }
+    // Serialized in plain code before entering the Effect: the request body
+    // is a static snapshot at consult time, so no throwing JSON call ever
+    // runs inside Effect code.
+    const requestBody = JSON.stringify(body);
+    return Effect.tryPromise({
+      try: async () => {
+        const response = await doFetch(`${endpoint}/v1/admit`, {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: requestBody,
+        });
+        if (!response.ok) {
+          throw new Error(`admission endpoint returned HTTP ${response.status}`);
+        }
+        return (await response.json()) as unknown;
+      },
+      catch: (cause) => new MastermindAdmissionEndpointError({ endpoint, phase, cause }),
+    }).pipe(
+      Effect.flatMap((payload) =>
+        Effect.fromOption(parseAdmissionPayload(payload), () =>
+          new MastermindAdmissionEndpointError({
+            endpoint,
+            phase,
+            cause: "malformed admission payload",
+          }),
+        ),
+      ),
+    );
+  };
+
+  const admitLaunch: MastermindAdmissionServiceShape["admitLaunch"] = (input) =>
+    consultEndpoint({
+      kind: "launch",
+      phase: "launch",
+      projectId: input.projectId,
+      commandId: input.commandId,
+      creationSource: input.creationSource,
+      // Authority comes only from the operator-configured root ref. Prompt text,
+      // request fields, and environment variables other than the configured root
+      // ref are never consulted for it.
+      ...(config.rootRef === undefined ? {} : { rootRef: config.rootRef }),
+    });
+
+  const revalidateExecution: MastermindAdmissionServiceShape["revalidateExecution"] = (input) =>
+    Effect.flatMap(ledgerLookup(input.threadId), (entry) =>
+      consultEndpoint({
+        kind: "revalidate",
+        phase: input.phase,
+        threadId: input.threadId,
+        ...(input.runId === undefined ? {} : { runId: input.runId }),
+        ...(entry === undefined ? {} : { hasLocalBinding: true }),
+        ...(entry?.binding === undefined ? {} : { binding: entry.binding }),
+        rootRef: entry?.rootRef ?? entry?.binding?.rootRef ?? config.rootRef,
+      }),
+    );
+
+  const bindThread: MastermindAdmissionServiceShape["bindThread"] = (input) =>
+    Effect.sync(() => {
+      if (!enforced) return;
+      // Keep the ledger bounded: evict the oldest entry beyond the cap.
+      while (ledger.size >= MAX_LEDGER_ENTRIES) {
+        const oldest = ledger.keys().next();
+        if (oldest.done === true) break;
+        ledger.delete(oldest.value);
+      }
+      ledger.set(input.threadId, {
+        threadId: input.threadId,
+        commandId: input.commandId,
+        creationSource: input.creationSource,
+        rootRef: input.decision.rootRef ?? config.rootRef,
+        binding: input.decision.binding,
+        propagatedCommands: 0,
+        helperCalls: 0,
+      });
+    });
+
+  const recordPropagation: MastermindAdmissionServiceShape["recordPropagation"] = (input) =>
+    Effect.sync(() => {
+      if (!enforced || input.threadId === undefined) return;
+      const entry = ledger.get(input.threadId);
+      if (entry === undefined) {
+        // No admitted binding exists for this thread: nothing to propagate and
+        // nothing may be minted here (propagate, never re-decide).
+        return;
+      }
+      ledger.set(input.threadId, { ...entry, propagatedCommands: entry.propagatedCommands + 1 });
+    });
+
+  const recordHelperRoute: MastermindAdmissionServiceShape["recordHelperRoute"] = (input) =>
+    Effect.sync(() => {
+      if (!enforced) return;
+      const entry = ledger.get(input.threadId);
+      if (entry === undefined) return;
+      ledger.set(input.threadId, { ...entry, helperCalls: entry.helperCalls + 1 });
+    });
+
+  const ledgerSnapshot: MastermindAdmissionServiceShape["ledgerSnapshot"] = Effect.sync(() =>
+    Array.from(ledger.values()),
+  );
+
+  return {
+    config,
+    admitLaunch,
+    revalidateExecution,
+    bindThread,
+    recordPropagation,
+    recordHelperRoute,
+    ledgerSnapshot,
+  };
+};
+
+const parseAdmissionPayload = (payload: unknown): Option.Option<MastermindAdmissionDecision> => {
+  if (!Predicate.hasProperty(payload, "decision")) return Option.none();
+  const record = payload as Record<string, unknown>;
+  const reason = typeof record["reason"] === "string" ? record["reason"] : undefined;
+  if (record["decision"] === "passthrough") {
+    return Option.some({ type: "passthrough" });
+  }
+  if (record["decision"] === "blocked_with_reason") {
+    return Option.some({
+      type: "blocked_with_reason",
+      reason: reason ?? "admission endpoint rejected the request without a reason",
+    });
+  }
+  if (record["decision"] === "admitted") {
+    const rootRef = typeof record["rootRef"] === "string" ? record["rootRef"] : undefined;
+    const admissionId =
+      typeof record["admissionId"] === "string" ? record["admissionId"] : undefined;
+    const grantedAt = typeof record["grantedAt"] === "string" ? record["grantedAt"] : undefined;
+    const binding: MastermindAdmissionBinding | undefined =
+      rootRef === undefined && admissionId === undefined && grantedAt === undefined
+        ? undefined
+        : { rootRef, admissionId, grantedAt };
+    return Option.some({ type: "admitted", rootRef, binding });
+  }
+  return Option.none();
+};
+
+export const layerFromConfig = (
+  config: MastermindAdmissionConfig,
+  options: MastermindAdmissionServiceOptions = {},
+): Layer.Layer<MastermindAdmissionService> =>
+  Layer.effect(
+    MastermindAdmissionService,
+    Effect.sync(() => MastermindAdmissionService.of(makeMastermindAdmissionService(config, options))),
+  );
+
+/** Reads MASTERMIND_ADMISSION_* env at layer build time; unset endpoint = passthrough. */
+export const layer: Layer.Layer<MastermindAdmissionService> = layerFromConfig(
+  readMastermindAdmissionConfig(),
+);
+
+// ---------------------------------------------------------------------------
+// Decorator layers (wrap incumbent layers; incumbent exports stay intact)
+// ---------------------------------------------------------------------------
+
+/**
+ * Wraps an incumbent service layer. When admission is disabled the incumbent
+ * service is returned untouched (zero behavior change); otherwise `wrap` gets
+ * the incumbent service plus the admission service.
+ *
+ * Composition rule (built exactly once): the decorator NEVER runs
+ * `Layer.build` itself. `Layer.build` inside a layer's effect forks the
+ * current memo map (effect 4.1.2 `CurrentMemoMap.forkOrCreate`), so any
+ * dependency first allocated inside that fork is NOT written back to the
+ * outer graph — the outer graph would then build shared singletons
+ * (ProjectionStore, CommandOutputHub, Orchestrator, TextGeneration, ...) a
+ * second time, BEFORE the `mode === "disabled"` check could pass anything
+ * through. Instead the decorator layer simply requires the incumbent service
+ * tag from its context and the incumbent layer is wired in with
+ * `Layer.provide`, which builds it through the SAME memo map as the rest of
+ * the graph — so the incumbent and every dependency it shares with the
+ * undecorated graph is built exactly once, exactly as upstream would.
+ */
+const decorateServiceLayer = <I, S, E, RIn>(
+  tag: Context.Key<I, S>,
+  incumbent: Layer.Layer<I, E, RIn>,
+  wrap: (inner: S, admission: MastermindAdmissionService["Service"]) => S,
+): Layer.Layer<I, E, RIn | MastermindAdmissionService> =>
+  Layer.effect(
+    tag,
+    Effect.gen(function* () {
+      const admission = yield* MastermindAdmissionService;
+      // The incumbent service instance, provided by the outer graph below.
+      const inner = yield* tag;
+      if (admission.config.mode === "disabled") {
+        return inner;
+      }
+      return wrap(inner, admission);
+    }),
+  ).pipe(Layer.provide(incumbent));
+
+// a. ThreadLaunchService: admit BEFORE the first preparation effect, bind the
+// root/binding onto the launched thread. Manual UI launches pass through the
+// same single gate as every other creation source — no per-prompt ceremony.
+export const decorateThreadLaunch = <E, RIn>(
+  incumbent: Layer.Layer<ThreadLaunch.ThreadLaunchService, E, RIn>,
+): Layer.Layer<ThreadLaunch.ThreadLaunchService, E, RIn | MastermindAdmissionService> =>
+  decorateServiceLayer(
+    ThreadLaunch.ThreadLaunchService,
+    incumbent,
+    (inner, admission): ThreadLaunch.ThreadLaunchService["Service"] => ({
+      ...inner,
+      launch: (request) =>
+        admission
+          .admitLaunch({
+            projectId: request.projectId,
+            commandId: request.commandId,
+            creationSource: request.creationSource,
+          })
+          .pipe(
+            Effect.filterOrFail(
+              (decision: MastermindAdmissionDecision) =>
+                decision.type !== "blocked_with_reason",
+              // Only reachable for blocked decisions (the predicate guarantees
+              // it); the fallback string keeps the mapper total for the
+              // unnarrowed union type.
+              (decision) =>
+                admissionBlocked(
+                  decision.type === "blocked_with_reason"
+                    ? decision.reason
+                    : "launch blocked by admission",
+                  "launch",
+                ),
+            ),
+            // Surfaced through the launch funnel's own typed error; the cause
+            // carries the real admission reason. No upstream logic changed.
+            Effect.mapError(
+              (cause) =>
+                new ThreadLaunch.ThreadLaunchError({
+                  operation: "resolve-project",
+                  commandId: request.commandId,
+                  projectId: request.projectId,
+                  cause,
+                }),
+            ),
+            Effect.flatMap((decision) => {
+              const launched = inner.launch(request);
+              return decision.type === "admitted"
+                ? launched.pipe(
+                    Effect.tap((result) =>
+                      admission.bindThread({
+                        threadId: result.threadId,
+                        commandId: request.commandId,
+                        creationSource: request.creationSource,
+                        decision,
+                      }),
+                    ),
+                  )
+                : launched;
+            }),
+          ),
+      // Retries of an admitted launch carry the existing binding onward;
+      // propagation only — no re-decision.
+      retryPreparation: (input) =>
+        admission
+          .recordPropagation({
+            threadId: input.threadId,
+            runId: input.runId,
+            commandType: "thread_launch.retry_preparation",
+          })
+          .pipe(Effect.andThen(() => inner.retryPreparation(input))),
+    }),
+  );
+
+// b. ThreadManagementService.dispatch: carry the root/binding through messages,
+// delegation, and prepared-run release/retry. Propagate, do not re-decide.
+export const decorateThreadManagementDispatch = <E, RIn>(
+  incumbent: Layer.Layer<ThreadManagement.ThreadManagementService, E, RIn>,
+): Layer.Layer<ThreadManagement.ThreadManagementService, E, RIn | MastermindAdmissionService> =>
+  decorateServiceLayer(
+    ThreadManagement.ThreadManagementService,
+    incumbent,
+    (inner, admission): ThreadManagement.ThreadManagementService["Service"] => ({
+      ...inner,
+      dispatch: (command) =>
+        admission
+          .recordPropagation({
+            threadId: "threadId" in command ? command.threadId : undefined,
+            runId: "runId" in command ? command.runId : undefined,
+            commandType: command.type,
+          })
+          .pipe(Effect.andThen(() => inner.dispatch(command))),
+    }),
+  );
+
+// c. OrchestrationEffectExecutorV2: revalidate immediately before provider-turn
+// start/steer/restart. Stale lease blocks new execution only; steer records but
+// never blocks; interrupts/cancels are untouched.
+export const decorateOrchestrationEffectExecutor = <E, RIn>(
+  incumbent: Layer.Layer<EffectWorker.OrchestrationEffectExecutorV2, E, RIn>,
+): Layer.Layer<EffectWorker.OrchestrationEffectExecutorV2, E, RIn | MastermindAdmissionService> =>
+  decorateServiceLayer(
+    EffectWorker.OrchestrationEffectExecutorV2,
+    incumbent,
+    (inner, admission): EffectWorker.OrchestrationEffectExecutorV2Shape => ({
+      ...inner,
+      execute: (effect, options) => {
+        switch (effect.request.type) {
+          case "provider-turn.start":
+          case "provider-turn.restart": {
+            // restart is revalidated BEFORE the upstream interrupt runs, so a
+            // block fails the whole compound effect and leaves the original
+            // turn untouched; when admitted, upstream's interrupt-then-start
+            // replacement lifecycle is unchanged.
+            const runId = effect.request.runId;
+            const phase =
+              effect.request.type === "provider-turn.start"
+                ? ("provider_turn_start" as const)
+                : ("provider_turn_restart" as const);
+            return admission
+              .revalidateExecution({ threadId: effect.threadId, runId, phase })
+              .pipe(
+                Effect.flatMap((decision) =>
+                  decision.type === "blocked_with_reason"
+                    ? // Fail with the RAW blocked error; mapError below wraps
+                      // it exactly once into the executor's typed error.
+                      Effect.fail(admissionBlocked(decision.reason, phase))
+                    : Effect.void,
+                ),
+                Effect.mapError(
+                  (cause) =>
+                    new EffectWorker.OrchestrationEffectExecutionError({
+                      effectId: effect.id,
+                      effectType: effect.request.type,
+                      cause,
+                    }),
+                ),
+                Effect.andThen(() => inner.execute(effect, options)),
+              );
+          }
+          case "provider-turn.steer":
+            // Steer delivers into an existing turn: record revalidation
+            // outcomes, never block, never interrupt.
+            return admission
+              .revalidateExecution({
+                threadId: effect.threadId,
+                runId: undefined,
+                phase: "provider_turn_steer",
+              })
+              .pipe(
+                Effect.flatMap((decision) =>
+                  decision.type === "blocked_with_reason"
+                    ? Effect.logWarning(
+                        "Mastermind admission: stale lease recorded for steer; steer is not new execution and proceeds",
+                        { effectId: effect.id, threadId: effect.threadId, reason: decision.reason },
+                      )
+                    : Effect.void,
+                ),
+                Effect.ignore,
+                Effect.andThen(() => inner.execute(effect, options)),
+              );
+          default:
+            return inner.execute(effect, options);
+        }
+      },
+    }),
+  );
+
+// d. ProviderTurnStartService: revalidate placement + fence immediately before
+// the native turn binding. Covers every caller, including the restart path.
+const turnStartAdmissionFailure = (runId: RunId, cause: unknown) =>
+  new ProviderTurnStartService.ProviderTurnStartError({ runId, cause });
+
+export const decorateProviderTurnStartService = <E, RIn>(
+  incumbent: Layer.Layer<ProviderTurnStartService.ProviderTurnStartServiceV2, E, RIn>,
+): Layer.Layer<
+  ProviderTurnStartService.ProviderTurnStartServiceV2,
+  E,
+  RIn | MastermindAdmissionService
+> =>
+  decorateServiceLayer(
+    ProviderTurnStartService.ProviderTurnStartServiceV2,
+    incumbent,
+    (
+      inner,
+      admission,
+    ): ProviderTurnStartService.ProviderTurnStartServiceV2Shape => ({
+      ...inner,
+      start: (input) =>
+        admission
+          .revalidateExecution({
+            threadId: input.threadId,
+            runId: input.runId,
+            phase: "provider_turn_start",
+          })
+          .pipe(
+            Effect.flatMap((decision) =>
+              decision.type === "blocked_with_reason"
+                ? // RAW blocked error; mapError wraps once below.
+                  Effect.fail(admissionBlocked(decision.reason, "provider_turn_start"))
+                : Effect.void,
+            ),
+            Effect.mapError((cause) => turnStartAdmissionFailure(input.runId, cause)),
+            Effect.andThen(() => inner.start(input)),
+          ),
+    }),
+  );
+
+// d. ProviderSessionManager: revalidate placement + fence immediately before
+// the native process/session binding (process spawn for ACP agents).
+export const decorateProviderSessionManager = <E, RIn>(
+  incumbent: Layer.Layer<ProviderSessionManager.ProviderSessionManagerV2, E, RIn>,
+): Layer.Layer<ProviderSessionManager.ProviderSessionManagerV2, E, RIn | MastermindAdmissionService> =>
+  decorateServiceLayer(
+    ProviderSessionManager.ProviderSessionManagerV2,
+    incumbent,
+    (inner, admission): ProviderSessionManager.ProviderSessionManagerV2Shape => ({
+      ...inner,
+      open: (input) =>
+        admission
+          .revalidateExecution({
+            threadId: input.threadId,
+            runId: undefined,
+            phase: "provider_session_open",
+          })
+          .pipe(
+            Effect.flatMap((decision) =>
+              decision.type === "blocked_with_reason"
+                ? // RAW blocked error; mapError wraps once below.
+                  Effect.fail(admissionBlocked(decision.reason, "provider_session_open"))
+                : Effect.void,
+            ),
+            Effect.mapError(
+              (cause) =>
+                new ProviderSessionManager.ProviderSessionOpenError({
+                  instanceId: input.modelSelection.instanceId,
+                  providerSessionId: input.providerSessionId,
+                  cause,
+                }),
+            ),
+            Effect.andThen(() => inner.open(input)),
+          ),
+    }),
+  );
+
+// e. Helper-model accounting: wrap the app-owned helper-model call surface with
+// a bounded accounted helper-route record. Accounting only — no upstream
+// behavior change; title regeneration proceeds even if accounting is skipped.
+export const decorateThreadTitleRegenerationService = <E, RIn>(
+  incumbent: Layer.Layer<ThreadTitleRegenerationService.ThreadTitleRegenerationService, E, RIn>,
+): Layer.Layer<
+  ThreadTitleRegenerationService.ThreadTitleRegenerationService,
+  E,
+  RIn | MastermindAdmissionService
+> =>
+  decorateServiceLayer(
+    ThreadTitleRegenerationService.ThreadTitleRegenerationService,
+    incumbent,
+    (
+      inner,
+      admission,
+    ): ThreadTitleRegenerationService.ThreadTitleRegenerationService["Service"] => ({
+      ...inner,
+      execute: (input) =>
+        admission
+          .recordHelperRoute({
+            threadId: input.threadId,
+            route: "title_regeneration",
+            detail: input.requestId,
+          })
+          .pipe(Effect.andThen(() => inner.execute(input))),
+    }),
+  );
