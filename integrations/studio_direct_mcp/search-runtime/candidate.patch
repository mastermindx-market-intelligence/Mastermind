+import { parentPort, workerData } from 'node:worker_threads';
+import { OfficeSearch } from './office-search.js';
+
+if (!parentPort) throw new Error('Office parser requires its owner worker');
+const port = parentPort;
+const task = workerData;
+if (!task || !['excel', 'docx'].includes(task.source) ||
+    typeof task.rootPath !== 'string' || task.rootPath.length > 4096 ||
+    typeof task.pattern !== 'string' || task.pattern.length > 4096 ||
+    (task.filePattern !== undefined && (typeof task.filePattern !== 'string' || task.filePattern.length > 8192)) ||
+    !(task.control instanceof SharedArrayBuffer) || task.control.byteLength !== 8) {
+  throw new Error('Invalid bounded Office task');
+}
+const control = new Int32Array(task.control); // [stopRequested, recordAcknowledged]
+const stopped = () => Atomics.load(control, 0) !== 0;
+const parser = new OfficeSearch();
+let invalidRecord = false;
+try {
+  const search = task.source === 'excel' ? parser.searchExcelFiles.bind(parser) : parser.searchDocxFiles.bind(parser);
+  await search(task.rootPath, task.pattern, task.ignoreCase, {
+    isStopped: stopped,
+    onMatch(result) {
+      if (stopped()) return;
+      if (typeof result.file !== 'string' || result.file.length > 4096 ||
+          !Number.isSafeInteger(result.line) || result.line! < 0) {
+        invalidRecord = true;
+        Atomics.store(control, 0, 1);
+        port.postMessage({ kind: 'limit' });
+        return;
+      }
+      // Copy only display text across the isolate boundary. At most ONE result
+      // is in flight, even while Excel's synchronous eachRow loop is running.
+      const match = Buffer.from((result.match ?? '').slice(0, 101), 'utf16le').toString('utf16le');
+      Atomics.store(control, 1, 0);
+      port.postMessage({ kind: 'match', result: { file: result.file, line: result.line, match, type: 'content' } });
+      while (!stopped() && Atomics.load(control, 1) === 0) Atomics.wait(control, 1, 0);
+    }
+  }, task.filePattern, task.includeHidden);
+  if (!invalidRecord) port.postMessage({ kind: 'done' });
+} finally {
+  port.close(); // The owner still waits for the worker's exit event.
+}
