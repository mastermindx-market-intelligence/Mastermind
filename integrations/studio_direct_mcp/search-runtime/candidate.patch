+import { Worker } from 'node:worker_threads';
+
+/** Fixed owner-native worker; callers cannot select a program or worker URL. */
+export function createOfficeWorker(workerData: {
+  source: 'excel' | 'docx';
+  rootPath: string;
+  pattern: string;
+  ignoreCase: boolean;
+  filePattern?: string;
+  includeHidden: boolean;
+  control: SharedArrayBuffer;
+}): Worker {
+  return new Worker(new URL('./office-search-worker.js', import.meta.url), {
+    workerData,
+    // Limits V8 heaps, not native allocations or whole-process RSS.
+    resourceLimits: { maxOldGenerationSizeMb: 64, maxYoungGenerationSizeMb: 16, stackSizeMb: 4 },
+    stdout: true,
+    stderr: true
+  });
+}
