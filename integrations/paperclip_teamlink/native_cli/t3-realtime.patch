+        projects: [{ projects: [{ id: "project-1" }], nextCursor: null }],
+        threads: [{ threads: [], nextCursor: 0 }],
+      },
+      {
+        projects: [{ projects: [{ id: "project-1" }], nextCursor: null }],
+        threads: Array.from({ length: 20 }, (_, i) => ({ threads: [], nextCursor: (i + 1) * 100 })),
+      },
+    ];
+    for (const fixture of cases) {
+      const closed = yield* Deferred.make<void>();
