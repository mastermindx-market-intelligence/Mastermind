--- /dev/null
+++ b/apps/server/src/cli/thread-watch.test.ts
@@ -0,0 +1,724 @@
+import { assert, it } from "@effect/vitest";
+import { AuthSessionId } from "@t3tools/contracts";
+import * as Cause from "effect/Cause";
+import * as PlatformError from "effect/PlatformError";
+import * as Sink from "effect/Sink";
+import * as Stdio from "effect/Stdio";
+import * as DateTime from "effect/DateTime";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as Result from "effect/Result";
+import * as Stream from "effect/Stream";
+import * as TestClock from "effect/testing/TestClock";
+import { beforeEach } from "vite-plus/test";
+
+import * as EnvironmentAuth from "../auth/EnvironmentAuth.ts";
+import type { ThreadTools } from "./thread.ts";
+import {
+  NATIVE_WATCH_MAX_PROJECTS,
+  NATIVE_WATCH_MAX_REQUEST_BYTES,
+  NATIVE_WATCH_MAX_THREADS,
+  NATIVE_WATCH_SCHEMA,
+  applyNativeWatchStreamItem,
+  collapseNativeWatchNotices,
+  classifyNativeWatchBootstrapError,
+  classifyNativeWatchSubscriptionCause,
+  initialNativeWatchThreadState,
+  parseNativeWatchRequest,
+  runNativeWatch,
+  type NativeWatchErrorCode,
+  type NativeWatchRequest,
+  type NativeWatchStreamItem,
+  type NativeWatchThreadOpener,
+} from "./thread-watch.ts";
+
+const wire: string[] = [];
+const captureOutput = () =>
+  Sink.forEach((chunk: string | Uint8Array) =>
+    Effect.sync(() => {
+      wire.push(typeof chunk === "string" ? chunk : new TextDecoder().decode(chunk));
+    }),
+  );
+
+const auth = {
+  issues: 0,
+  revokes: 0,
+  scopes: [] as ReadonlyArray<string>,
+  ttl: undefined as unknown,
+};
+
+/** The native auth the watch uses, with no server and no stored credential. */
+const authLayer = Layer.mock(EnvironmentAuth.EnvironmentAuth)({
+  issueSession: (input) =>
+    Effect.map(DateTime.now, (expiresAt) => {
+      auth.issues += 1;
+      auth.scopes = input?.scopes ?? [];
+      auth.ttl = input?.ttl;
+      return {
+        sessionId: AuthSessionId.make("watch-session"),
+        token: "synthetic-token",
+        method: "bearer-access-token" as const,
+        scopes: input?.scopes ?? [],
+        subject: "t3-thread-native-watch",
+        client: { deviceType: "bot" as const },
+        expiresAt,
+      };
+    }),
+  issueWebSocketTicket: () =>
+    Effect.map(DateTime.now, (expiresAt) => ({
+      ticket: Redacted.make("synthetic-ticket"),
+      expiresAt,
+    })),
+  revokeSession: () =>
+    Effect.sync(() => {
+      auth.revokes += 1;
+      return true;
+    }),
+});
+
+beforeEach(() => {
+  wire.length = 0;
+  auth.issues = 0;
+  auth.revokes = 0;
+});
+
+const request = (overrides: Partial<NativeWatchRequest> = {}): NativeWatchRequest => ({
+  environmentId: "env-1",
+  projectIds: ["project-1"],
+  threadIds: ["thread-1"],
+  ...overrides,
+});
+
+/** Answers each tool call with the next scripted response for that tool. */
+const fakeTools = (script: Record<string, Array<unknown>>) => {
+  const calls: Array<{ readonly tool: string; readonly args: unknown }> = [];
+  const call = ((tool: string, args: unknown) => {
+    calls.push({ tool, args });
+    const next = script[tool]?.shift();
+    return next === undefined ? Effect.die(`unscripted ${tool} call`) : Effect.succeed(next);
+  }) as ThreadTools["call"];
+  return { tools: { call } satisfies ThreadTools, calls };
+};
+
+const qualifiedTools = (threads: ReadonlyArray<unknown> = []) =>
+  fakeTools({
+    t3_environment_read: [{ environmentId: "env-1" }],
+    t3_project_list: [{ projects: [{ id: "project-1" }], nextCursor: null }],
+    t3_thread_list: [{ threads, nextCursor: null }],
+  });
+
+const rootThread = { threadId: "thread-1", projectId: "project-1", parentThreadId: null };
+
+/** Runs one watch on the mocked native auth, with the scripted subscription. */
+const runWatch = (
+  watch: NativeWatchRequest,
+  closed: Deferred.Deferred<void>,
+  tools: ThreadTools,
+  opener: NativeWatchThreadOpener,
+) =>
+  Effect.scoped(runNativeWatch(watch, closed, tools, "http://127.0.0.1:1", opener)).pipe(
+    Effect.provide(Layer.mergeAll(authLayer, Stdio.layerTest({ stdout: captureOutput }))),
+  );
+
+/** The notice lines this command printed, parsed. */
+const printedNotices = Effect.sync(() =>
+  wire
+    .join("")
+    .trim()
+    .split("\n")
+    .filter(Boolean)
+    .map((line) => JSON.parse(line) as Record<string, unknown>),
+);
+
+const expectRefusal = (line: string, code: NativeWatchErrorCode) => {
+  const parsed = parseNativeWatchRequest(line);
+  if (Result.isFailure(parsed)) {
+    assert.strictEqual(parsed.failure.code, code);
+    return;
+  }
+  assert.fail(`expected the request to be refused with ${code}`);
+};
+
+it("parseNativeWatchRequest accepts one exact request", () => {
+  const parsed = parseNativeWatchRequest(
+    JSON.stringify({ environmentId: "env-1", projectIds: ["project-1"], threadIds: ["thread-1"] }),
+  );
+  if (Result.isFailure(parsed)) {
+    assert.fail(`expected the request to be accepted, got ${parsed.failure.code}`);
+  }
+  assert.deepStrictEqual(parsed.success, {
+    environmentId: "env-1",
+    projectIds: ["project-1"],
+    threadIds: ["thread-1"],
+  });
+});
+
+it("parseNativeWatchRequest refuses input that is not one exact object", () => {
+  expectRefusal("", "invalid_request");
+  expectRefusal("not json", "invalid_request");
+  expectRefusal("[1, 2]", "invalid_request");
+  expectRefusal("null", "invalid_request");
+  expectRefusal(
+    JSON.stringify({ environmentId: "env-1", projectIds: [], threadIds: [] }),
+    "invalid_request",
+  );
+  expectRefusal(
+    JSON.stringify({ environmentId: " env-1", projectIds: ["p"], threadIds: ["t"] }),
+    "invalid_request",
+  );
+  expectRefusal(
+    JSON.stringify({ environmentId: "env-1", projectIds: [" p"], threadIds: ["t"] }),
+    "invalid_request",
+  );
+  expectRefusal(
+    JSON.stringify({ environmentId: 7, projectIds: ["p"], threadIds: ["t"] }),
+    "invalid_request",
+  );
+});
+
+it("parseNativeWatchRequest refuses a field this command does not accept", () => {
+  expectRefusal(
+    JSON.stringify({ environmentId: "env-1", projectIds: ["p"], threadIds: ["t"], cursor: 4 }),
+    "invalid_request",
+  );
+  expectRefusal(JSON.stringify({ environmentId: "env-1", projectIds: ["p"] }), "invalid_request");
+});
+
+it("parseNativeWatchRequest refuses oversized and over-counted requests", () => {
+  const manyProjects = Array.from(
+    { length: NATIVE_WATCH_MAX_PROJECTS + 1 },
+    (_, index) => `p-${index}`,
+  );
+  expectRefusal(
+    JSON.stringify({ environmentId: "env-1", projectIds: manyProjects, threadIds: ["t"] }),
+    "invalid_request",
+  );
+  const manyThreads = Array.from(
+    { length: NATIVE_WATCH_MAX_THREADS + 1 },
+    (_, index) => `t-${index}`,
+  );
+  expectRefusal(
+    JSON.stringify({ environmentId: "env-1", projectIds: ["p"], threadIds: manyThreads }),
+    "invalid_request",
+  );
+  expectRefusal(
+    JSON.stringify({
+      environmentId: "env-1",
+      projectIds: ["p", "p"],
+      threadIds: ["t"],
+    }),
+    "invalid_request",
+  );
+  expectRefusal(
+    JSON.stringify({
+      environmentId: "env-1",
+      projectIds: ["p"],
+      threadIds: ["t", "t"],
+    }),
+    "invalid_request",
+  );
+  expectRefusal(
+    JSON.stringify({
+      environmentId: "env-1",
+      projectIds: ["p"],
+      threadIds: ["t"],
+      padding: "x".repeat(NATIVE_WATCH_MAX_REQUEST_BYTES),
+    }),
+    "request_too_large",
+  );
+});
+
+it("applyNativeWatchStreamItem turns the snapshot into ready and later events into changed", () => {
+  const snapshot = applyNativeWatchStreamItem("env-1", "thread-1", initialNativeWatchThreadState, {
+    kind: "snapshot",
+    snapshotSequence: 12,
+  });
+  assert.deepStrictEqual(snapshot.notices, [
+    {
+      schema: NATIVE_WATCH_SCHEMA,
+      type: "ready",
+      environmentId: "env-1",
+      threadId: "thread-1",
+      sequence: 12,
+    },
+  ]);
+
+  const synchronized = applyNativeWatchStreamItem("env-1", "thread-1", snapshot.state, {
+    kind: "synchronized",
+  });
+  assert.deepStrictEqual(synchronized.notices, []);
+  assert.strictEqual(synchronized.state.ready, true);
+
+  const changed = applyNativeWatchStreamItem("env-1", "thread-1", synchronized.state, {
+    kind: "event",
+    sequence: 13,
+  });
+  assert.deepStrictEqual(changed.notices, [
+    {
+      schema: NATIVE_WATCH_SCHEMA,
+      type: "changed",
+      environmentId: "env-1",
+      threadId: "thread-1",
+      sequence: 13,
+    },
+  ]);
+
+  const stale = applyNativeWatchStreamItem("env-1", "thread-1", changed.state, {
+    kind: "event",
+    sequence: 13,
+  });
+  assert.deepStrictEqual(stale.notices, []);
+});
+
+it("applyNativeWatchStreamItem keeps thread content out of the notice", () => {
+  const changed = applyNativeWatchStreamItem("env-1", "thread-1", initialNativeWatchThreadState, {
+    kind: "event",
+    sequence: 13,
+  });
+  for (const notice of changed.notices) {
+    assert.deepStrictEqual(Object.keys(notice).toSorted(), [
+      "environmentId",
+      "schema",
+      "sequence",
+      "threadId",
+      "type",
+    ]);
+    assert.strictEqual(JSON.stringify(notice).includes("text"), false);
+    assert.strictEqual(JSON.stringify(notice).includes("token"), false);
+  }
+});
+
+it("collapseNativeWatchNotices keeps the newest change per thread and the rest in order", () => {
+  const ready = {
+    schema: NATIVE_WATCH_SCHEMA,
+    type: "ready",
+    environmentId: "env-1",
+    threadId: "thread-1",
+    sequence: 12,
+  } as const;
+  const first = {
+    schema: NATIVE_WATCH_SCHEMA,
+    type: "changed",
+    environmentId: "env-1",
+    threadId: "thread-1",
+    sequence: 13,
+  } as const;
+  const second = {
+    schema: NATIVE_WATCH_SCHEMA,
+    type: "changed",
+    environmentId: "env-1",
+    threadId: "thread-1",
+    sequence: 14,
+  } as const;
+  const heartbeat = {
+    schema: NATIVE_WATCH_SCHEMA,
+    type: "heartbeat",
+    environmentId: "env-1",
+  } as const;
+
+  assert.deepStrictEqual(collapseNativeWatchNotices([ready, first, second, heartbeat]), [
+    ready,
+    second,
+    heartbeat,
+  ]);
+});
+
+it.effect("the watch refuses an environment it cannot prove", () =>
+  Effect.gen(function* () {
+    const { tools } = fakeTools({
+      t3_environment_read: [{ environmentId: "env-2" }],
+      t3_project_list: [{ projects: [{ id: "project-1" }], nextCursor: null }],
+    });
+    const closed = yield* Deferred.make<void>();
+    const before = (yield* printedNotices).length;
+
+    yield* runWatch(request(), closed, tools, () => Effect.succeed(Stream.empty));
+
+    const lines = (yield* printedNotices).slice(before);
+    assert.deepStrictEqual(lines, [
+      {
+        schema: NATIVE_WATCH_SCHEMA,
+        type: "error",
+        environmentId: "env-1",
+        code: "environment_mismatch",
+      },
+    ]);
+    assert.strictEqual(auth.issues, 0);
+  }),
+);
+
+it.effect("the watch refuses a project that is not bound to this environment", () =>
+  Effect.gen(function* () {
+    const { tools } = fakeTools({
+      t3_environment_read: [{ environmentId: "env-1" }],
+      t3_project_list: [{ projects: [{ id: "other-project" }], nextCursor: null }],
+    });
+    const closed = yield* Deferred.make<void>();
+    const before = (yield* printedNotices).length;
+
+    yield* runWatch(request(), closed, tools, () => Effect.succeed(Stream.empty));
+
+    const lines = (yield* printedNotices).slice(before);
+    assert.deepStrictEqual(lines, [
+      {
+        schema: NATIVE_WATCH_SCHEMA,
+        type: "error",
+        environmentId: "env-1",
+        code: "project_not_found",
+      },
+    ]);
+    assert.strictEqual(auth.issues, 0);
+  }),
+);
+
+it.effect("the watch refuses a child thread and an unknown thread", () =>
+  Effect.gen(function* () {
+    const child = qualifiedTools([
+      { threadId: "thread-1", projectId: "project-1", parentThreadId: "parent-thread" },
+    ]);
+    const closed = yield* Deferred.make<void>();
+    const before = (yield* printedNotices).length;
+
+    yield* runWatch(request(), closed, child.tools, () => Effect.succeed(Stream.empty));
+
+    const lines = (yield* printedNotices).slice(before);
+    assert.deepStrictEqual(lines, [
+      {
+        schema: NATIVE_WATCH_SCHEMA,
+        type: "error",
+        environmentId: "env-1",
+        code: "thread_not_root",
+      },
+    ]);
+    assert.strictEqual(auth.issues, 0);
+
+    const unknown = qualifiedTools([]);
+    const unknownBefore = (yield* printedNotices).length;
+    yield* runWatch(request(), closed, unknown.tools, () => Effect.succeed(Stream.empty));
+    assert.deepStrictEqual((yield* printedNotices).slice(unknownBefore), [
+      {
+        schema: NATIVE_WATCH_SCHEMA,
+        type: "error",
+        environmentId: "env-1",
+        code: "thread_not_found",
+      },
+    ]);
+    assert.strictEqual(auth.issues, 0);
+  }),
+);
+
+it.effect("the watch reports readiness and changes, then a closed subscription", () =>
+  Effect.gen(function* () {
+    const { tools } = qualifiedTools([rootThread]);
+    const closed = yield* Deferred.make<void>();
+    const before = (yield* printedNotices).length;
+    const items: ReadonlyArray<NativeWatchStreamItem> = [
+      { kind: "snapshot", snapshotSequence: 12 },
+      { kind: "synchronized" },
+      { kind: "event", sequence: 13 },
+    ];
+    const opener: NativeWatchThreadOpener = () => Effect.succeed(Stream.fromIterable(items));
+
+    yield* runWatch(request(), closed, tools, opener);
+
+    const lines = (yield* printedNotices).slice(before);
+    assert.deepStrictEqual(lines, [
+      {
+        schema: NATIVE_WATCH_SCHEMA,
+        type: "ready",
+        environmentId: "env-1",
+        threadId: "thread-1",
+        sequence: 12,
+      },
+      {
+        schema: NATIVE_WATCH_SCHEMA,
+        type: "changed",
+        environmentId: "env-1",
+        threadId: "thread-1",
+        sequence: 13,
+      },
+      {
+        schema: NATIVE_WATCH_SCHEMA,
+        type: "error",
+        environmentId: "env-1",
+        code: "subscription_closed",
+      },
+    ]);
+    assert.strictEqual(auth.issues, 1);
+    assert.deepStrictEqual(auth.scopes, ["orchestration:read"]);
+    assert.strictEqual(auth.revokes, 1);
+  }),
+);
+
+it.effect("stdin closing ends the watch and revokes the session", () =>
+  Effect.gen(function* () {
+    const { tools } = qualifiedTools([rootThread]);
+    const closed = yield* Deferred.make<void>();
+    const subscribed = yield* Deferred.make<void>();
+    const before = (yield* printedNotices).length;
+    const opener: NativeWatchThreadOpener = () =>
+      Effect.gen(function* () {
+        yield* Deferred.succeed(subscribed, void 0);
+        return Stream.never;
+      });
+
+    const fiber = yield* Effect.forkChild(runWatch(request(), closed, tools, opener));
+    yield* Deferred.await(subscribed);
+    yield* Deferred.succeed(closed, void 0);
+    yield* Fiber.join(fiber);
+
+    assert.deepStrictEqual((yield* printedNotices).slice(before), [
+      { schema: NATIVE_WATCH_SCHEMA, type: "error", environmentId: "env-1", code: "stdin_closed" },
+    ]);
+    assert.strictEqual(auth.issues, 1);
+    assert.strictEqual(auth.revokes, 1);
+  }),
+);
+
+it.effect("cancelling the watch still revokes the session", () =>
+  Effect.gen(function* () {
+    const { tools } = qualifiedTools([rootThread]);
+    const closed = yield* Deferred.make<void>();
+    const subscribed = yield* Deferred.make<void>();
+    const opener: NativeWatchThreadOpener = () =>
+      Effect.gen(function* () {
+        yield* Deferred.succeed(subscribed, void 0);
+        return Stream.never;
+      });
+
+    const fiber = yield* Effect.forkChild(runWatch(request(), closed, tools, opener));
+    yield* Deferred.await(subscribed);
+    yield* Fiber.interrupt(fiber);
+
+    assert.strictEqual(auth.issues, 1);
+    assert.strictEqual(auth.revokes, 1);
+  }),
+);
+
+it.effect("the heartbeat only reports a live subscription", () =>
+  Effect.gen(function* () {
+    const { tools } = qualifiedTools([rootThread]);
+    const closed = yield* Deferred.make<void>();
+    const subscribed = yield* Deferred.make<void>();
+    const before = (yield* printedNotices).length;
+    const opener: NativeWatchThreadOpener = () =>
+      Effect.gen(function* () {
+        yield* Deferred.succeed(subscribed, void 0);
+        return Stream.never;
+      });
+
+    const fiber = yield* Effect.forkChild(runWatch(request(), closed, tools, opener));
+    yield* Deferred.await(subscribed);
+    yield* TestClock.adjust("15 seconds");
+    yield* Deferred.succeed(closed, void 0);
+    yield* Fiber.join(fiber);
+
+    assert.deepStrictEqual((yield* printedNotices).slice(before), [
+      { schema: NATIVE_WATCH_SCHEMA, type: "heartbeat", environmentId: "env-1" },
+      { schema: NATIVE_WATCH_SCHEMA, type: "error", environmentId: "env-1", code: "stdin_closed" },
+    ]);
+    assert.strictEqual(auth.revokes, 1);
+  }),
+);
+
+it("only proved transport failures reconnect, while authorization and unknown causes stay held", () => {
+  for (const status of [401, 403]) {
+    assert.strictEqual(
+      classifyNativeWatchBootstrapError({
+        _tag: "AcpMcpBridgeError",
+        message: `T3 Code MCP endpoint responded with HTTP ${status}.`,
+        cause: { code: "ECONNRESET" },
+      }),
+      "authorization_failed",
+    );
+  }
+  assert.strictEqual(
+    classifyNativeWatchBootstrapError({
+      _tag: "AcpMcpBridgeError",
+      cause: { code: "ECONNREFUSED" },
+    }),
+    "connection_lost",
+  );
+  assert.strictEqual(
+    classifyNativeWatchBootstrapError({ _tag: "AcpMcpBridgeError", message: "unexpected result" }),
+    "server_unreachable",
+  );
+  for (const error of [
+    { _tag: "EnvironmentAuthorizationError" },
+    { _tag: "OrchestrationV2GetThreadProjectionError" },
+    { _tag: "RpcClientError", reason: { _tag: "RpcClientDefect" } },
+    { _tag: "RpcClientError", reason: { _tag: "SocketCloseError", code: 1008 } },
+    { _tag: "RpcClientError", reason: { _tag: "SocketOpenError", kind: "Unknown" } },
+  ])
+    assert.notStrictEqual(
+      classifyNativeWatchSubscriptionCause(Cause.fail(error)),
+      "connection_lost",
+    );
+  for (const reason of [
+    { _tag: "SocketReadError" },
+    { _tag: "SocketWriteError" },
+    { _tag: "SocketCloseError", code: 1006 },
+    { _tag: "SocketOpenError", kind: "Timeout" },
+  ])
+    assert.strictEqual(
+      classifyNativeWatchSubscriptionCause(Cause.fail({ _tag: "RpcClientError", reason })),
+      "connection_lost",
+    );
+});
+
+it.effect("bounded qualification refuses stalled cursors and incomplete inventories", () =>
+  Effect.gen(function* () {
