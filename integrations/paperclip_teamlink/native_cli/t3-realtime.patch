+  if (item.kind === "snapshot") {
+    const sequence = item.snapshotSequence;
+    return {
+      state: {
+        snapshotSequence: sequence,
+        ready: true,
+        lastSequence:
+          sequence === undefined ? state.lastSequence : Math.max(state.lastSequence, sequence),
+      },
+      notices: [nativeWatchReadyNotice(environmentId, threadId, sequence)],
+    };
+  }
+  if (item.kind === "event") {
+    const sequence = item.sequence;
+    if (sequence === undefined || sequence <= state.lastSequence) {
+      return { state, notices: [] };
+    }
+    return {
+      state: { ...state, ready: true, lastSequence: sequence },
+      notices: [nativeWatchChangedNotice(environmentId, threadId, sequence)],
+    };
+  }
+  // "synchronized" marks the end of the replay and carries nothing of its own.
+  return { state, notices: [] };
+};
+
+/**
+ * Keeps the newest change signal per thread from one drained batch. Every other
+ * notice is preserved in order, so a backlog collapses instead of piling up.
+ */
+export const collapseNativeWatchNotices = (
+  notices: ReadonlyArray<NativeWatchNotice>,
+): ReadonlyArray<NativeWatchNotice> => {
+  const collapsed: Array<NativeWatchNotice> = [];
+  const changedIndex = new Map<string, number>();
+  for (const notice of notices) {
+    if (notice.type !== "changed" || notice.threadId === undefined) {
+      collapsed.push(notice);
+      continue;
+    }
+    const index = changedIndex.get(notice.threadId);
+    if (index === undefined) {
+      changedIndex.set(notice.threadId, collapsed.length);
+      collapsed.push(notice);
+      continue;
+    }
+    const previous = collapsed[index];
+    if (previous !== undefined && (previous.sequence ?? -1) <= (notice.sequence ?? -1)) {
+      collapsed[index] = notice;
+    }
+  }
+  return collapsed;
+};
+
+const EnvironmentReadResult = Schema.Struct({ environmentId: Schema.String });
+
+const ProjectListResult = Schema.Struct({
+  projects: Schema.Array(Schema.Struct({ id: Schema.String })),
+  nextCursor: Schema.NullOr(Schema.Int),
+});
+
+const ThreadListResult = Schema.Struct({
+  threads: Schema.Array(
+    Schema.Struct({
+      threadId: Schema.String,
+      projectId: Schema.String,
+      parentThreadId: Schema.optionalKey(Schema.NullOr(Schema.String)),
+    }),
+  ),
+  nextCursor: Schema.NullOr(Schema.Int),
+});
+
+export interface NativeWatchRequestHandle {
+  /** The parsed request, or the refusal that replaced it. */
+  readonly request: Result.Result<NativeWatchRequest, NativeWatchRejection>;
+  /** The environment the request named, or "" when it named none. */
+  readonly environmentId: string;
+  /** Completes when stdin reaches EOF; the watch ends then. */
+  readonly closed: Deferred.Deferred<void>;
+}
+
+const findNewline = (chunk: Uint8Array): number => {
+  for (let index = 0; index < chunk.byteLength; index += 1) {
+    if (chunk[index] === 0x0a) return index;
+  }
+  return -1;
+};
+
+const concatBytes = (parts: ReadonlyArray<Uint8Array>): Uint8Array => {
+  const total = parts.reduce((sum, part) => sum + part.byteLength, 0);
+  const joined = new Uint8Array(total);
+  let offset = 0;
+  for (const part of parts) {
+    joined.set(part, offset);
+    offset += part.byteLength;
+  }
+  return joined;
+};
+
+/**
+ * Reads one bounded request line and then keeps draining stdin, so the parent
+ * can hold the pipe open for the life of the watch and close it to stop.
+ */
+export const readNativeWatchRequest = Effect.fn("cli.thread.nativeWatch.readRequest")(function* () {
+  const stdio = yield* Stdio.Stdio;
+  const outcome = yield* Deferred.make<Result.Result<NativeWatchRequest, NativeWatchRejection>>();
+  const closed = yield* Deferred.make<void>();
+  const parts: Array<Uint8Array> = [];
+  let buffered = 0;
+  let resolved = false;
+
+  const reader = Effect.gen(function* () {
+    yield* stdio.stdin.pipe(
+      Stream.runForEach((chunk: Uint8Array) =>
+        Effect.gen(function* () {
+          if (resolved) return;
+          const newline = findNewline(chunk);
+          if (newline === -1) {
+            buffered += chunk.byteLength;
+            if (buffered > NATIVE_WATCH_MAX_REQUEST_BYTES) {
+              resolved = true;
+              yield* Deferred.succeed(
+                outcome,
+                Result.fail(
+                  rejection(
+                    "request_too_large",
+                    `The request line exceeds the ${NATIVE_WATCH_MAX_REQUEST_BYTES}-byte limit.`,
+                  ),
+                ),
+              );
+              return;
+            }
+            parts.push(chunk);
+            return;
+          }
+          if (buffered + newline > NATIVE_WATCH_MAX_REQUEST_BYTES) {
+            resolved = true;
+            yield* Deferred.succeed(
+              outcome,
+              Result.fail(
+                rejection(
+                  "request_too_large",
+                  `The request line exceeds the ${NATIVE_WATCH_MAX_REQUEST_BYTES}-byte limit.`,
+                ),
+              ),
+            );
+            return;
+          }
