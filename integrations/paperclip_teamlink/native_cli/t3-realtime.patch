+/**
+ * Parses the one request line. Unknown fields, inexact ids, oversized input and
+ * duplicate ids are refused before any server call, so a malformed request never
+ * reaches the environment.
+ */
+export const parseNativeWatchRequest = (
+  line: string,
+): Result.Result<NativeWatchRequest, NativeWatchRejection> => {
+  if (Buffer.byteLength(line, "utf8") > NATIVE_WATCH_MAX_REQUEST_BYTES) {
+    return rejected(
+      "request_too_large",
+      `The request line exceeds the ${NATIVE_WATCH_MAX_REQUEST_BYTES}-byte limit.`,
+    );
+  }
+  const parsed = decodeJsonText(line);
+  if (Option.isNone(parsed)) {
+    return rejected("invalid_request", "The request line is not one JSON value.");
+  }
+  const value = parsed.value;
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return rejected("invalid_request", "The request must be one JSON object.");
+  }
+  const record = value as Record<string, unknown>;
+  for (const field of Object.keys(record)) {
+    if (!(NATIVE_WATCH_REQUEST_FIELDS as ReadonlyArray<string>).includes(field)) {
+      return rejected(
+        "invalid_request",
+        "The request carries a field this command does not accept.",
+      );
+    }
+  }
+  const environmentId = record.environmentId;
+  if (!isExactIdentifier(environmentId)) {
+    return rejected("invalid_request", "environmentId must be one exact non-empty string.");
+  }
+  const projectIds = record.projectIds;
+  if (
+    !Array.isArray(projectIds) ||
+    projectIds.length === 0 ||
+    projectIds.length > NATIVE_WATCH_MAX_PROJECTS ||
+    !projectIds.every(isExactIdentifier)
+  ) {
+    return rejected(
+      "invalid_request",
+      `projectIds must hold 1 to ${NATIVE_WATCH_MAX_PROJECTS} exact ids.`,
+    );
+  }
+  const threadIds = record.threadIds;
+  if (
+    !Array.isArray(threadIds) ||
+    threadIds.length === 0 ||
+    threadIds.length > NATIVE_WATCH_MAX_THREADS ||
+    !threadIds.every(isExactIdentifier)
+  ) {
+    return rejected(
+      "invalid_request",
+      `threadIds must hold 1 to ${NATIVE_WATCH_MAX_THREADS} exact ids.`,
+    );
+  }
+  if (new Set(projectIds).size !== projectIds.length) {
+    return rejected("invalid_request", "projectIds must not repeat an id.");
+  }
+  if (new Set(threadIds).size !== threadIds.length) {
+    return rejected("invalid_request", "threadIds must not repeat an id.");
+  }
+  return Result.succeed({ environmentId, projectIds, threadIds });
+};
+
+export const NativeWatchNotice = Schema.Struct({
+  schema: Schema.Literal(NATIVE_WATCH_SCHEMA),
+  type: Schema.Literals(["ready", "changed", "heartbeat", "error"]),
