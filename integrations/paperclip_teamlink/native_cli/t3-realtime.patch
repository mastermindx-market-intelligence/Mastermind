+export const classifyNativeWatchSubscriptionCause = (
+  cause: Cause.Cause<unknown>,
+): NativeWatchErrorCode => {
+  const errors = cause.reasons.filter(Cause.isFailReason).map((reason) => reason.error);
+  const tag = (value: unknown) =>
+    typeof value === "object" && value !== null ? (value as { _tag?: unknown })._tag : undefined;
+  if (
+    errors.some(
+      (error) =>
+        tag(error) === "EnvironmentAuthorizationError" ||
+        classifyNativeWatchBootstrapError(error) === "authorization_failed",
+    )
+  )
+    return "authorization_failed";
+  if (errors.some((error) => tag(error) === "OrchestrationV2GetThreadProjectionError")) {
+    return "qualification_failed";
+  }
+  if (Cause.hasInterruptsOnly(cause)) return "terminated";
+  if (Cause.hasDies(cause) || errors.length === 0) return "subscription_failed";
+  const transient = errors.every((error) => {
+    if (tag(error) !== "RpcClientError") return false;
+    const reason = (error as RpcClientError.RpcClientError).reason;
+    if (classifyNativeWatchBootstrapError(reason) === "authorization_failed") return false;
+    switch (reason._tag) {
+      case "SocketReadError":
+      case "SocketWriteError":
+        return true;
+      case "SocketOpenError":
+        return (
+          reason.kind === "Timeout" ||
+          classifyNativeWatchBootstrapError(reason.cause) === "connection_lost"
+        );
+      case "SocketCloseError":
+        return [1000, 1001, 1006, 1011, 1012, 1013].includes(reason.code);
+      default:
+        return false;
+    }
+  });
+  return transient ? "connection_lost" : "subscription_failed";
+};
