+/**
+ * Projects one server stream item onto notices. The snapshot establishes the
+ * subscription and the catch-up boundary, so `ready` follows it; later events
+ * only signal that something moved. A stale or repeated sequence is dropped.
+ */
+export const applyNativeWatchStreamItem = (
+  environmentId: string,
+  threadId: string,
+  state: NativeWatchThreadState,
+  item: NativeWatchStreamItem,
+): {
+  readonly state: NativeWatchThreadState;
+  readonly notices: ReadonlyArray<NativeWatchNotice>;
