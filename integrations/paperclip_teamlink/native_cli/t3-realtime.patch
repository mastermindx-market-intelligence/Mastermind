+/**
+ * Proves the exact environment and that every requested thread is a root thread
+ * of a requested project. A child thread, an unknown project and an unknown
+ * thread are refused before any subscription is opened.
+ */
+const qualifyNativeWatchTargets = Effect.fn("cli.thread.nativeWatch.qualify")(function* (
+  request: NativeWatchRequest,
+  tools: ThreadTools,
+) {
+  const environment: typeof EnvironmentReadResult.Type = yield* tools.call(
+    "t3_environment_read",
+    {},
+    EnvironmentReadResult,
+  );
+  if (environment.environmentId !== request.environmentId) {
+    return yield* new NativeWatchRefused({
+      code: "environment_mismatch",
+      detail: "The server's environment id differs from the requested one.",
+    });
+  }
+
+  const missingProjects = new Set(request.projectIds);
+  let projectCursor: number | null = 0;
+  for (let pageIndex = 0; pageIndex < NATIVE_WATCH_MAX_PROJECT_PAGES; pageIndex += 1) {
+    const page: typeof ProjectListResult.Type = yield* tools.call(
+      "t3_project_list",
+      { cursor: projectCursor, limit: 100 },
+      ProjectListResult,
+    );
+    for (const project of page.projects) missingProjects.delete(project.id);
+    if (missingProjects.size === 0) break;
+    if (page.nextCursor === null) {
+      return yield* new NativeWatchRefused({
+        code: "project_not_found",
+        detail: "A requested project is not bound to this environment.",
+      });
+    }
+    if (page.nextCursor <= projectCursor || pageIndex + 1 === NATIVE_WATCH_MAX_PROJECT_PAGES) {
+      return yield* new NativeWatchRefused({
+        code: "qualification_incomplete",
+        detail: "The bounded project inventory did not prove the requested projects.",
+      });
+    }
+    projectCursor = page.nextCursor;
+  }
+
+  const missingThreads = new Set(request.threadIds);
+  let incomplete = false;
+  for (const projectId of request.projectIds) {
+    if (missingThreads.size === 0) break;
+    let cursor = 0;
+    for (let pageIndex = 0; pageIndex < NATIVE_WATCH_MAX_THREAD_PAGES; pageIndex += 1) {
+      const result: typeof ThreadListResult.Type = yield* tools.call(
+        "t3_thread_list",
+        { projectId, includeSubagents: true, limit: 100, cursor },
+        ThreadListResult,
+      );
+      for (const thread of result.threads) {
+        if (!missingThreads.has(thread.threadId)) continue;
+        if (thread.projectId !== projectId) {
+          return yield* new NativeWatchRefused({
+            code: "qualification_failed",
+            detail: "The thread inventory returned an inconsistent project identity.",
+          });
+        }
+        if (thread.parentThreadId !== null) {
+          return yield* new NativeWatchRefused({
+            code: "thread_not_root",
+            detail: "A requested thread is not proven to be a root thread.",
+          });
+        }
+        missingThreads.delete(thread.threadId);
+      }
+      if (missingThreads.size === 0 || result.nextCursor === null) break;
+      if (result.nextCursor <= cursor) {
+        return yield* new NativeWatchRefused({
+          code: "qualification_incomplete",
+          detail: "The thread inventory cursor did not advance.",
+        });
+      }
+      if (pageIndex + 1 === NATIVE_WATCH_MAX_THREAD_PAGES) incomplete = true;
+      cursor = result.nextCursor;
+    }
+  }
+  if (missingThreads.size > 0) {
+    return yield* new NativeWatchRefused({
+      code: incomplete ? "qualification_incomplete" : "thread_not_found",
+      detail: incomplete
+        ? "The bounded thread inventory did not prove every requested root."
+        : "A requested thread is not in a requested project of this environment.",
+    });
+  }
+});
+
+const writeNativeWatchNotice = (notice: NativeWatchNotice) =>
+  Effect.flatMap(Stdio.Stdio, (stdio) =>
+    Stream.make(`${encodeNativeWatchNotice(notice)}\n`).pipe(
+      Stream.run(stdio.stdout({ endOnDone: false })),
+      // A dead reader cannot retain native credentials while stdout is blocked.
+      Effect.timeout("1 second"),
+    ),
+  );
+
+const writeNativeWatchNotices = Effect.fn("cli.thread.nativeWatch.write")(function* (
+  queue: Queue.Queue<NativeWatchNotice, Cause.Done>,
+) {
+  const exit = yield* Effect.exit(
+    Effect.gen(function* () {
+      for (;;) {
+        const first = yield* Queue.take(queue);
+        const batch: Array<NativeWatchNotice> = [first];
+        while (batch.length < NATIVE_WATCH_MAX_WRITE_BATCH) {
+          const next = yield* Queue.poll(queue);
+          if (Option.isNone(next)) break;
+          batch.push(next.value);
+        }
+        for (const notice of collapseNativeWatchNotices(batch)) {
+          yield* writeNativeWatchNotice(notice);
+        }
+      }
+    }),
+  );
+  // Ending the queue is the writer's normal exit; anything else is a defect.
+  if (Exit.isFailure(exit) && !Cause.isDone(Cause.squash(exit.cause))) {
+    return yield* Effect.die(exit.cause);
+  }
+});
