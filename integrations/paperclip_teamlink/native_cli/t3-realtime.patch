+ * readiness, changes and heartbeats until stdin closes, a signal arrives, the
+ * lifetime ends or the socket drops.
+ */
+const watchNativeThreads = Effect.fn("cli.thread.nativeWatch.watch")(function* (
+  request: NativeWatchRequest,
+  closed: Deferred.Deferred<void>,
+  origin: string,
+  emit: (notice: NativeWatchNotice) => Effect.Effect<boolean>,
+  openThreadStream: NativeWatchThreadOpener | undefined,
