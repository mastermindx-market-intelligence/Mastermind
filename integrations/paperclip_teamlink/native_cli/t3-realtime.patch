+class NativeWatchRefused extends Schema.TaggedError<NativeWatchRefused>()("NativeWatchRefused", {
+  code: Schema.Literals(NATIVE_WATCH_ERROR_CODES),
+  detail: Schema.String,
+}) {
+  override get message(): string {
+    return this.detail;
+  }
+}
+
+export interface NativeWatchRequest {
+  readonly environmentId: string;
+  readonly projectIds: ReadonlyArray<string>;
+  readonly threadIds: ReadonlyArray<string>;
+}
+
+export interface NativeWatchRejection {
+  readonly code: NativeWatchErrorCode;
+  readonly detail: string;
+}
