+/**
+ * Runs one watch. Every outcome, including a refusal, leaves the process
+ * through the notice stream.
+ */
+export const runNativeWatch = Effect.fn("cli.thread.nativeWatch")(function* (
+  request: NativeWatchRequest,
+  closed: Deferred.Deferred<void>,
+  tools: ThreadTools,
+  origin: string,
+  openThreadStream: NativeWatchThreadOpener | undefined = undefined,
+) {
+  const environmentId = request.environmentId;
+  const queue = yield* Queue.make<NativeWatchNotice, Cause.Done>({
+    capacity: NATIVE_WATCH_NOTICE_QUEUE_CAPACITY,
+    strategy: "suspend",
+  });
+  const writer = yield* Effect.forkScoped(writeNativeWatchNotices(queue), {
+    startImmediately: true,
+  });
+  const emit = (notice: NativeWatchNotice) => Queue.offer(queue, notice);
+
+  const finish = Effect.fn("cli.thread.nativeWatch.finish")(function* (code: NativeWatchErrorCode) {
+    yield* emit(nativeWatchErrorNotice(environmentId, code));
+    yield* Queue.end(queue);
+    yield* Fiber.join(writer);
+  });
+
+  yield* Effect.raceFirst(
+    Effect.gen(function* () {
+      const qualified = yield* qualifyNativeWatchTargets(request, tools).pipe(
+        Effect.asVoid,
+        Effect.catchTags({
+          NativeWatchRefused: (error) => Effect.succeed(error.code),
+          ThreadToolFailedError: () =>
+            Effect.succeed("qualification_failed" as NativeWatchErrorCode),
+          ThreadServerUnreachableError: (error) =>
+            Effect.succeed(classifyNativeWatchBootstrapError(error.cause)),
+        }),
+      );
+      if (qualified !== undefined) {
+        yield* finish(qualified);
+        return;
+      }
