+      const reason = yield* watchNativeThreads(
+        request,
+        closed,
+        origin,
+        emit,
+        openThreadStream,
+      ).pipe(
+        Effect.catchTags({ NativeWatchRefused: (error) => Effect.succeed(error.code) }),
+        Effect.catchCause((cause) => Effect.succeed(classifyNativeWatchSubscriptionCause(cause))),
+      );
+      yield* finish(reason);
+    }),
+    Fiber.join(writer),
+  );
+});
