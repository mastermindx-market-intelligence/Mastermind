+  yield* Effect.forkScoped(reader, { startImmediately: true });
+
+  const request = yield* Deferred.await(outcome);
+  const environmentId = Result.isSuccess(request) ? request.success.environmentId : "";
+  return { request, environmentId, closed } satisfies NativeWatchRequestHandle;
+});
