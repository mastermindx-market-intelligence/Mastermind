+/** The ways a native thread subscription can fail. */
+export type NativeWatchSubscriptionError =
+  | EnvironmentAuthorizationError
+  | OrchestrationV2GetThreadProjectionError
+  | RpcClientError.RpcClientError;
+
+/** Only an identified transient failure is eligible for a parent reconnect. */
+export const classifyNativeWatchBootstrapError = (cause: unknown): NativeWatchErrorCode => {
+  let current = cause;
+  let transport = false;
+  const seen = new Set<unknown>();
+  for (let depth = 0; depth < 8 && typeof current === "object" && current !== null; depth += 1) {
+    if (seen.has(current)) break;
+    seen.add(current);
+    const record = current as {
+      _tag?: unknown;
+      message?: unknown;
+      code?: unknown;
+      cause?: unknown;
+    };
+    if (record._tag === "EnvironmentAuthorizationError") return "authorization_failed";
+    if (record._tag === "AcpMcpBridgeError" && typeof record.message === "string") {
+      // This anchored format is produced by AcpMcpStdioBridge.send at the pinned source.
+      const status = /^T3 Code MCP endpoint responded with HTTP (\d{3})\.$/.exec(record.message);
+      if (status !== null)
+        return ["401", "403"].includes(status[1] ?? "")
+          ? "authorization_failed"
+          : "server_unreachable";
+    }
+    if (
+      typeof record.code === "string" &&
+      [
+        "ECONNREFUSED",
+        "ECONNRESET",
+        "ETIMEDOUT",
+        "EHOSTUNREACH",
+        "ENETUNREACH",
+        "EPIPE",
+        "UND_ERR_CONNECT_TIMEOUT",
+        "UND_ERR_SOCKET",
+      ].includes(record.code)
+    )
