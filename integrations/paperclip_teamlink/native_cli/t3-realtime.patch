+    return yield* watchNativeThreadsWith(request, closed, emit, openThreadStream).pipe(
+      Effect.provideService(References.MinimumLogLevel, "Error"),
+    );
+  }
+  const ticket = yield* environmentAuth
+    .issueWebSocketTicket({ sessionId: session.sessionId }, { use: "rpc" })
+    .pipe(
+      Effect.mapError(
+        () =>
+          new NativeWatchRefused({
+            code: "session_failed",
+            detail: "The native socket ticket could not be issued.",
+          }),
+      ),
+    );
