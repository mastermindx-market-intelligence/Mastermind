+/** Writes one refusal notice without a watch, for failures that happen first. */
+export const emitNativeWatchErrorNotice = (environmentId: string, code: NativeWatchErrorCode) =>
+  writeNativeWatchNotice(nativeWatchErrorNotice(environmentId, code));
