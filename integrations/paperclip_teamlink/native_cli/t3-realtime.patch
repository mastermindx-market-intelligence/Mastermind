+const NATIVE_WATCH_REQUEST_FIELDS = ["environmentId", "projectIds", "threadIds"] as const;
+
+/** An exact id: present, non-empty, and carrying no surrounding whitespace. */
+const isExactIdentifier = (value: unknown): value is string =>
+  typeof value === "string" && value.length > 0 && value.trim() === value;
+
+const rejected = (
+  code: NativeWatchErrorCode,
+  detail: string,
+): Result.Result<NativeWatchRequest, NativeWatchRejection> => Result.fail({ code, detail });
+
+const rejection = (code: NativeWatchErrorCode, detail: string): NativeWatchRejection => ({
+  code,
+  detail,
+});
