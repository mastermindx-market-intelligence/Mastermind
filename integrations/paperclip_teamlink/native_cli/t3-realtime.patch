+const NATIVE_WATCH_ERROR_CODES = [
+  "invalid_request",
+  "request_too_large",
+  "environment_mismatch",
+  "project_not_found",
+  "thread_not_found",
+  "thread_not_root",
+  "qualification_failed",
+  "qualification_incomplete",
+  "authorization_failed",
+  "connection_lost",
+  "server_unreachable",
+  "session_failed",
+  "subscription_failed",
+  "subscription_closed",
+  "stdin_closed",
+  "lifetime_expired",
+  "terminated",
