+/**
+ * `thread native` forwards one MCP tool call to the running server and prints
+ * its envelope verbatim. The allowlist is closed: secrets, auth, scheduling,
+ * projects, previews, and workspaces stay with their own owners.
+ */
+const NATIVE_TOOL_ALLOWLIST = [
+  "t3_environment_read",
+  "orchestrator_capabilities",
+  "t3_project_list",
+  "t3_thread_list",
+  "t3_thread_read",
+  "t3_thread_launch",
+  "t3_thread_send",
+  "t3_thread_wait",
+  "t3_thread_interrupt",
+  "t3_thread_configure",
+  "t3_thread_organize",
+  "t3_queue",
+  "t3_pending_request",
+] as const satisfies ReadonlyArray<string>;
+const nativeToolNames = new Set<string>(NATIVE_TOOL_ALLOWLIST);
+
+/** New runs through `native` name their provider explicitly; project defaults are never inherited. */
+const NATIVE_PROVIDER_INSTANCE = "capacity_fabric";
+const NATIVE_SELECTION_TOOLS = new Set(["t3_thread_launch", "t3_thread_configure"]);
+
+/** Room for the server's largest single argument (120 000 characters), and nothing more. */
+const NATIVE_ARGS_MAX_BYTES = 256 * 1024;
+
+const readNativeArguments = Effect.fn("cli.thread.readNativeArguments")(function* (tool: string) {
+  const stdio = yield* Stdio.Stdio;
+  const state = yield* stdio.stdin.pipe(
+    Stream.runFold(
+      () => ({ bytes: 0, chunks: [] as Array<Uint8Array>, overflow: false }),
+      (state, chunk) => {
+        if (state.overflow || state.bytes + chunk.byteLength > NATIVE_ARGS_MAX_BYTES) {
+          state.overflow = true;
+        } else {
+          state.chunks.push(chunk);
+          state.bytes += chunk.byteLength;
+        }
+        return state;
+      },
+    ),
+    Effect.mapError(
+      (cause) =>
+        new ThreadUsageError({
+          detail: `Could not read stdin: ${cause instanceof Error ? cause.message : String(cause)}`,
+        }),
+    ),
+  );
+  if (state.overflow) {
+    return yield* new ThreadUsageError({
+      detail: `'${tool}' arguments exceed the ${NATIVE_ARGS_MAX_BYTES}-byte stdin limit.`,
+    });
+  }
+  const parsed = Option.filter(
+    decodeJsonText(Buffer.concat(state.chunks).toString("utf8")),
+    (value): value is Record<string, unknown> =>
+      typeof value === "object" && value !== null && !Array.isArray(value),
+  );
+  if (Option.isNone(parsed)) {
+    return yield* new ThreadUsageError({
+      detail: `Pass '${tool}' arguments as one JSON object on stdin.`,
+    });
+  }
+  return parsed.value;
+});
+
+const guardNativeProviderSelection = Effect.fn("cli.thread.guardNativeProviderSelection")(
+  function* (tool: string, args: Record<string, unknown>) {
+    if (!NATIVE_SELECTION_TOOLS.has(tool)) return;
