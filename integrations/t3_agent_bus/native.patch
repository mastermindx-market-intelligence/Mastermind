+
+const allowlistedEntry = (name: string) => ({
+  name,
+  description: `${name} description`,
+  inputSchema: { type: "object" as const, properties: { threadId: { type: "string" } } },
+  annotations: { title: name, readOnlyHint: name === "t3_environment_read" },
+});
+
+const catalogSession = (pages: ReadonlyArray<unknown>) => {
+  const queue = [...pages];
+  const requests: Array<{ readonly cursor?: string }> = [];
+  const session = {
+    call: () => Effect.die("unexpected tools/call"),
+    listTools: (params: { readonly cursor?: string } = {}) => {
+      requests.push(params);
+      const page = queue.shift();
+      return page === undefined ? Effect.die("unscripted tools/list page") : Effect.succeed(page);
+    },
+  } satisfies McpToolSession;
+  return { session, requests };
+};
+
+it.effect("native-catalog follows pages and keeps only allowlisted schemas verbatim", () =>
+  Effect.gen(function* () {
+    const projectCreate = { name: "t3_project_create", inputSchema: { type: "object" } };
+    const nameless = { description: "no name" };
+    const secret = { name: "request_secret" };
+    const queue = allowlistedEntry("t3_queue");
+    const environment = allowlistedEntry("t3_environment_read");
+    const { session, requests } = catalogSession([
+      { tools: [queue, projectCreate, nameless], nextCursor: "page-2" },
+      { tools: [secret, environment] },
+    ]);
+
+    const catalog = yield* readNativeCatalog(session);
+
+    assert.deepStrictEqual(catalog, [queue, environment]);
+    assert.deepStrictEqual(requests, [{}, { cursor: "page-2" }]);
+  }),
+);
+
+it.effect("native-catalog stops at its page bound instead of looping forever", () =>
+  Effect.gen(function* () {
+    const { session, requests } = catalogSession(
+      Array.from({ length: 20 }, (_, index) => ({
+        tools: [{ name: `filtered-${index}` }],
+        nextCursor: `page-${index + 1}`,
+      })),
+    );
+
+    const failure = yield* failWith(readNativeCatalog(session));
+
+    assert.strictEqual(failureTag(failure), "ThreadToolFailedError");
+    assert.isTrue(failureDetail(failure).includes("exceeded 8 pages"));
+    assert.lengthOf(requests, 8);
+  }),
+);
+
+it.effect("native-catalog stops at its tool-count bound on an oversized catalog", () =>
+  Effect.gen(function* () {
+    const filler = Array.from({ length: 201 }, (_, index) => ({ name: `filler-${index}` }));
+    const { session } = catalogSession([{ tools: filler }]);
+
+    const failure = yield* failWith(readNativeCatalog(session));
+
+    assert.isTrue(failureDetail(failure).includes("exceeded 200 tools"));
+  }),
+);
+
