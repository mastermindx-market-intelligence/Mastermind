+import * as NodeChildProcessSpawner from "@effect/platform-node/NodeChildProcessSpawner";
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem";
+import * as NodePath from "@effect/platform-node/NodePath";
+import * as NodeTerminal from "@effect/platform-node/NodeTerminal";
+import { assert, it } from "@effect/vitest";
+import { AuthSessionId } from "@t3tools/contracts";
+import * as NetService from "@t3tools/shared/Net";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as DateTime from "effect/DateTime";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Result from "effect/Result";
+import * as Stdio from "effect/Stdio";
+import * as Stream from "effect/Stream";
+import * as TestConsole from "effect/testing/TestConsole";
+import { Command } from "effect/cli";
+import { beforeEach, vi } from "vite-plus/test";
+
+import * as McpBridge from "../mcp/AcpMcpStdioBridge.ts";
+import type { McpToolSession } from "../mcp/AcpMcpStdioBridge.ts";
+import {
+  makePersistedServerRuntimeState,
+  persistServerRuntimeState,
+} from "../serverRuntimeState.ts";
+import { readNativeCatalog, threadCommand } from "./thread.ts";
+
+const auth = vi.hoisted(() => ({ issues: 0, revokes: 0 }));
+
+vi.mock("../auth/EnvironmentAuth.ts", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("../auth/EnvironmentAuth.ts")>();
+  return {
+    ...actual,
+    layerRuntime: Layer.mock(actual.EnvironmentAuth)({
+      issueMcpClientSession: () =>
+        Effect.map(DateTime.now, (expiresAt) => {
+          auth.issues += 1;
+          return {
+            sessionId: AuthSessionId.make("test-session"),
+            token: "synthetic-token",
+            expiresAt,
+          };
+        }),
+      revokeSession: () =>
+        Effect.sync(() => {
+          auth.revokes += 1;
+          return true;
+        }),
+    }),
+  };
+});
+
+beforeEach(() => {
+  auth.issues = 0;
+  auth.revokes = 0;
+});
+
+const encoder = new TextEncoder();
+
+// NodeServices.layer would pin Stdio to the real process stdin; these pieces leave Stdio free.
+const cliLayers = Layer.mergeAll(
+  NodeFileSystem.layer,
+  NodePath.layer,
+  NodeTerminal.layer,
+  NodeCrypto.layer,
+  NetService.layer,
+  ConfigProvider.layer(ConfigProvider.fromEnv({ env: { T3CODE_PORT: "3773" } })),
+);
+
+const makeBaseDir = Effect.fn("threadNativeTest.makeBaseDir")(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const root = yield* fs
+    .makeTempDirectoryScoped({ prefix: "t3-thread-native-" })
+    .pipe(Effect.flatMap((directory) => fs.realPath(directory)));
+  const baseDir = path.join(root, "state");
+  yield* persistServerRuntimeState({
+    path: path.join(baseDir, "userdata", "server-runtime.json"),
+    state: yield* makePersistedServerRuntimeState({
+      config: { host: "127.0.0.1", devUrl: undefined },
+      port: 3_773,
+    }),
+  });
+  return baseDir;
+});
+
+const runNative = (baseDir: string, tool: string, environment?: string) =>
+  Command.runWith(threadCommand, { version: "0.0.0" })([
+    "native",
+    tool,
+    ...(environment === undefined ? [] : ["--expected-environment-id", environment]),
+    "--json",
+    "--base-dir",
+    baseDir,
+  ]);
+
+const provideCli = <A, E, R>(effect: Effect.Effect<A, E, R>, stdin: string) =>
+  effect.pipe(
+    Effect.scoped,
+    Effect.provide(
+      Layer.provideMerge(
+        NodeChildProcessSpawner.layer,
+        Layer.mergeAll(cliLayers, Stdio.layerTest({ stdin: Stream.make(encoder.encode(stdin)) })),
+      ),
+    ),
+  );
+
+/** TestConsole.logLines entries are unknown; the CLI only ever logs JSON strings. */
+const lastLoggedLine = Effect.map(TestConsole.logLines, (lines) => String(lines.at(-1) ?? ""));
+
+/** Runs to a Result and hands back the failure, dying when the command succeeds. */
+const failWith = <A, E>(effect: Effect.Effect<A, E, never>) =>
+  Effect.flatMap(Effect.result(effect), (result) =>
+    Result.isSuccess(result)
+      ? Effect.die("expected this command to fail")
+      : Effect.succeed(Option.getOrThrow(Result.getFailure(result))),
+  );
+
+const failureTag = (failure: unknown) => (failure as { _tag: string })._tag;
+const failureDetail = (failure: unknown) => (failure as { detail: string }).detail;
+
+/** One session whose single call the test scripts; records what it was asked. */
+const scriptSession = (behavior: {
+  readonly result?: unknown;
+  readonly failure?: McpBridge.AcpMcpBridgeError;
+  readonly suspend?: Deferred.Deferred<void>;
+}) => {
+  const calls: Array<{ readonly tool: string; readonly args: unknown }> = [];
+  const session = {
+    call: (tool: string, args: Readonly<Record<string, unknown>>) => {
+      calls.push({ tool, args });
+      if (behavior.failure !== undefined) return Effect.fail(behavior.failure);
+      if (behavior.suspend !== undefined) {
+        return Effect.andThen(Deferred.succeed(behavior.suspend, void 0), Effect.never);
+      }
+      return Effect.succeed(behavior.result);
+    },
+    listTools: () => Effect.die("unexpected tools/list call"),
+  } satisfies McpToolSession;
+  return { session, calls };
+};
+
+it.effect("native rejects a known but non-allowlisted tool before any session", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    using session = vi.spyOn(McpBridge, "mcpToolSession");
+    const failure = yield* failWith(provideCli(runNative(baseDir, "t3_project_create"), "{}"));
+    assert.strictEqual(failureTag(failure), "ThreadUsageError");
+    assert.isTrue(failureDetail(failure).includes("not allowlisted"));
+    assert.lengthOf(session.mock.calls, 0);
+    assert.strictEqual(auth.issues, 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native rejects an unknown tool name before any session", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    using session = vi.spyOn(McpBridge, "mcpToolSession");
+    const failure = yield* failWith(provideCli(runNative(baseDir, "definitely_not_a_tool"), "{}"));
+    assert.isTrue(failureDetail(failure).includes("not allowlisted"));
+    assert.lengthOf(session.mock.calls, 0);
+    assert.strictEqual(auth.issues, 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native rejects malformed stdin JSON without contacting the server", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    using session = vi.spyOn(McpBridge, "mcpToolSession");
+    const failure = yield* failWith(
+      provideCli(runNative(baseDir, "t3_thread_read"), `{"threadId": `),
+    );
+    assert.strictEqual(failureTag(failure), "ThreadUsageError");
+    assert.isTrue(failureDetail(failure).includes("one JSON object"));
+    assert.lengthOf(session.mock.calls, 0);
+    assert.strictEqual(auth.issues, 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native rejects stdin past its byte cap without contacting the server", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    using session = vi.spyOn(McpBridge, "mcpToolSession");
+    const failure = yield* failWith(
+      provideCli(runNative(baseDir, "t3_thread_read"), `{"text": "${"x".repeat(300_000)}"}`),
+    );
+    assert.isTrue(failureDetail(failure).includes("262144-byte stdin limit"));
+    assert.lengthOf(session.mock.calls, 0);
+    assert.strictEqual(auth.issues, 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native rejects a JSON array instead of an arguments object", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    using session = vi.spyOn(McpBridge, "mcpToolSession");
+    const failure = yield* failWith(provideCli(runNative(baseDir, "t3_queue"), "[1, 2]"));
+    assert.isTrue(failureDetail(failure).includes("one JSON object"));
+    assert.lengthOf(session.mock.calls, 0);
+    assert.strictEqual(auth.issues, 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native prints the server's success envelope unchanged", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    const envelope = {
+      structuredContent: { environmentId: "env-1", label: "Studio" },
+      content: [{ type: "text", text: '{"environmentId":"env-1"}' }],
+      extraField: { kept: true },
+    };
+    const { session, calls } = scriptSession({ result: envelope });
+    using _session = vi.spyOn(McpBridge, "mcpToolSession").mockReturnValue(Effect.succeed(session));
+
+    yield* provideCli(runNative(baseDir, "t3_environment_read"), "{}");
+
+    assert.deepStrictEqual(calls, [{ tool: "t3_environment_read", args: {} }]);
+    assert.deepStrictEqual(JSON.parse(yield* lastLoggedLine), envelope);
+    assert.strictEqual(auth.issues, 1);
+    assert.strictEqual(auth.revokes, 1);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native prints the server's error envelope for missing required args, unchanged", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    const envelope = {
+      isError: true,
+      content: [{ type: "text", text: `{"message":"t3_thread_read requires threadId"}` }],
+    };
+    const { session, calls } = scriptSession({ result: envelope });
+    using _session = vi.spyOn(McpBridge, "mcpToolSession").mockReturnValue(Effect.succeed(session));
+
+    yield* provideCli(runNative(baseDir, "t3_thread_read"), "{}");
+
+    assert.deepStrictEqual(calls, [{ tool: "t3_thread_read", args: {} }]);
+    assert.deepStrictEqual(JSON.parse(yield* lastLoggedLine), envelope);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native makes exactly one call and fails plainly when transport fails", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    const before = (yield* TestConsole.logLines).length;
+    const { session, calls } = scriptSession({
+      failure: new McpBridge.AcpMcpBridgeError({ message: "HTTP 500." }),
+    });
+    using _session = vi.spyOn(McpBridge, "mcpToolSession").mockReturnValue(Effect.succeed(session));
+
+    const failure = yield* failWith(provideCli(runNative(baseDir, "t3_thread_list"), "{}"));
+
+    assert.strictEqual(failureTag(failure), "ThreadToolFailedError");
+    assert.lengthOf(calls, 1);
+    assert.lengthOf((yield* TestConsole.logLines).slice(before), 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native interrupts the one call and still revokes its session", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    const before = (yield* TestConsole.logLines).length;
+    const started = yield* Deferred.make<void>();
+    const { session } = scriptSession({ suspend: started });
+    using _session = vi.spyOn(McpBridge, "mcpToolSession").mockReturnValue(Effect.succeed(session));
+
+    const fiber = yield* Effect.forkChild(provideCli(runNative(baseDir, "t3_thread_list"), "{}"));
+    yield* Deferred.await(started);
+    yield* Fiber.interrupt(fiber);
+
+    assert.strictEqual(auth.revokes, 1);
+    assert.lengthOf((yield* TestConsole.logLines).slice(before), 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native refuses t3_thread_launch that would inherit a provider default", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    using session = vi.spyOn(McpBridge, "mcpToolSession");
+    const failure = yield* failWith(
+      provideCli(
+        runNative(baseDir, "t3_thread_launch"),
+        `{"projectId": "p", "title": "T", "message": "m"}`,
+      ),
+    );
+    assert.isTrue(failureDetail(failure).includes("capacity_fabric"));
+    assert.lengthOf(session.mock.calls, 0);
+    assert.strictEqual(auth.issues, 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native refuses a modelSelection naming any other provider instance", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    using session = vi.spyOn(McpBridge, "mcpToolSession");
+    const args = JSON.stringify({
+      modelSelection: { instanceId: "glm2_direct", model: "glm-5.3" },
+    });
+
+    const launch = yield* failWith(provideCli(runNative(baseDir, "t3_thread_launch"), args));
+    assert.isTrue(failureDetail(launch).includes("capacity_fabric"));
+
+    const configure = yield* failWith(provideCli(runNative(baseDir, "t3_thread_configure"), args));
+    assert.isTrue(failureDetail(configure).includes("capacity_fabric"));
+    assert.lengthOf(session.mock.calls, 0);
+    assert.strictEqual(auth.issues, 0);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
+);
+
+it.effect("native forwards an explicit capacity_fabric selection and reads without one", () =>
+  Effect.gen(function* () {
+    const baseDir = yield* makeBaseDir();
+    const { session, calls } = scriptSession({ result: { structuredContent: {} } });
+    using _session = vi.spyOn(McpBridge, "mcpToolSession").mockReturnValue(Effect.succeed(session));
+
+    const launchArgs = {
+      projectId: "p",
+      title: "T",
+      message: "m",
+      modelSelection: { instanceId: "capacity_fabric", model: "model-x" },
+    };
+    yield* provideCli(runNative(baseDir, "t3_thread_launch"), JSON.stringify(launchArgs));
+    yield* provideCli(runNative(baseDir, "t3_thread_configure"), `{"threadId": "t"}`);
+
+    assert.deepStrictEqual(calls, [
+      { tool: "t3_thread_launch", args: launchArgs },
+      { tool: "t3_thread_configure", args: { threadId: "t" } },
+    ]);
+    assert.strictEqual(auth.issues, 2);
+    assert.strictEqual(auth.revokes, 2);
+  }).pipe(Effect.scoped, Effect.provide(cliLayers)),
