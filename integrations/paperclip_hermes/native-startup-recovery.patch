+    monkeypatch.setattr(start, "start_gateway_job", spawn if backend == "native_job" else forbidden)
+    monkeypatch.setattr(start.subprocess, "Popen", spawn if backend == "popen" else forbidden)
+    assert start.spawn_unmanaged_gateway(tmp_path, deadline=time.monotonic() + 5) is child
+    assert len(captured) == 1
+    assert SETTING not in captured[0]
+    assert captured[0]["RUNTIME_TEST_SENTINEL"] == "retained"
+    assert os.environ[SETTING] == "900"
