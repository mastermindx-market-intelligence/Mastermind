+@pytest.mark.platforms("posix")
+def test_inconclusive_manager_probe_keeps_normal_activation(tmp_path, request):
+    """A transient checker failure warns without inventing a source update."""
+    root, _store_python, _worker_command = request.getfixturevalue("source_launch")
+    launch_python = request.getfixturevalue("isolated_python")
+    repository = Path(__file__).resolve().parents[2]
+    shutil.copy2(repository / "hermes_bootstrap.py", root / "hermes_bootstrap.py")
+    (root / "launch_test_tools.py").write_text(
+        "import sys\n"
+        f"sys.path.insert(1, {str(repository)!r})\n"
+        "from hermes_cli import venv_sync\n"
+        "from pm.runtime import RuntimeProbeUnavailable\n"
+        "def unavailable(*args, **kwargs):\n"
+        "    raise RuntimeProbeUnavailable('pm-runtime', 'validation timed out after 30 seconds', "
+        "'retry when the host is responsive')\n"
+        "venv_sync.prepare_launch = unavailable\n",
+        encoding="utf-8",
+    )
+    entry = root / "launch_probe.py"
+    entry.write_text(
+        "import launch_test_tools\n"
+        "import hermes_bootstrap\n"
+        "import json, sys\n"
+        "print(json.dumps({'executable': sys.executable, 'args': sys.argv[1:]}))\n",
+        encoding="utf-8",
+    )
+    pm.sync_venv(["all"], explicit=True, project_root=root)
+    previous = _fact(root)
+    before_receipts = _receipts(tmp_path)
+    pending = venv_sync.completion_pending_path(root)
+    assert not pending.exists()
+
+    result = subprocess.run(
+        [str(launch_python), str(entry)], cwd=root,
+        env=dict(os.environ), capture_output=True, text=True, timeout=60, check=False,
+    )
+
+    assert result.returncode == 0, result.stderr
+    assert json.loads(result.stdout) == {"executable": str(launch_python), "args": []}
+    assert _fact(root) == previous
+    assert _receipts(tmp_path) == before_receipts
+    assert not pending.exists()
+    assert "validation timed out" in result.stderr
+    assert "continuing with the selected dependencies" in result.stderr
+    assert "source-update completion failed" not in result.stderr
+    assert "hermes update" not in result.stderr
