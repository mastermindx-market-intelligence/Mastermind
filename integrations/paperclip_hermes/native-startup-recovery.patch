+    return json.dumps({"ok": True, "protocol": 1, "id": 1, "result": {
+        "profile_id": endpoint.profile_id, "instance_id": endpoint.instance_id,
+        "runtime_protocol": 1, "ticket": "private-fixture-ticket",
+    }}).encode() + b"\n"
