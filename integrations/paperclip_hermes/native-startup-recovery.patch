+        monkeypatch.setenv(SETTING, override)
+    if remote is not None:
+        monkeypatch.setenv("HERMES_TUI_GATEWAY_URL", remote)
+    monkeypatch.setattr(connection, "time", SimpleNamespace(monotonic=lambda: 100))
+    viewer = connection.GatewayConnection()
+    viewer._thread = SimpleNamespace(is_alive=lambda: True)
+    waits = []
