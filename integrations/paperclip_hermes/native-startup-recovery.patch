+    ("invalid-local-budget", 5, None, 5),
+    ("invalid-local-budget", None, "ws://localhost/api/ws", 90),
+    ("invalid-local-budget", None, "invalid-explicit-remote", 90),
+])
+def test_classic_wait_shares_startup_budget_and_preserves_explicit_deadline(
+    monkeypatch, override, explicit, remote, expected,
+):
