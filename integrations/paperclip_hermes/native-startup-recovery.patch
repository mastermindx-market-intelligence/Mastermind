+"""Gateway lifecycle refusals keep their native diagnostics before submission."""
+import pytest
+
+from hermes_cli.cli_chat_error_copy import agent_init_failure_message
+from hermes_cli.gateway_client import GatewayUnavailableError
+
+
+@pytest.mark.parametrize("message,state,reason", [
+    ("Gateway draining: update_paused.", "draining", "update_paused"),
+    ("Gateway starting: deadline.", "starting", "deadline"),
+    ("Gateway inaccessible: runtime_exited.\nCheck the startup log, then run hermes gateway ensure.",
