+++ b/tests/pm/test_runtime_probe_uncertainty.py
@@ -0,0 +1,105 @@
+"""An inconclusive manager probe must not create an application update obligation."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.fixture
+def selected_manager(tmp_path, monkeypatch):
+    from pm import client, paths, runtime
+    from pm.environments import install_state_dir
+
+    project = tmp_path / "checkout"
+    (project / ".git").mkdir(parents=True)
+    (project / "pyproject.toml").write_text("[project]\nname='example'\n", encoding="utf-8")
+    (project / "uv.lock").write_text("version = 1\n", encoding="utf-8")
+    (project / "install-stamp.json").write_text(
+        json.dumps({"updateMechanism": "self", "dirty": True}), encoding="utf-8",
+    )
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "home"))
+    monkeypatch.setenv("HERMES_RUNTIME_DIR", str(tmp_path / "tools"))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.delenv("HERMES_DISABLE_LAZY_INSTALLS", raising=False)
+    monkeypatch.setattr(paths, "repo_root", lambda: project)
+    monkeypatch.setattr(client, "is_runtime", lambda: False)
+    monkeypatch.setattr(runtime, "is_runtime", lambda: False)
+    monkeypatch.setattr(runtime, "_resident_runtime", lambda: None)
+    tools = (tmp_path / "uv", Path(sys.executable))
+    monkeypatch.setattr("pm._uv._toolchain", lambda **kwargs: tools)
+    manager = install_state_dir(project) / "pm-runtime"
+    previous = manager / "generations" / "previous"
+    previous.mkdir(parents=True)
+    identity = runtime._inputs(Path(runtime.__file__).parent, tools[1])
+    (previous / "pm-runtime.json").write_text(json.dumps({"inputs": identity}), encoding="utf-8")
+    selected = manager / "selected.json"
+    selected.write_text(json.dumps({"inputs": identity, "generation": "generations/previous"}), encoding="utf-8")
+    return project, manager, previous, selected, tools
+
+
+def _inconclusive(monkeypatch, failure):
+    from pm import runtime
+
+    def probe(command, **kwargs):
+        if failure == "timeout":
+            raise subprocess.TimeoutExpired(command, kwargs["timeout"])
+        return subprocess.CompletedProcess(command, -9, stdout="", stderr="")
+
+    monkeypatch.setattr(runtime.subprocess, "run", probe)
+
+    def stage(*args, **kwargs):
+        pytest.fail("An inconclusive probe attempted to stage a replacement manager")
+
+    monkeypatch.setattr("pm.runtime_stage.stage_runtime", stage)
+
+
+@pytest.mark.parametrize("bootstrap", [False, True])
+@pytest.mark.parametrize("failure", ["timeout", "signal"])
+def test_inconclusive_probe_preserves_selected_manager(selected_manager, monkeypatch, bootstrap, failure):
+    from pm import runtime
+    from pm.package import InstallError
+
+    _project, manager, previous, selected, tools = selected_manager
+    before = selected.read_bytes()
+    _inconclusive(monkeypatch, failure)
+
+    with pytest.raises(InstallError, match="validation (timed out|was interrupted)"):
+        runtime.prepare_runtime(*tools, manager, bootstrap=bootstrap)
+
+    assert selected.read_bytes() == before
+    assert list((manager / "generations").iterdir()) == [previous]
+    # A later successful probe can acquire the same lock and reuse the committed generation.
+    monkeypatch.setattr(runtime, "_validate", lambda python, env: "")
+    assert runtime.prepare_runtime(*tools, manager, bootstrap=False) == runtime._python(previous)
+    assert selected.read_bytes() == before
+
+
+@pytest.mark.parametrize("existing_debt", [False, True])
+@pytest.mark.parametrize("failure", ["timeout", "signal"])
+def test_public_probe_cannot_arm_source_completion(selected_manager, monkeypatch, existing_debt, failure):
+    from hermes_cli import venv_sync
+    from pm import client
+    from pm.package import InstallError
+
+    project, manager, previous, selected, _tools = selected_manager
+    pending = venv_sync.completion_pending_path(project)
+    attempts = pending.with_name("source-completion-attempts")
+    if existing_debt:
+        pending.parent.mkdir(parents=True, exist_ok=True)
+        pending.write_bytes(b"existing update obligation\n")
+        attempts.write_bytes(b"existing retry accounting\n")
+    before = {p: p.read_bytes() if p.exists() else None for p in [selected, pending, attempts]}
+    _inconclusive(monkeypatch, failure)
+
+    # Exercise the actual public client -> runtime_command -> selected-runtime probe.
+    with pytest.raises(InstallError, match="validation (timed out|was interrupted)"):
+        client.venv_is_current(project_root=project)
+    with pytest.raises(InstallError, match="validation (timed out|was interrupted)"):
+        venv_sync.prepare_launch(project, ["chat", "-q", "fixture"])
+
+    assert {p: p.read_bytes() if p.exists() else None for p in before} == before
+    assert list((manager / "generations").iterdir()) == [previous]
