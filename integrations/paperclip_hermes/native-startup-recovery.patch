+"""Native client readiness budgets preserve gateway ownership and remote routing."""
+from types import SimpleNamespace
+import socket
+
+import pytest
+
+from hermes_cli import gateway_client as client
+from hermes_cli import gateway_connection as connection
+from hermes_cli import gateway_runtime as runtime
+
+SETTING = "HERMES_GATEWAY_STARTUP_TIMEOUT_SECONDS"
+
+
+@pytest.fixture(autouse=True)
+def isolated_gateway_selection(monkeypatch):
+    monkeypatch.delenv(SETTING, raising=False)
+    monkeypatch.delenv("HERMES_TUI_GATEWAY_URL", raising=False)
+
+
+@pytest.mark.parametrize("raw,expected", [(None, 60), ("0.5", 0.5), ("60", 60), ("900", 900)])
+def test_startup_budget_is_bounded_and_opt_in(monkeypatch, raw, expected):
+    if raw is not None:
+        monkeypatch.setenv(SETTING, raw)
+    assert client.gateway_startup_timeout() == expected
+
+
+@pytest.mark.parametrize("raw", ["0", "-1", "900.001", "nan", "inf", "-inf", "", "private-do-not-echo"])
+def test_invalid_startup_budget_fails_without_echoing_input(monkeypatch, raw):
+    monkeypatch.setenv(SETTING, raw)
+    with pytest.raises(client.GatewayClientError, match=SETTING) as caught:
+        client.gateway_startup_timeout()
+    assert "private-do-not-echo" not in str(caught.value)
+
+
+@pytest.mark.parametrize("remote", ["ws://localhost/api/ws", "invalid-explicit-remote"])
+def test_explicit_remote_ignores_local_startup_override(monkeypatch, remote):
+    monkeypatch.setenv(SETTING, "private-do-not-echo")
+    monkeypatch.setenv("HERMES_TUI_GATEWAY_URL", remote)
+    assert client.gateway_startup_timeout() == 60
+
+
+@pytest.mark.parametrize("state,reason", [("starting", "deadline"), ("draining", "update_paused")])
+@pytest.mark.asyncio
+async def test_local_ensure_gets_one_budget_and_keeps_native_refusal(monkeypatch, tmp_path, state, reason):
+    monkeypatch.setenv(SETTING, "900")
+    monkeypatch.setenv("HERMES_TUI_GATEWAY_URL", "   ")
+    monkeypatch.setattr(runtime, "gateway_profile_home", lambda home: tmp_path)
+    calls = []
+
+    def ensure(home, **kwargs):
+        calls.append((home, kwargs))
+        return SimpleNamespace(state=state, reason_code=reason, endpoint=None, detail=None)
+
+    monkeypatch.setattr(runtime, "ensure_gateway_runtime", ensure)
+    with pytest.raises(client.GatewayUnavailableError) as caught:
+        async with client.connect_gateway():
+            pytest.fail("A native refusal must never open a chat connection")
+    assert calls == [(tmp_path, {"timeout": 900, "idle_exit": True})]
+    assert (caught.value.state, caught.value.reason_code) == (state, reason)
+
+
+@pytest.mark.parametrize("override,explicit,remote,expected", [
+    (None, None, None, 90),
