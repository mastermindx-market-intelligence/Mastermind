+    monkeypatch.setenv(SETTING, "invalid-local-budget")
+    monkeypatch.setattr(runtime, "gateway_profile_home", lambda home: tmp_path)
+    monkeypatch.setattr(client, "_session_ticket", lambda *args, **kwargs: "private-test-ticket")
+    endpoint = SimpleNamespace(api_origin="http://localhost")
+    calls = []
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("An explicit endpoint must not ensure a local owner")
+
+    def unavailable(url, **kwargs):
+        calls.append(url)
+        raise OSError("fixture endpoint unavailable")
+
+    monkeypatch.setattr(runtime, "ensure_gateway_runtime", forbidden)
+    monkeypatch.setattr(websocket_client, "connect", unavailable)
+    with pytest.raises(client.GatewayClientError, match="no local fallback"):
+        async with client.connect_gateway(endpoint=endpoint):
+            pytest.fail("Unavailable endpoint unexpectedly connected")
+    assert calls == ["ws://localhost/api/ws"]
+
+
+@pytest.mark.parametrize("backend", ["native_job", "popen"])
+def test_startup_budget_stays_in_client_environment(monkeypatch, tmp_path, backend):
+    import os
+    import sys
+    import time
+    from hermes_cli import gateway_runtime_start as start
+    from tools.environments import local
+
+    monkeypatch.setenv(SETTING, "900")
+    monkeypatch.setenv("RUNTIME_TEST_SENTINEL", "retained")
+    monkeypatch.setattr(local, "served_profile_child_env", lambda *, base, **kwargs: dict(base))
+    monkeypatch.setattr(start, "sys", SimpleNamespace(
+        platform="darwin" if backend == "native_job" else "linux", executable=sys.executable))
