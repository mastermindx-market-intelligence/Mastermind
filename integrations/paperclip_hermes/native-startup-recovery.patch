+def test_startup_budget_stays_in_client_environment(monkeypatch, tmp_path, backend):
+    import os
+    import sys
+    import time
+    from hermes_cli import gateway_runtime_start as start
+    from tools.environments import local
+
+    monkeypatch.setenv(SETTING, "900")
+    monkeypatch.setenv("RUNTIME_TEST_SENTINEL", "retained")
