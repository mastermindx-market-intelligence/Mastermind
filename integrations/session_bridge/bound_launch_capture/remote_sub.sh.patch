@@ -303,0 +304,33 @@
+# Only the trusted embedding owner supplies this optional correlation file.
+# It is not Runtime admission, a credential, or safe-to-retry evidence.
+bound_input = os.environ.get('REMOTE_SUB_START_BINDING_FILE')
+correlation_input = os.environ.get('REMOTE_SUB_START_CORRELATION_FILE')
+if bound_input or correlation_input:
+    sys.path.insert(0, sys.argv[8])
+    try:
+        from fabric_launch_reservation import load_binding, reserve_bound_log
+        if bound_input and correlation_input:
+            raise ValueError('ambiguous_binding_version')
+        if correlation_input:
+            from pathlib import Path
+            from fabric_launch_reservation import load_correlation, reserve_correlation_log
+            from fabric_launch_transport import prepare_snapshot
+            scope = dict(run_id=sys.argv[2], routing_root_id=os.environ.get('POOL_ORCHESTRATOR_ID'),
+                         routing_parent_run_id=os.environ.get('POOL_PARENT_RUN_ID'))
+            correlation = load_correlation(correlation_input, **scope)
+            reserve_correlation_log(sys.argv[1], correlation, **scope)
+            prepare_snapshot(correlation_input, sys.argv[1],
+                             Path(sys.argv[1]).with_suffix('.launch-correlation.json'), **scope)
+        else:
+            binding = load_binding(bound_input, run_id=sys.argv[2],
+                                   root_id=os.environ.get('POOL_ORCHESTRATOR_ID'))
+            reserve_bound_log(sys.argv[1], binding, run_id=sys.argv[2],
+                              root_id=os.environ.get('POOL_ORCHESTRATOR_ID'))
+    except FileExistsError:
+        print(f"RUN_EXISTS id={sys.argv[2]}", file=sys.stderr)
+        raise SystemExit(75)
+    except Exception:
+        print("BOUND_LOG_RESERVATION_REFUSED before_lease=1 before_launch=1", file=sys.stderr)
+        raise SystemExit(73)
+    raise SystemExit(0)
+
