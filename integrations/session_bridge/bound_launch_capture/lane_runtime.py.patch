+def _observe_owned_launch_identity(pid):
+    if type(pid) is not int or pid <= 0:
+        raise LaneRuntimeError("launch_identity_unavailable")
+    try:
+        if sys.platform == "darwin":
+            boot = _run_ps_lines(
