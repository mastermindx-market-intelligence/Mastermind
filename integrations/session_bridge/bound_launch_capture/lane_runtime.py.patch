+                or record['adapter_id'] != 'attended-fabric'
+                or json.dumps(record, sort_keys=True, separators=(',', ':'),
+                    ensure_ascii=False, allow_nan=False).encode() != payload):
+            raise LaneRuntimeError('owned_start_record_invalid')
