+def mirror_new_macro_result():
+    """Retain a canonical read-only result for an already-completed sparse worker.
+
+    This acts only on verified, controller-collected canonical stdout. No
+    provider, lease, host, process, acceptance, or workspace lifecycle action
+    occurs. The original per-run result remains unchanged; a requested
+    custom --out path is created atomically and exclusively, never replaced.
+    """
+    import hashlib
+    import os
+    from pathlib import Path
+    import re
+    import stat
+    import secrets
+
+    if len(sys.argv) != 4:
+        raise ValueError("canonical_result_arguments")
+    root_arg, run_id, output_arg = sys.argv[1:]
+    if (not os.path.isabs(root_arg)
+            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,95}", run_id)
+            or not output_arg):
+        raise ValueError("canonical_result_identity")
+
+    root = Path(root_arg)
+    source = root / "lanes" / (run_id + ".remote.stdout")
+    target = Path(os.path.abspath(output_arg))
+    lanes = target.parent
+    # The already-collected canonical stdout has the unique run ID. A custom
+    # output is only a derived second copy, never an unbound source of proof.
+    if source == target:
+        raise ValueError("canonical_result_already_selected")
+
+    # Canonical retained-result limit is 8 MiB. Larger files remain at
+    # their per-run path but are not represented as custom-delivery success.
+    max_bytes = 8_388_608
+    srcfd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    dirfd = None
+    scratch_fd = None
+    scratch_name = None
+    try:
+        original = os.fstat(srcfd)
+        if (not stat.S_ISREG(original.st_mode)
+                or original.st_uid != os.getuid()
+                or original.st_nlink != 1
+                or original.st_mode & 0o022
+                or original.st_size > max_bytes):
+            raise ValueError("canonical_result_not_single_owned_bounded_regular_file")
+
+        dirfd = os.open(lanes, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        directory = os.fstat(dirfd)
+        if (not stat.S_ISDIR(directory.st_mode)
+                or directory.st_uid != os.getuid()
+                or directory.st_mode & 0o022):
+            raise ValueError("custom_result_parent_directory_custody")
+
+        # A pre-existing result is never overwritten, even if it appears
+        # identical. Collision reconciliation belongs to the original parent.
+        try:
+            os.stat(target.name, dir_fd=dirfd, follow_symlinks=False)
+        except FileNotFoundError:
+            pass
+        else:
+            raise FileExistsError("custom_result_destination_exists")
+
+        # All create/link/unlink operations stay anchored to the verified
+        # directory inode; never re-traverse its caller-supplied path.
+        scratch_name = ".macro-custom-" + run_id + "-" + secrets.token_hex(12) + ".tmp"
+        scratch_fd = os.open(
+            scratch_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+            0o600, dir_fd=dirfd,
+        )
+        digest = hashlib.sha256()
+        count = 0
+        while True:
+            chunk = os.read(srcfd, 65536)
+            if not chunk:
+                break
+            count += len(chunk)
+            if count > max_bytes:
+                raise ValueError("canonical_result_size_limit")
+            digest.update(chunk)
+            view = memoryview(chunk)
+            while view:
+                n = os.write(scratch_fd, view)
+                if n <= 0:
+                    raise OSError("custom_result_short_write")
+                view = view[n:]
+
+        reread = os.fstat(srcfd)
+        src_lstat = os.lstat(source)
+        same = lambda a,b: (
+            a.st_dev, a.st_ino, a.st_size, a.st_mtime_ns, a.st_ctime_ns
+        ) == (
+            b.st_dev, b.st_ino, b.st_size, b.st_mtime_ns, b.st_ctime_ns
+        )
+        if (not same(reread, original) or not same(src_lstat, original)
+                or count != original.st_size):
+            raise ValueError("canonical_result_changed_during_copy")
+        os.fsync(scratch_fd)
+        os.close(scratch_fd)
+        scratch_fd = None
+
+        # link() is create-if-absent and never replaces a different result.
+        # The copy is fully written and fsynced *before* it becomes visible.
+        os.link(
+            scratch_name, target.name,
+            src_dir_fd=dirfd, dst_dir_fd=dirfd, follow_symlinks=False,
+        )
+        os.unlink(scratch_name, dir_fd=dirfd)
+        scratch_name = None
+        os.fsync(dirfd)
+        retained = os.stat(target.name, dir_fd=dirfd, follow_symlinks=False)
+        if (not stat.S_ISREG(retained.st_mode)
+                or retained.st_nlink != 1 or retained.st_uid != os.getuid()
+                or retained.st_size != count):
+            raise ValueError("custom_result_postcondition")
+        print(f"CUSTOM_RESULT_BOUND_FROM_CANONICAL bytes={count} sha256={digest.hexdigest()}")
+    finally:
+        if scratch_fd is not None:
+            os.close(scratch_fd)
+        if scratch_name is not None and dirfd is not None:
+            try:
+                os.unlink(scratch_name, dir_fd=dirfd)
+            except FileNotFoundError:
+                pass
+        if dirfd is not None:
+            os.close(dirfd)
+        os.close(srcfd)
+
+
