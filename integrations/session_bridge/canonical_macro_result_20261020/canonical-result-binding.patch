+def publish_new_macro_canonical():
+    """Exclusively promote an already-transferred private temp result.
+
+    This is a controller-only result-file effect, not worker acceptance,
+    process settlement, lease release, retry, or workspace deletion.
+    """
+    import hashlib
+    import os
+    from pathlib import Path
+    import re
+    import stat
+
+    if len(sys.argv) != 4:
+        raise ValueError("canonical_capture_arguments")
+    root_arg, run_id, temp_arg = sys.argv[1:]
+    if (not os.path.isabs(root_arg)
+            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,95}", run_id)
+            or not os.path.isabs(temp_arg)):
+        raise ValueError("canonical_capture_identity")
+    lanes = Path(root_arg) / "lanes"
+    capture = Path(temp_arg)
+    target_name = run_id + ".remote.stdout"
+    if (capture.parent != lanes
+            or not re.fullmatch(
+                r"\.macro-capture\." + re.escape(run_id) + r"\.[A-Za-z0-9]{8,32}",
+                capture.name,
+            )):
+        raise ValueError("canonical_capture_scope")
+    dirfd = os.open(lanes, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    srcfd = None
+    try:
+        owner = os.fstat(dirfd)
+        if (not stat.S_ISDIR(owner.st_mode)
+                or owner.st_uid != os.getuid()
+                or owner.st_mode & 0o022):
+            raise ValueError("canonical_capture_directory_custody")
+        srcfd = os.open(
+            capture.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
+            dir_fd=dirfd,
+        )
+        original = os.fstat(srcfd)
+        if (not stat.S_ISREG(original.st_mode)
+                or original.st_uid != os.getuid()
+                or original.st_nlink != 1
+                or original.st_size > 8_388_608):
+            raise ValueError("canonical_capture_file_custody")
+        data = hashlib.sha256()
+        count = 0
+        while True:
+            block = os.read(srcfd, 65536)
+            if not block:
+                break
+            count += len(block)
+            if count > 8_388_608:
+                raise ValueError("canonical_capture_over_limit")
+            data.update(block)
+        after = os.fstat(srcfd)
+        seen = os.stat(capture.name, dir_fd=dirfd, follow_symlinks=False)
+        def ident(st):
+            return (st.st_dev,st.st_ino,st.st_size,st.st_mtime_ns,st.st_ctime_ns)
+        if ident(original) != ident(after) or ident(seen) != ident(original):
+            raise ValueError("canonical_capture_changed")
+        # The transfer may have preserved a permissive remote file mode.
+        # Tighten the private *capture*, then atomically publish it.
+        os.fchmod(srcfd,0o600)
+        os.fsync(srcfd)
+        os.link(
+            capture.name, target_name,
+            src_dir_fd=dirfd, dst_dir_fd=dirfd, follow_symlinks=False,
+        )
+        os.unlink(capture.name, dir_fd=dirfd)
+        os.fsync(dirfd)
+        retained = os.stat(target_name,dir_fd=dirfd,follow_symlinks=False)
+        if (not stat.S_ISREG(retained.st_mode)
+                or retained.st_uid != os.getuid()
+                or retained.st_size != count
+                or retained.st_mode & 0o077):
+            raise ValueError("canonical_capture_postcondition")
+        print(f"CANONICAL_RESULT_CAPTURED bytes={count} sha256={data.hexdigest()}")
+    finally:
+        if srcfd is not None:
+            os.close(srcfd)
+        os.close(dirfd)
+
