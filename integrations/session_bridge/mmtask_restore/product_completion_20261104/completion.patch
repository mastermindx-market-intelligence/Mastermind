+def related_requests(db, a, to, mirror):
+    """Validate every requested --related key BEFORE any write: exact WS:KEY form, never an alias of
+    the primary target, each backed by an existing Agent OS record. Duplicated input collapses in
+    first-seen order; already-associated keys pass through so the caller decides add vs no-op.
+    Any refusal exits before a chart file is touched."""
+    out, seen = [], set()
+    for r in (getattr(a, "related", None) or []):
+        if not re.fullmatch(r"WS:[A-Z0-9-]+", r or ""):
+            sys.exit(f"mmtask rebind: bad related workstream key {r!r} (expected WS:KEY); nothing changed")
+        if r in seen:
+            continue
+        seen.add(r)
+        if r == to:
+            sys.exit(f"mmtask rebind: related {r} aliases the primary target; related associations are additive and never alias the primary; nothing changed")
+        rec = os.path.join(mirror, "agentos/workstreams", f"WS-{r.split(':', 1)[1]}.md")
+        if not os.path.exists(rec):
+            sys.exit(f"mmtask rebind: related record {os.path.relpath(rec, mirror)} does not exist in the mirror; refusing to associate an invented related workstream; nothing changed")
+        out.append(r)
+    return out
+
+
+def related_add(db, rel, to):
+    """Additive related update: retain every existing unrelated association, drop a primary alias,
+    append the newly requested keys in first-seen order. Returns the keys this call adds."""
+    prior = [x for x in (db.get("related_workstreams") or []) if x != to]
+    new = [r for r in rel if r not in prior]
+    db["related_workstreams"] = prior + new
+    return new
+
+
