+            """SELECT 1 FROM events
+               WHERE aggregate_type='operator_operation' AND event_type=?
+                 AND json_extract(payload_json,'$.process_generation_id')=?
+                 AND json_extract(payload_json,'$.operation_kind') IN ('graceful_stop','cancel')
+               LIMIT 1""",
