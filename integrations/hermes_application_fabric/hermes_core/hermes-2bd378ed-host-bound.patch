@@ -0,0 +1,74 @@
+import { PassThrough } from 'node:stream'
+
+import { renderSync } from '@hermes/ink'
+import React from 'react'
+import { expect, it, vi } from 'vitest'
+
+import { ModelPicker } from '../components/modelPicker.js'
+import { DEFAULT_THEME } from '../theme.js'
+import { messages } from '../i18n/runtime.js'
+
+const model = 'mastermind-fabric/auto'
+
+function mount(eligible: boolean) {
+  const request = vi.fn(async (_method: string, _params?: unknown) => ({
+    provider: 'mastermind-fabric',
+    model,
+    providers: [{
+      slug: 'mastermind-fabric', name: 'Mastermind Fabric', source: 'host-bound',
+      authenticated: false, auth_type: 'host_bound', key_env: '', is_current: true,
+      models: eligible ? [model] : [], total_models: eligible ? 1 : 0,
+      warning: eligible ? 'Managed by this host; access is checked on each turn.' : 'Host setup is unavailable.',
+      capabilities: { [model]: { fast: false, reasoning: false } }
+    }]
+  }))
+  const stdin = Object.assign(new PassThrough(), { isTTY: true, setRawMode: vi.fn(), ref: vi.fn(), unref: vi.fn() })
+  const stdout = Object.assign(new PassThrough(), { columns: 100, rows: 30, isTTY: false })
+  let output = ''
+  stdout.on('data', chunk => { output += chunk.toString() })
+  const onSelect = vi.fn()
+  const element = <ModelPicker gw={{ request } as any} onCancel={vi.fn()} onSelect={onSelect} t={DEFAULT_THEME} />
+  const instance = renderSync(element, {
+    stdin: stdin as any, stdout: stdout as any, stderr: new PassThrough() as any, patchConsole: false
+  })
+  return { request, stdin, onSelect, instance, element, output: () => output }
+}
+
+it('selects an eligible host-managed model without key entry or credential disconnect', async () => {
+  const mounted = mount(true)
+  try {
+    await vi.waitFor(() => expect(mounted.output()).toContain('Managed access'))
+    expect(mounted.output()).not.toContain('needs setup')
+    mounted.stdin.write('\u0004')
+    await new Promise(resolve => setImmediate(resolve))
+    mounted.instance.rerender(React.cloneElement(mounted.element))
+    mounted.stdin.write('\r')
+    await vi.waitFor(() => {
+      mounted.instance.rerender(React.cloneElement(mounted.element))
+      expect(mounted.output()).toContain(messages().pickers.model.modelStage.title)
+    })
+    mounted.instance.rerender(React.cloneElement(mounted.element))
+    mounted.stdin.write('\r')
+    await vi.waitFor(() => expect(mounted.onSelect).toHaveBeenCalledWith(
+      'mastermind-fabric/auto --provider mastermind-fabric --tui-session'
+    ))
+    expect(mounted.request.mock.calls.map(call => call[0])).toEqual(['model.options'])
+  } finally {
+    mounted.instance.unmount()
+  }
+})
+
+it('keeps a held host-managed row unavailable without asking for credentials', async () => {
+  const mounted = mount(false)
+  try {
+    await vi.waitFor(() => expect(mounted.output()).toContain('Host setup is unavailable'))
+    mounted.stdin.write('\u0004')
+    mounted.stdin.write('\r')
+    mounted.instance.rerender(React.cloneElement(mounted.element))
+    expect(mounted.onSelect).not.toHaveBeenCalled()
+    expect(mounted.request.mock.calls.map(call => call[0])).toEqual(['model.options'])
+    expect(mounted.output()).not.toContain('Paste')
+  } finally {
+    mounted.instance.unmount()
+  }
+})
