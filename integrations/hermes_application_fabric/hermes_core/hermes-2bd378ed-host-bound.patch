+            except Exception:
+                pass  # A held or unavailable owner cannot resurrect a static/saved catalog.
+        rows.append(_canonical_row(
+            entry, (ctx.current_provider or "").lower(), models=models, total_models=len(models),
+            source="host-bound", authenticated=False, auth_type="host_bound", key_env="",
+            warning=("Managed by this host; access is checked on each turn." if models
+                     else "Host setup is unavailable. Restore the configured service before choosing a model."),
+        ))
+    return owned, rows
+
