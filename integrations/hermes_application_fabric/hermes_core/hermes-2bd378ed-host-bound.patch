+def _buildable_inputs_fingerprint(member: Path, document: dict) -> str:
+    """Only coalesce complete self-contained snapshots, never outside inputs."""
+    import stat
+    from packaging.requirements import Requirement
+
+    for relative in document.get("build-system", {}).get("backend-path", []):
+        path = Path(relative)
+        if path.is_absolute() or not (member / path).resolve().is_relative_to(member.resolve()):
+            raise InstallError("venv", f"shared build input escapes its plugin: {member}")
+    for values in document.get("tool", {}).get("uv", {}).get("sources", {}).values():
+        for spec in values if isinstance(values, list) else [values]:
+            if isinstance(spec, dict) and "path" in spec:
+                path = Path(spec["path"])
+                if path.is_absolute() or not (member / path).resolve().is_relative_to(member.resolve()):
+                    raise InstallError("venv", f"shared dependency input escapes its plugin: {member}")
