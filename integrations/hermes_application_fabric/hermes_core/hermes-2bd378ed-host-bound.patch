+def _buildable_inputs_fingerprint(member: Path, document: dict) -> str:
+    """Only coalesce complete self-contained snapshots, never outside inputs."""
+    import stat
+    from packaging.requirements import Requirement
+
+    for relative in document.get("build-system", {}).get("backend-path", []):
+        path = Path(relative)
+        if path.is_absolute() or not (member / path).resolve().is_relative_to(member.resolve()):
+            raise InstallError("venv", f"shared build input escapes its plugin: {member}")
+    for values in document.get("tool", {}).get("uv", {}).get("sources", {}).values():
+        for spec in values if isinstance(values, list) else [values]:
+            if isinstance(spec, dict) and "path" in spec:
+                path = Path(spec["path"])
+                if path.is_absolute() or not (member / path).resolve().is_relative_to(member.resolve()):
+                    raise InstallError("venv", f"shared dependency input escapes its plugin: {member}")
+    for raw in document.get("project", {}).get("dependencies", []):
+        url = Requirement(raw).url
+        if url and (url.startswith("file:") or "://" not in url):
+            raise InstallError("venv", f"shared dependency input is not snapshotted: {member}")
+    rows = []
+    for directory, dirs, files in os.walk(member, followlinks=False):
+        for name in sorted(dirs + files):
+            path = Path(directory) / name
+            info = path.lstat()
+            if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
+                raise InstallError("venv", f"shared build input is not a direct file or directory: {member}")
+            rows.append((path.relative_to(member).as_posix(), stat.S_IFMT(info.st_mode),
+                         stat.S_IMODE(info.st_mode),
+                         hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None))
+        dirs.sort()
+    return hashlib.sha256(json.dumps(sorted(rows), separators=(",", ":")).encode()).hexdigest()
+
+
+def _coalesce_buildable_members(copied: list[tuple[Path, Path]]) -> list[Path]:
+    """Share identical package builds while every home retains its own identity."""
+    import re
+    import tomllib
+
+    groups, members = {}, []
+    for identity, member in sorted(copied):
+        document = tomllib.loads((member / "pyproject.toml").read_text(encoding="utf-8-sig"))
+        buildable = "build-system" in document or document.get("tool", {}).get("uv", {}).get("package") is True
+        if not buildable:
+            members.append(member)
+            continue
+        name = document.get("project", {}).get("name")
+        if not isinstance(name, str) or not name:
+            raise InstallError("venv", f"buildable plugin has no distribution name: {identity}")
+        groups.setdefault(re.sub(r"[-_.]+", "-", name).lower(), []).append((identity, member, document))
+    for name, group in sorted(groups.items()):
+        first_identity, first_member, first_document = group[0]
+        if len(group) > 1:
+            fingerprint = _buildable_inputs_fingerprint(first_member, first_document)
+            for identity, member, document in group[1:]:
+                if _buildable_inputs_fingerprint(member, document) != fingerprint:
+                    raise InstallError("venv", f"conflicting copies of package {name}: {first_identity} and {identity}")
+        members.append(first_member)
+    return members
+
+
