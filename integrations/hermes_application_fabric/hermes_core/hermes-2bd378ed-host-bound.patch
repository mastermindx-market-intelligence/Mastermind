index 0000000000..2768f540f9
--- /dev/null
+++ b/tests/pm/test_buildable_multi_home.py
@@ -0,0 +1,84 @@
+"""The existing PM shares identical package builds, not home identities."""
+import os
+from pathlib import Path
+import sys
+import tomllib
+
+import pytest
+
+from pm.package import InstallError
+from pm.workspace import _generate_pyproject, member_sources, members_stamp
+
+
+def _inputs(tmp_path):
+    core = tmp_path / "core"
+    core.mkdir()
+    (core / "pyproject.toml").write_text(
+        '[project]\nname="hermes-agent"\nversion="0.0.1"\ndependencies=[]\n'
+        '[tool.uv]\npackage=false\n')
+    plugins = []
+    for name in ("home-a", "home-b"):
+        plugin = tmp_path / name / "plugins" / "same"
+        plugin.mkdir(parents=True)
+        (plugin / "pyproject.toml").write_text(
+            '[project]\nname="shared-plugin"\nversion="1.0"\ndependencies=[]\n'
+            '[build-system]\nrequires=[]\nbuild-backend="fixture_backend"\nbackend-path=["."]\n')
+        (plugin / "fixture_backend.py").write_text('raise RuntimeError("metadata checks must not execute backend")\n')
+        (plugin / "adapter.py").write_text('IDENTITY = "same"\n')
+        plugins.append(plugin)
+    return core, plugins
+
+
+def test_identical_builds_share_one_member_but_preserve_both_home_snapshots(tmp_path):
+    core, plugins = _inputs(tmp_path)
+    generation = tmp_path / "generation"
+    _generate_pyproject(plugins, generation, source=core, python=Path(sys.executable))
+    document = tomllib.loads((generation / "pyproject.toml").read_text())
+    assert len(document["tool"]["uv"]["workspace"]["members"]) == 1
+    assert len(list((generation / "plugin-sources").iterdir())) == 2
+    assert set(member_sources(plugins)) == set(plugins)
+    stamp = members_stamp(plugins)
+    (plugins[1] / "adapter.py").write_text('IDENTITY = "changed"\n')
+    assert members_stamp(plugins) != stamp
+    assert all((path / "adapter.py").read_text() == 'IDENTITY = "same"\n'
+               for path in (generation / "plugin-sources").iterdir())
+
+
+def test_different_copy_refuses_before_lock_or_environment_publication(tmp_path):
+    core, plugins = _inputs(tmp_path)
+    (plugins[1] / "adapter.py").write_text('IDENTITY = "different"\n')
+    generation = tmp_path / "generation"
+    with pytest.raises(InstallError, match="conflicting copies.*home-a.*home-b"):
+        _generate_pyproject(plugins, generation, source=core, python=Path(sys.executable))
+    assert not (generation / "pyproject.toml").exists()
+    assert not (generation / "uv.lock").exists()
+    assert (plugins[0] / "adapter.py").read_text() == 'IDENTITY = "same"\n'
+
+
+def test_mode_change_in_either_home_invalidates_the_build_stamp(tmp_path):
+    core, plugins = _inputs(tmp_path)
+    stamp = members_stamp(plugins)
+    (plugins[1] / "adapter.py").chmod(0o755)
+    assert members_stamp(plugins) != stamp
+    with pytest.raises(InstallError, match="conflicting copies"):
+        _generate_pyproject(plugins, tmp_path / "generation", source=core, python=Path(sys.executable))
+
+
+def test_external_link_cannot_be_declared_an_equivalent_build_input(tmp_path):
+    core, plugins = _inputs(tmp_path)
+    outside = tmp_path / "outside.py"
+    outside.write_text("secret_build_input = True\n")
+    for plugin in plugins:
+        (plugin / "outside.py").symlink_to(outside)
+    with pytest.raises(InstallError, match="not a direct file or directory"):
+        _generate_pyproject(plugins, tmp_path / "generation", source=core, python=Path(sys.executable))
+
+
+def test_remaining_home_builds_after_the_other_is_deselected(tmp_path):
+    core, plugins = _inputs(tmp_path)
+    (plugins[0] / "adapter.py").write_text('IDENTITY = "disabled-copy"\n')
+    generation = tmp_path / "generation"
+    _generate_pyproject([plugins[1]], generation, source=core, python=Path(sys.executable))
+    document = tomllib.loads((generation / "pyproject.toml").read_text())
+    assert len(document["tool"]["uv"]["workspace"]["members"]) == 1
+    assert len(list((generation / "plugin-sources").iterdir())) == 1
