+def _host_bound_rows(ctx: ConfigContext, *, refresh: bool = False) -> tuple[set[str], list[dict]]:
+    """Credential-free host catalogs; eligibility is observed, never granted here."""
+    from providers import get_provider_profile
+    from hermes_cli.models import _PROVIDER_ALIASES
+    from hermes_cli.models_catalog_static import listed_canonical_providers
+
+    excluded = {str(p).strip().lower() for p in (ctx.excluded_providers or []) if p}
+    configured = {str(k).strip().lower(): v for k, v in (ctx.user_providers or {}).items()}
+    names_for: dict[str, set[str]] = {}
+    for alias, canonical in _PROVIDER_ALIASES.items():
+        names_for.setdefault(canonical.lower(), {canonical.lower()}).add(alias.lower())
+    owned, rows = set(), []
+    for entry in listed_canonical_providers():
+        profile = get_provider_profile(entry.slug)
+        if profile is None or getattr(profile, "host_bound_runtime", False) is not True:
+            continue
+        slug = entry.slug.lower()
+        owned.add(slug)
+        names = names_for.get(slug, {slug})
+        if names & excluded or any(
+            isinstance(configured.get(name), dict) and configured[name].get("enabled") is False
+            for name in names
+        ):
+            continue
+        models = []
+        if callable(profile.picker_catalog):
+            try:
+                observed = profile.picker_catalog(bool(refresh))
+                if isinstance(observed, list) and all(
+                    isinstance(model, str) and model and model == model.strip()
+                    for model in observed
+                ):
