diff --git a/gateway/session_provider_context.py b/gateway/session_provider_context.py
new file mode 100644
index 0000000000..39daa291aa
--- /dev/null
+++ b/gateway/session_provider_context.py
@@ -0,0 +1,97 @@
+"""Provider composition consumes the original admitted turn; it never admits work."""
+from contextlib import contextmanager
+from dataclasses import dataclass
+
+from hermes_cli.runtime_provider_host import is_host_bound_runtime
+from hermes_state_runtime import RuntimeStoreError
+
+
+@dataclass(frozen=True)
+class AdmittedProviderTurn:
+    authority: object
+    context: object
+    live: object
+    stamp: object
+    operation_id: str
+    epoch: int
+    generation: int
+
+    def current(self, _call=None):
+        a, c, live = self.authority, self.context, self.live
+        with live.event_stream.lock:
+            return (not a.retiring and not a.retired and not a.runner._draining
+                and a.epoch == self.epoch and a.sessions.get(c.session_id) is live
+                and live.event_stream.execution is self.stamp
+                and self.stamp == {"authority_epoch": self.epoch,
+                                   "execution_generation": self.generation,
+                                   "admission_id": self.operation_id}
+                and a.executing.get(c.session_id) == self.generation
+                and a.pending_stops.get(c.session_id) != self.generation
+                and a.delivered_stops.get(c.session_id) != self.generation
+                and callable(c._run_still_current) and c._run_still_current() is True)
+
+
+def bind_provider_turn(authority, context):
+    """The existing SessionAuthority's once-only entry, under its session lock."""
+    from gateway.session_authority import LiveSession
+    from gateway.turn_context import TurnContext
+    from hermes_state_runtime import get_session_admission
+    if type(context) is not TurnContext:
+        raise RuntimeStoreError("provider_turn_not_admitted")
+    live = authority.sessions.get(context.session_id)
+    if (type(live) is not LiveSession or live.route != context.session_key
+            or live.source.platform != context.source.platform
+            or live.source.user_id != context.source.user_id):
+        raise RuntimeStoreError("provider_turn_not_admitted")
+    with live.event_stream.lock:
+        stamp = live.event_stream.execution
+        epoch, generation = stamp.get("authority_epoch"), stamp.get("execution_generation")
+        admission_id = stamp.get("admission_id")
+    if (type(epoch) is not int or type(generation) is not int
+            or epoch < 1 or generation < 1 or not isinstance(admission_id, str)):
+        raise RuntimeStoreError("provider_turn_not_admitted")
+    binding = AdmittedProviderTurn(authority, context, live, stamp, admission_id, epoch, generation)
+    if not binding.current():
+        raise RuntimeStoreError("stale_generation")
+    row = get_session_admission(authority.db, admission_id=admission_id)
+    if (not row or row["status"] != "started" or row["owner_epoch"] != epoch
+            or row["generation"] != generation or row["target_session_id"] != context.session_id):
+        raise RuntimeStoreError("provider_turn_not_admitted")
+    claim = (epoch, generation, admission_id)
+    with live.event_stream.lock:
+        if not binding.current():
+            raise RuntimeStoreError("stale_generation")
+        if live.host_provider_claim == claim:
+            raise RuntimeStoreError("provider_turn_recovery_required")
+        # Provider/model/plugin replacement cannot make the same native admission new.
+        # Never clear on failure, close or unload. Native restart recovery fences started rows.
+        live.host_provider_claim = claim
+    return binding
+
+
+@contextmanager
+def provider_turn_scope(runner, turn_context, turn_route):
+    if turn_route.get("source") != "host_bound":
+        # A separately held role host already owns its original capability.
+        # Its runtime does not originate from the attended keyless resolver.
+        yield
+        return
+    if not is_host_bound_runtime(turn_route["runtime"]):
+        raise RuntimeStoreError("provider_turn_binding_invalid")
+    from gateway.session_authorities import require_active_authority
+    from gateway.session_authority import SessionAuthority
+    from hermes_cli.plugins import invoke_hook
+    authority = require_active_authority(runner)
+    if type(authority) is not SessionAuthority or authority.runner is not runner:
+        raise RuntimeStoreError("provider_turn_not_admitted")
+    admitted = authority.bind_provider_turn(turn_context)
+    contexts = invoke_hook("provide_gateway_turn_context",
+        provider=turn_route["runtime"]["provider"], runner=runner,
+        turn_context=turn_context, turn_route=turn_route, admitted=admitted)
+    if len(contexts) != 1:
+        raise RuntimeStoreError("provider_turn_binding_required")
+    binding = contexts[0]
+    if not callable(getattr(binding, "__enter__", None)) or not callable(getattr(binding, "__exit__", None)):
+        raise RuntimeStoreError("provider_turn_binding_invalid")
+    with binding:
+        yield
