+"""Registered gateway-bound providers: a keyless route is not an admission."""
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+
+def resolve_host_bound_runtime(requested, explicit_api_key, explicit_base_url, model_config):
+    from providers import get_provider_profile
+    profile = get_provider_profile(requested) if requested and requested != "auto" else None
+    if profile is None or profile.host_bound_runtime is not True:
+        return None
+    if (explicit_api_key not in (None, "") or explicit_base_url not in (None, "")
+            or model_config.get("api_key") not in (None, "")
+            or model_config.get("base_url") not in (None, "")):
+        raise RuntimeError("Host-bound providers cannot accept endpoint or credential overrides")
+    return {"provider": profile.name, "requested_provider": requested,
+            "api_mode": profile.api_mode, "api_key": None, "base_url": None,
+            "credential_pool": None, "source": "host_bound"}
+
+
+def is_host_bound_runtime(runtime):
+    if not isinstance(runtime, Mapping):
+        return False
+    from providers import get_provider_profile
+    name = runtime.get("provider")
+    profile = get_provider_profile(name) if isinstance(name, str) else None
+    if profile is None or profile.host_bound_runtime is not True:
+        return False
+    if (runtime.get("requested_provider", name) not in (profile.name, *profile.aliases)
+            or runtime.get("api_mode") != profile.api_mode
+            or any(runtime.get(key) not in (None, "")
+                   for key in ("api_key", "base_url", "command", "acp_command"))
+            or any(runtime.get(key) not in (None, [], {})
+                   for key in ("credential_pool", "args", "acp_args", "fallback_model"))):
+        raise RuntimeError("Invalid host-bound provider runtime")
+    return True
