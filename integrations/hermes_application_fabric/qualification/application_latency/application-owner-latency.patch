+        options["obs"]["go"]["model_room"]["other-model"] = 0
+        self.assertFalse(self.select(task(max_expected_latency_ms=200), **options)["ok"])
+
+
+    def test_latency_does_not_resolve_same_model_source_ambiguity(self):
