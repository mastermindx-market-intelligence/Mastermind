+def _application_latency_fact(document, grant, *, pool, model, profile, task,
+                              payload, transport_binding, now):
+    """One existing-owner qualification; no history inference or provider I/O.
+
+    The evidence covers the complete grant account cohort. A faster account's
+    estimate cannot qualify a slower or unknown account selected by the Broker.
+    The transport binding is supplied by the actual loaded transport owner,
+    never inferred from an account alias/path or a quota-scope identifier.
+    """
+    value = grant.get("latency_qualification")
+    if value is None or type(profile) is not dict or type(task) is not dict:
+        return None
+    try:
+        value = _application_latency_qualification(value, grant)
+    except (ApplicationAdmissionError, ValueError, TypeError, KeyError, OverflowError):
+        # An invalid performance annotation cannot authorize a constrained call,
+        # nor does it revoke unrelated permission in this same owner document.
+        return None
+    if not value["observed_at"] <= now < value["expires_at"]:
+        return None
+    if (value["transport_binding"] != transport_binding
+            or value["source_profile_digest"] != hashlib.sha256(
+                _application_json(profile).encode()).hexdigest()
+            or value["provider_config_digest"] != hashlib.sha256(
+                _application_json(document["providers"][pool]).encode()).hexdigest()):
+        return None
+    row = value["models"].get(model)
+    if (row is None or task.get("task_class") not in row["task_classes"]
+            or task.get("task_complexity") not in row["task_complexities"]
+            or not set(task.get("needs") or []) <= set(row["capabilities"])):
+        return None
+    fields = {"model", "messages", "stream", "max_tokens", "temperature", "top_p",
+              "stop", "tools", "tool_choice", "parallel_tool_calls"}
+    if (type(payload) is not dict or set(payload) - fields
+            or type(payload.get("messages")) is not list
+            or payload.get("model") not in (None, model)
+            or payload.get("stream", False) is not False
+            or type(payload.get("max_tokens")) is not int
+            or not 1 <= payload["max_tokens"] <= row["max_output_tokens"]):
+        return None
+    # The declared envelope includes history, tools and all sampling controls.
+    # Only the model label is omitted so AUTO and exact intent have equal bounds.
+    body = {key: item for key, item in payload.items() if key != "model"}
+    if len(_application_json(body).encode()) > row["max_request_bytes"]:
+        return None
+    return row["expected_ms"]
+
