+    def test_absent_requirement_preserves_exact_legacy_identity_and_commitments(self):
+        old = self.select()
+        enriched = self.select(obs=observations(model_latency_ms={"fixture-model": 200}))
+        self.assertEqual(old["identity"], enriched["identity"])
+        self.assertEqual(old["commitments"]["task_digest"], enriched["commitments"]["task_digest"])
+        self.assertNotIn("max_expected_latency_ms", old["identity"]["task"])
+        self.assertNotIn("expected_latency_ms", old["commitments"])
+
+    def test_unknown_and_slow_models_never_become_zero_latency(self):
+        for values in ({}, {"fixture-model": 101}):
+            with self.subTest(values=values):
+                self.assertFalse(self.select(task(max_expected_latency_ms=100),
+                    obs=observations(model_latency_ms=values))["ok"])
+        result = self.select(task(max_expected_latency_ms=100),
+            obs=observations(model_latency_ms={"fixture-model": 100}))
+        self.assertTrue(result["ok"])
+        self.assertEqual(result["commitments"]["expected_latency_ms"], 100)
+
+    def test_latency_requirement_and_facts_reject_nonintegers_and_bounds(self):
+        for value in (None, True, False, 0, -1, 86_400_001, 1.5, float("nan"), "100"):
+            with self.subTest(value=repr(value)):
+                self.assertFalse(self.select(task(max_expected_latency_ms=value))["ok"])
+                self.assertFalse(self.select(task(max_expected_latency_ms=100),
+                    obs=observations(model_latency_ms={"fixture-model": value}))["ok"])
+        self.assertFalse(self.select(task(max_expected_latency_ms=100),
+            obs=observations(model_latency_ms={"unknown-model": 1}))["ok"])
+
+    def model_options(self, default=None, ranks=(0, 0)):
+        document = policy_document()
+        document["pools"]["go"]["worker_models"] = ["fixture-model", "other-model"]
+        if default is None:
+            document["pools"]["go"].pop("default_model")
+        else:
+            document["pools"]["go"]["default_model"] = default
+        self.write_policy(document)
+        policy = pick.read_application_policy()
+        cat = catalogue(go={"enabled": True, "recipes": [
+            recipe(order_rank=ranks[0]), recipe(model="other-model", order_rank=ranks[1])]})
+        obs = observations(go=observation(model_room={"fixture-model": 1, "other-model": 1},
+            model_latency_ms={"fixture-model": 500, "other-model": 100}))
+        return dict(pol=policy, cat=cat, obs=obs)
+
+    def test_qualified_latency_resolves_only_best_rank_ties(self):
+        options = self.model_options()
+        self.assertFalse(self.select(**options)["ok"])
+        chosen = self.select(task(max_expected_latency_ms=1000), **options)
+        self.assertTrue(chosen["ok"])
+        self.assertEqual(chosen["identity"]["model"], "other-model")
+        options["obs"]["go"]["model_latency_ms"]["fixture-model"] = 100
+        self.assertFalse(self.select(task(max_expected_latency_ms=1000), **options)["ok"])
+
+    def test_incumbent_default_and_catalogue_economic_rank_remain_authoritative(self):
+        for options in (self.model_options(default="fixture-model"),
+                        self.model_options(ranks=(0, 1))):
+            selected = self.select(task(max_expected_latency_ms=1000), **options)
+            self.assertEqual(selected["identity"]["model"], "fixture-model")
+
+    def test_strict_model_and_capacity_are_not_bypassed_for_fast_alternative(self):
