+def _application_latency_qualification(value, grant):
+    """Validate optional evidence published by the existing grant owner.
+
+    It describes expected completion time for one bounded model request, not
+    time to first token, a whole tool conversation, or a guaranteed deadline.
+    It grants no accounts/capacity and cannot be supplied by an HTTP caller.
+    """
+    fields = {"schema", "metric", "evidence_ref", "observed_at", "expires_at",
+              "source_profile_digest", "provider_config_digest", "transport_binding",
+              "accounts", "models"}
+    if (type(value) is not dict or set(value) != fields
+            or value["schema"] != "mastermind.application_latency_qualification.v1"
+            or value["metric"] != "request_completion_ms"):
+        raise ApplicationAdmissionError("latency_qualification_invalid")
+    reference = value["evidence_ref"]
+    if (type(reference) is not str or not reference.strip() or len(reference) > 512
+            or any(ord(c) < 32 for c in reference)):
+        raise ApplicationAdmissionError("latency_qualification_invalid")
+    observed, expires = (_application_time(value[key])
+                         for key in ("observed_at", "expires_at"))
+    if not observed < expires <= min(observed + 86_400, grant["expires_at"]):
+        raise ApplicationAdmissionError("latency_qualification_invalid")
+    for key in ("source_profile_digest", "provider_config_digest"):
+        _application_digest(value[key])
+    binding = value["transport_binding"]
+    if (type(binding) is not dict
+            or set(binding) != {"schema", "pool", "instance_id", "configuration_digest"}
+            or binding["schema"] != "mastermind.application_latency_binding.v1"
+            or binding["pool"] != grant["pool"]):
+        raise ApplicationAdmissionError("latency_qualification_invalid")
+    _application_id(binding["instance_id"])
+    _application_digest(binding["configuration_digest"])
+    if (type(value["accounts"]) is not list
+            or value["accounts"] != sorted(grant["accounts"])):
+        raise ApplicationAdmissionError("latency_qualification_invalid")
+    models = value["models"]
+    if (type(models) is not dict or not 1 <= len(models) <= 128
+            or not set(models) <= set(grant["models"])):
+        raise ApplicationAdmissionError("latency_qualification_invalid")
+    row_fields = {"served_model", "expected_ms", "sample_count", "max_request_bytes",
+                  "max_output_tokens", "task_classes", "task_complexities", "capabilities"}
+    for model, row in models.items():
+        if (type(row) is not dict or set(row) != row_fields
+                or row["served_model"] != model):
+            raise ApplicationAdmissionError("latency_qualification_invalid")
+        for key, bound in (("expected_ms", 86_400_000), ("sample_count", 1_000_000),
+                           ("max_request_bytes", 1024 * 1024), ("max_output_tokens", 1_000_000)):
+            if type(row[key]) is not int or not 1 <= row[key] <= bound:
+                raise ApplicationAdmissionError("latency_qualification_invalid")
+        for key in ("task_classes", "task_complexities", "capabilities"):
+            values = row[key]
+            if (type(values) is not list or len(values) > 32
+                    or any(type(item) is not str for item in values)
+                    or values != sorted(set(values))
+                    or key != "capabilities" and not values):
+                raise ApplicationAdmissionError("latency_qualification_invalid")
+            for item in values:
+                _application_id(item)
+        if (any(item != item.lower() for item in row["task_classes"])
+                or any(item != item.upper() for item in row["task_complexities"])
+                or any(re.fullmatch(r"[a-z][a-z0-9_]{0,63}", item) is None
+                       for item in row["capabilities"])):
+            raise ApplicationAdmissionError("latency_qualification_invalid")
+    return value
