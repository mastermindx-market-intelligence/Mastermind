"""Owned native Hermes entry. Invoke only with qualified Python -I -S -B."""
import sys

if (sys.version_info[:2] != (3, 12) or not sys.flags.isolated
        or not sys.flags.no_site or not sys.flags.no_user_site
        or not sys.flags.dont_write_bytecode):
    raise SystemExit("NATIVE_STARTUP_RECIPE_REQUIRED")

from pathlib import Path

_entry = Path(__file__).resolve().parents[3] / "ops/executive_os/release_manifest.py"
sys.argv[:] = [str(_entry), "hermes-runtime", "native-gateway", *sys.argv[1:]]
exec(compile(_entry.read_bytes(), str(_entry), "exec"),
     {"__name__": "__main__", "__file__": str(_entry)})
